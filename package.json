{
    "name": "page-root",
    "private": true,
    "version": "1.0.0",
    "license": "MIT",
    "description": "Starlight theme for Pelagornis Docs",
    "type": "module",
    "engines": {
        "node": ">=22.23.4"
    },
    "packageManager": "bun@1.3.14",
    "workspaces": [
        "docs",
        "packages/*"
    ],
    "homepage": "https://github.com/pelagornis/starlight-theme-page",
    "scripts": {
        "start": "bun --filter docs dev",
        "dev": "bun run start",
        "build": "bun --filter docs build",
        "preview": "bun --filter docs preview"
    },
    "devDependencies": {
        "astro": "^7.4.4"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/pelagornis/starlight-theme-page.git"
    }
}
