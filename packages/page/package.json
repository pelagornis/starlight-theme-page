    "keywords": [
        "pelagornis",
        "refineui",
        "styles",
        "starlight"
    ],
    "homepage": "https://github.com/pelagornis/starlight-theme-page",
    "repository": {
        "type": "git",
        "url": "https://github.com/pelagornis/starlight-theme-page.git",
        "directory": "packages/page"
    },
    "dependencies": {
        "@pagefind/default-ui": "^1.6.0",
        "@refineui/react": "0.2.1",
        "@refineui/tokens": "^2.2.0",
        "@refineui/utilities": "^0.0.4",
        "@refineui/web-icons": "^0.3.43",
        "@tailwindcss/vite": "^4.3.3",
        "hast-util-select": "^6.0.4",
        "hast-util-to-html": "^9.0.6",
        "hast-util-to-text": "^4.0.3",
        "rehype-parse": "^9.0.1",
        "rehype-remark": "^10.0.1",
        "remark-gfm": "^4.0.1",
        "remark-stringify": "^11.0.0",
        "unified": "^11.0.5",
        "unist-util-remove": "^4.0.0"
    },
    "devDependencies": {
        "@astrojs/markdoc": "^2.1.2",
        "@astrojs/react": "^7.1.2",
        "@astrojs/starlight": "^0.42.9",
        "@tailwindcss/cli": "^4.3.3",
        "@types/hast": "^3.0.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "astro": "^7.4.4",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwindcss": "^4.3.3"
    },
    "peerDependencies": {
        "@astrojs/markdoc": "^2.1.2",
        "@astrojs/react": "^7.1.2",
        "@astrojs/starlight": ">=0.42.0 <0.43.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "peerDependenciesMeta": {
