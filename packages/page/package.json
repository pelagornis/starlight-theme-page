{
    "name": "@pelagornis/page",
    "version": "2.0.1",
    "license": "MIT",
    "description": "Starlight theme for Pelagornis Docs — RefineUI design system chrome",
    "type": "module",
    "exports": {
        ".": "./index.ts",
        "./components": "./overrides/refineui.ts",
        "./markdoc": "./markdoc/index.ts",
        "./table": "./markdown/table.ts",
        "./markdoc/components": "./markdoc/components.ts"
    },
    "files": [
        "index.ts",
        "i18n.ts",
        "llms/**/*.ts",
        "tailwind.css",
        "chrome.css",
        "overrides/**/*.{astro,ts,tsx}",
        "markdoc/**/*.{astro,ts}",
        "markdown/**/*.ts",
        "assets/*.svg",
        "virtual.d.ts",
        "README.md"
