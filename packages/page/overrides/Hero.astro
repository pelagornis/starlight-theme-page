---
// page 스타일 히어로 섹션
import { Image } from "astro:assets";
import Button from "@pelagornis/page/components/Button.astro";

// Starlight에서 entry는 locals.starlightRoute 또는 props.entry로 전달됨
const entry = Astro.locals.starlightRoute?.entry || Astro.props.entry;

// entry.data에서 hero 필드 직접 읽기
const heroData = entry?.data?.hero;

// hero 섹션이 없으면 Hero 컴포넌트를 렌더링하지 않음
if (!heroData) {
  return null;
}

// hero.title이 있으면 사용, 없으면 페이지 제목 사용
const title = heroData.title ?? entry?.data?.title;

// tagline 읽기 (Starlight 기본 schema가 지원함)
const tagline = heroData.tagline;
const actions = heroData.actions || [];
const imageFile = heroData.image?.file;
---

<div class="page-hero">
  <div class={`page-hero-container ${imageFile ? "has-image" : ""}`}>
    <div class="page-hero-content">
      <!-- 메인 타이틀 -->
      <h1 class="page-hero-title">{title || "Starlight Page"}</h1>

      <!-- 설명 -->
      {tagline && <p class="page-hero-tagline">{tagline}</p>}

      <!-- 액션 버튼들 -->
      {
        actions && actions.length > 0 && (
          <div class="page-hero-actions">
            {actions.map(
              (action: {
                link: string;
                text: string;
                variant?: string;
                icon?: string;
              }) => {
                const variant = action.variant || "default";
                const buttonVariant =
                  variant === "primary"
                    ? "primary"
                    : variant === "minimal"
                      ? "ghost"
                      : "default";

                const isExternal = action.link.startsWith("http");
                const iconType = action.icon || "right-arrow";

                return (
                  <Button
                    href={action.link}
                    variant={buttonVariant as any}
                    {...(isExternal
                      ? { target: "_blank", rel: "noopener noreferrer" }
                      : {})}
                  >
                    {action.text}
                  </Button>
                );
              }
            )}
          </div>
        )
      }
    </div>

    <!-- 이미지가 있을 때만 표시 -->
    {
      imageFile && (
        <div class="page-hero-visual">
          <div class="page-hero-image">
            <img
              src={imageFile}
              alt={title || "Hero image"}
              class="page-hero-img"
            />
          </div>
        </div>
      )
    }
  </div>
</div>

<style>
  .page-hero {
    background: linear-gradient(
      135deg,
      var(--page-bg-secondary) 0%,
      var(--page-bg) 50%,
      var(--page-bg-secondary) 100%
    );
    border-radius: 1.5em;
    padding: 4rem 0 3rem;
    margin-top: calc(-1 * var(--page-header-height) + 1rem);
    margin-bottom: 3rem;
    padding-top: calc(4rem + var(--page-header-height));
    position: relative;
    overflow: hidden;
  }

  .page-hero::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(
        circle at 30% 20%,
        rgba(120, 119, 198, 0.08) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 70% 80%,
        rgba(255, 119, 198, 0.06) 0%,
        transparent 50%
      );
    pointer-events: none;
  }

  [data-theme="dark"] .page-hero {
    background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 50%, #0a0a0a 100%);
  }

  [data-theme="dark"] .page-hero::before {
    background: radial-gradient(
        circle at 30% 20%,
        rgba(120, 119, 198, 0.12) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 70% 80%,
        rgba(255, 119, 198, 0.1) 0%,
        transparent 50%
      );
  }

  .page-hero-container {
    margin: 0 auto;
    padding: 0 var(--page-space-16);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--page-space-10);
    align-items: start;
  }

  .page-hero-container.has-image {
    grid-template-columns: 1.2fr 1fr;
    gap: var(--page-space-12);
  }

  .page-hero-content {
    width: 100%;
    margin: 0;
    text-align: left;
    position: relative;
    z-index: 1;
  }

  .page-hero-title {
    font-weight: 700;
    color: var(--page-text);
    margin: 0 0 var(--page-space-4) 0;
    letter-spacing: -0.02em;
    font-family: var(--page-font-family);
    font-size: 3rem;
    line-height: 1.2;
  }

  .page-hero-tagline {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--page-text-secondary);
    margin: 0 0 var(--page-space-4) 0;
    font-weight: 400;
    opacity: 0.75;
  }

  .page-hero-actions {
    display: flex;
    gap: var(--page-space-3);
    flex-wrap: wrap;
  }

  /* Hero 액션 버튼은 Button 컴포넌트의 스타일을 재사용 */
  .page-hero-actions :global(.page-button) {
    margin-top: 0;
  }

  /* 이미지가 있을 때만 표시 */
  .page-hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .page-hero-image {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    max-width: 500px;
  }

  .page-hero-img {
    width: 100%;
    height: auto;
    border-radius: var(--page-radius);
    object-fit: contain;
  }

  /* 모바일 대응 */
  @media (max-width: 768px) {
    .page-hero {
      padding: 3rem 0 2rem;
      padding-top: calc(3rem + var(--page-header-height));
    }

    .page-hero-container {
      grid-template-columns: 1fr !important;
      padding: 0 var(--page-space-4);
      gap: var(--page-space-8);
    }

    .page-hero-content {
      max-width: 100%;
    }

    .page-hero-title {
      font-size: 2rem;
    }

    .page-hero-tagline {
      font-size: 1rem;
    }

    .page-hero-visual {
      order: -1;
      margin-bottom: var(--page-space-6);
    }
  }

  @media (max-width: 480px) {
    .page-hero-title {
      font-size: 1.75rem;
    }

    .page-hero-btn {
      padding: var(--page-space-3) var(--page-space-4);
      font-size: 0.875rem;
    }
  }

  /* 큰 화면 */
  @media (min-width: 1200px) {
    .page-hero {
      padding: 5rem 0 4rem;
      padding-top: calc(5rem + var(--page-header-height));
    }

    .page-hero-title {
      font-size: 3.5rem;
    }

    .page-hero-tagline {
      font-size: 1.25rem;
    }
  }
</style>
