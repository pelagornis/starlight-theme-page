---
import * as pkg from "@refineui/web-icons";
import { ICON_NAME_MAPPING } from "../lib/icon-names";
const createIconHTML = (
  pkg as {
    createIconHTML?: (
      name: string,
      style: "regular" | "filled",
    ) => (size?: number, color?: string, className?: string) => string;
  }
).createIconHTML;
const menuIcon =
  typeof createIconHTML === "function"
    ? createIconHTML(ICON_NAME_MAPPING.menu ?? "more-horizontal", "regular")
    : () => "";
---

<button
  class="page-mobile-menu-toggle"
  aria-label="Open menu"
  id="page-mobile-menu-toggle"
>
  <Fragment set:html={menuIcon(24, "currentColor", "refineui-icon")} />
  <span class="sr-only">Menu</span>
</button>

<script>
  // Store event listener refs in module scope
  let isInitialized = false;
  let clickHandler: ((event: Event) => void) | null = null;
  let popstateHandler: (() => void) | null = null;
  let astroPageLoadHandler: (() => void) | null = null;

  // Run after DOM is loaded
  function initializeMobileMenu() {
    // Prevent duplicate initialization
    if (isInitialized) {
      return;
    }

    const button = document.querySelector(
      "#page-mobile-menu-toggle",
    ) as HTMLButtonElement;

    if (!button) {
      console.error("Mobile menu toggle button not found.");
      return;
    }

    // Update current path
    const updateCurrentPath = () => {
      if (typeof window !== "undefined") {
        const currentPath = window.location.pathname;
        button.setAttribute("data-current-path", currentPath);
      }
    };

    // Set initial path
    updateCurrentPath();

    // Click listener (avoid duplicate registration)
    if (!clickHandler) {
      clickHandler = (event: Event) => {
        event.preventDefault();
        event.stopPropagation();

        // Toggle sidebar
        toggleSidebar();
      };
      button.addEventListener("click", clickHandler);
    }

    // Update path on page change (avoid duplicate registration)
    if (typeof window !== "undefined" && !popstateHandler) {
      popstateHandler = updateCurrentPath;
      window.addEventListener("popstate", popstateHandler);
    }

    if (!astroPageLoadHandler) {
      astroPageLoadHandler = updateCurrentPath;
      document.addEventListener("astro:page-load", astroPageLoadHandler);
    }

    isInitialized = true;
  }

  function toggleSidebar(): boolean {
    // Find mobile menu overlay
    const mobileMenu = document.querySelector(
      "#page-mobile-menu-overlay",
    ) as HTMLElement;

    if (!mobileMenu) {
      return false;
    }

    try {
      const isOpen = mobileMenu.classList.contains("page-mobile-menu-open");

      if (isOpen) {
        mobileMenu.classList.remove("page-mobile-menu-open");
        mobileMenu.style.display = "none";
        if (document.body) {
          document.body.style.overflow = "";
        }
        return false;
      } else {
        mobileMenu.style.display = "flex";
        mobileMenu.classList.add("page-mobile-menu-open");
        if (document.body) {
          document.body.style.overflow = "hidden";
        }
        return true;
      }
    } catch (error) {
      return false;
    }
  }

  // Cleanup event listeners
  function cleanup() {
    const button = document.querySelector(
      "#page-mobile-menu-toggle",
    ) as HTMLButtonElement;

    if (button && clickHandler) {
      button.removeEventListener("click", clickHandler);
      clickHandler = null;
    }

    if (typeof window !== "undefined" && popstateHandler) {
      window.removeEventListener("popstate", popstateHandler);
      popstateHandler = null;
    }

    if (astroPageLoadHandler) {
      document.removeEventListener("astro:page-load", astroPageLoadHandler);
      astroPageLoadHandler = null;
    }

    isInitialized = false;
  }

  // Initialize when DOM is ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeMobileMenu);
  } else {
    initializeMobileMenu();
  }

  // Also initialize on Astro page load (after cleaning existing listeners)
  document.addEventListener("astro:page-load", () => {
    // Slight delay so DOM is fully loaded
    setTimeout(() => {
      cleanup();
      initializeMobileMenu();
    }, 10);
  });

  // Cleanup on page unload
  window.addEventListener("beforeunload", cleanup);
</script>

<style>
  /* Mobile menu toggle button style */
  .page-mobile-menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: none;
    border-radius: var(--page-radius);
    background: var(--page-accent-light);
    color: var(--page-text-secondary);
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    padding: 0;
    position: relative;
    overflow: hidden;
  }

  .page-mobile-menu-toggle:hover {
    background: var(--page-text-reverse);
    color: var(--page-text);
    transform: translateY(-1px);
    box-shadow: var(--page-shadow-sm);
  }

  .page-mobile-menu-toggle:active {
    transform: translateY(0) scale(0.95);
    transition: all 0.1s ease;
  }

  [data-theme="dark"] .page-mobile-menu-toggle {
    background: var(--page-accent-light);
    color: var(--page-text-secondary);
  }

  [data-theme="dark"] .page-mobile-menu-toggle:hover {
    background: var(--page-text-reverse);
    color: var(--page-text);
    box-shadow: var(--page-shadow-sm);
  }

  .page-mobile-menu-toggle svg,
  .page-mobile-menu-toggle .refineui-icon,
  .page-mobile-menu-toggle .page-menu-icon,
  .page-mobile-menu-toggle span:not(.sr-only) {
    width: 24px !important;
    height: 24px !important;
    min-width: 24px !important;
    min-height: 24px !important;
    font-size: 24px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    box-sizing: border-box;
    transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    transform-origin: center;
  }

  .page-mobile-menu-toggle:hover svg,
  .page-mobile-menu-toggle:hover .refineui-icon,
  .page-mobile-menu-toggle:hover .page-menu-icon {
    transform: scale(1.1);
  }

  /* Hamburger menu icon - 24px same as header-icons.css / span rule above */
  .page-menu-icon {
    transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    transform-origin: center;
  }

  .page-close-icon {
    transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    transform-origin: center;
  }

  /* Ripple effect on button click */
  .page-mobile-menu-toggle::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    transform: translate(-50%, -50%);
    transition:
      width 0.6s ease,
      height 0.6s ease;
  }

  .page-mobile-menu-toggle:active::after {
    width: 80px;
    height: 80px;
  }

  /* Mobile: 32px touch target, 20px RefineUI icon (same as other nav buttons) */
  @media (max-width: 768px) {
    .page-mobile-menu-toggle {
      display: flex;
      width: 32px;
      height: 32px;
      min-width: 32px;
      min-height: 32px;
    }

    .page-mobile-menu-toggle svg,
    .page-mobile-menu-toggle .refineui-icon,
    .page-mobile-menu-toggle .page-menu-icon,
    .page-mobile-menu-toggle span:not(.sr-only) {
      width: 20px !important;
      height: 20px !important;
      min-width: 20px !important;
      min-height: 20px !important;
      font-size: 20px !important;
    }
  }
</style>
