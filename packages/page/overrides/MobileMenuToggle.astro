---
import * as pkg from "@refineui/web-icons";
import { ICON_NAME_MAPPING } from "../lib/icon-names";
const createIconHTML = (pkg as { createIconHTML?: (name: string, style: 'regular' | 'filled') => (size?: number, color?: string, className?: string) => string }).createIconHTML;
const menuIcon = typeof createIconHTML === 'function' ? createIconHTML(ICON_NAME_MAPPING.menu ?? "Bar", "regular") : () => '';
---

<button
  class="page-mobile-menu-toggle"
  aria-label="Open menu"
  id="page-mobile-menu-toggle"
>
  <Fragment set:html={menuIcon(24, "currentColor", "refineui-icon page-menu-icon")} />
</button>

<script>
  // 전역 변수로 이벤트 리스너 참조 저장
  let isInitialized = false;
  let clickHandler: ((event: Event) => void) | null = null;
  let popstateHandler: (() => void) | null = null;
  let astroPageLoadHandler: (() => void) | null = null;

  // DOM이 로드된 후 실행
  function initializeMobileMenu() {
    // 이미 초기화되었다면 중복 실행 방지
    if (isInitialized) {
      return;
    }

    const button = document.querySelector(
      "#page-mobile-menu-toggle"
    ) as HTMLButtonElement;

    if (!button) {
      console.error("Mobile menu toggle button not found.");
      return;
    }

    // 현재 경로 업데이트
    const updateCurrentPath = () => {
      if (typeof window !== "undefined") {
        const currentPath = window.location.pathname;
        button.setAttribute("data-current-path", currentPath);
      }
    };

    // 초기 경로 설정
    updateCurrentPath();

    // 클릭 이벤트 리스너 (중복 등록 방지)
    if (!clickHandler) {
      clickHandler = (event: Event) => {
        event.preventDefault();
        event.stopPropagation();

        // 사이드바 토글
        toggleSidebar();
      };
      button.addEventListener("click", clickHandler);
    }

    // 페이지 변경 시 경로 업데이트 (중복 등록 방지)
    if (typeof window !== "undefined" && !popstateHandler) {
      popstateHandler = updateCurrentPath;
      window.addEventListener("popstate", popstateHandler);
    }

    if (!astroPageLoadHandler) {
      astroPageLoadHandler = updateCurrentPath;
      document.addEventListener("astro:page-load", astroPageLoadHandler);
    }

    isInitialized = true;
  }

  function toggleSidebar(): boolean {
    // 모바일 메뉴 오버레이 찾기
    const mobileMenu = document.querySelector(
      "#page-mobile-menu-overlay"
    ) as HTMLElement;

    if (!mobileMenu) {
      return false;
    }

    try {
      const isOpen = mobileMenu.classList.contains("page-mobile-menu-open");

      if (isOpen) {
        mobileMenu.classList.remove("page-mobile-menu-open");
        mobileMenu.style.display = "none";
        if (document.body) {
          document.body.style.overflow = "";
        }
        return false;
      } else {
        mobileMenu.style.display = "flex";
        mobileMenu.classList.add("page-mobile-menu-open");
        if (document.body) {
          document.body.style.overflow = "hidden";
        }
        return true;
      }
    } catch (error) {
      return false;
    }
  }

  // 이벤트 리스너 정리 함수
  function cleanup() {
    const button = document.querySelector(
      "#page-mobile-menu-toggle"
    ) as HTMLButtonElement;

    if (button && clickHandler) {
      button.removeEventListener("click", clickHandler);
      clickHandler = null;
    }

    if (typeof window !== "undefined" && popstateHandler) {
      window.removeEventListener("popstate", popstateHandler);
      popstateHandler = null;
    }

    if (astroPageLoadHandler) {
      document.removeEventListener("astro:page-load", astroPageLoadHandler);
      astroPageLoadHandler = null;
    }

    isInitialized = false;
  }

  // DOM이 로드되면 초기화
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeMobileMenu);
  } else {
    initializeMobileMenu();
  }

  // Astro 페이지 로드 시에도 초기화 (기존 리스너 정리 후)
  document.addEventListener("astro:page-load", () => {
    // 약간의 지연을 두어 DOM이 완전히 로드된 후 실행
    setTimeout(() => {
      cleanup();
      initializeMobileMenu();
    }, 10);
  });

  // 페이지 언로드 시 정리
  window.addEventListener("beforeunload", cleanup);
</script>

<style>
  /* 모바일 메뉴 토글 버튼 스타일 */
  .page-mobile-menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: none;
    border-radius: var(--page-radius);
    background: var(--page-accent-light);
    color: var(--page-text-secondary);
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    padding: 0;
    position: relative;
    overflow: hidden;
  }

  .page-mobile-menu-toggle:hover {
    background: var(--page-text-reverse);
    color: var(--page-text);
    transform: translateY(-1px);
    box-shadow: var(--page-shadow-sm);
  }

  .page-mobile-menu-toggle:active {
    transform: translateY(0) scale(0.95);
    transition: all 0.1s ease;
  }

  [data-theme="dark"] .page-mobile-menu-toggle {
    background: var(--page-accent-light);
    color: var(--page-text-secondary);
  }

  [data-theme="dark"] .page-mobile-menu-toggle:hover {
    background: var(--page-text-reverse);
    color: var(--page-text);
    box-shadow: var(--page-shadow-sm);
  }

  .page-mobile-menu-toggle svg,
  .page-mobile-menu-toggle .refineui-icon,
  .page-mobile-menu-toggle .page-menu-icon,
  .page-mobile-menu-toggle span:not(.sr-only) {
    width: 24px !important;
    height: 24px !important;
    min-width: 24px !important;
    min-height: 24px !important;
    font-size: 24px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    box-sizing: border-box;
    transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    transform-origin: center;
  }

  .page-mobile-menu-toggle:hover svg,
  .page-mobile-menu-toggle:hover .refineui-icon,
  .page-mobile-menu-toggle:hover .page-menu-icon {
    transform: scale(1.1);
  }

  /* 햄버거 메뉴 아이콘 - 크기는 전역 header-icons.css / 위 span 규칙과 동일 24px */
  .page-menu-icon {
    transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    transform-origin: center;
  }

  .page-close-icon {
    transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    transform-origin: center;
  }

  /* 버튼 클릭 시 리플 효과 */
  .page-mobile-menu-toggle::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    transform: translate(-50%, -50%);
    transition: width 0.6s ease, height 0.6s ease;
  }

  .page-mobile-menu-toggle:active::after {
    width: 80px;
    height: 80px;
  }

  /* 모바일: 터치 영역 32px, RefineUI 아이콘 20px */
  @media (max-width: 768px) {
    .page-mobile-menu-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      min-width: 32px;
      min-height: 32px;
    }

    .page-mobile-menu-toggle svg,
    .page-mobile-menu-toggle .refineui-icon,
    .page-mobile-menu-toggle .page-menu-icon,
    .page-mobile-menu-toggle span:not(.sr-only) {
      width: 20px !important;
      height: 20px !important;
      min-width: 20px !important;
      min-height: 20px !important;
      font-size: 20px !important;
    }
  }

  @media (max-width: 480px) {
    .page-mobile-menu-toggle {
      width: 32px;
      height: 32px;
      min-width: 32px;
      min-height: 32px;
    }

    .page-menu-icon,
    .page-mobile-menu-toggle .refineui-icon,
    .page-mobile-menu-toggle .page-menu-icon,
    .page-mobile-menu-toggle span:not(.sr-only) {
      width: 20px !important;
      height: 20px !important;
      min-width: 20px !important;
      min-height: 20px !important;
      font-size: 20px !important;
    }
  }
</style>
