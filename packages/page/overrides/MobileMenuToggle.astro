---
import { Button, WebIcon } from '@refineui/react';
---

<Button
  id="starlight__menu"
  class="menu-button print:hidden"
  variant="ghost"
  layout="icon"
  size="md"
  aria-expanded="false"
  aria-controls="starlight__sidebar"
  aria-label={Astro.locals.t('menuButton.accessibleLabel')}
>
  <WebIcon name="Navigation" />
</Button>

<script>
  const button = document.getElementById('starlight__menu');
  if (button) {
    const setExpanded = (expanded: boolean) => {
      button.setAttribute('aria-expanded', String(expanded));
      document.body.toggleAttribute('data-mobile-menu-expanded', expanded);
    };

    button.addEventListener('click', () => {
      setExpanded(button.getAttribute('aria-expanded') !== 'true');
    });

    button.closest('nav')?.addEventListener('keyup', (event) => {
      if ((event as KeyboardEvent).code !== 'Escape') return;
      setExpanded(false);
      button.focus();
    });
  }
</script>

<style>
  .menu-button {
    position: fixed;
    z-index: var(--sl-z-index-navbar);
    top: calc((var(--sl-nav-height) - var(--refineui-size-button-min-height-md)) / 2);
    inset-inline-end: var(--sl-nav-pad-x);
  }

  @media (min-width: 50rem) {
    .menu-button {
      display: none;
    }
  }
</style>
