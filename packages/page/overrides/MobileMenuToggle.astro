---
// Page 스타일 모바일 메뉴 토글
---

<button
  class="page-mobile-menu-toggle"
  aria-label="메뉴 열기"
  id="page-mobile-menu-toggle"
>
  <!-- 햄버거 메뉴 아이콘 -->
  <svg
    class="page-menu-icon"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <line x1="3" y1="6" x2="21" y2="6"></line>
    <line x1="3" y1="12" x2="21" y2="12"></line>
    <line x1="3" y1="18" x2="21" y2="18"></line>
  </svg>
</button>

<script>
  // DOM이 로드된 후 실행
  function initializeMobileMenu() {
    const button = document.querySelector(
      "#page-mobile-menu-toggle"
    ) as HTMLButtonElement;

    if (!button) {
      console.error("모바일 메뉴 토글 버튼을 찾을 수 없습니다.");
      return;
    }

    // 현재 경로 업데이트
    const updateCurrentPath = () => {
      if (typeof window !== "undefined") {
        const currentPath = window.location.pathname;
        button.setAttribute("data-current-path", currentPath);
      }
    };

    // 초기 경로 설정
    updateCurrentPath();

    // 페이지 변경 시 경로 업데이트
    if (typeof window !== "undefined") {
      window.addEventListener("popstate", updateCurrentPath);
    }
    document.addEventListener("astro:page-load", updateCurrentPath);

    // 클릭 이벤트 리스너
    button.addEventListener("click", (event) => {
      console.log("모바일 메뉴 버튼 클릭됨!");
      event.preventDefault();
      event.stopPropagation();

      // 사이드바 토글
      const isOpen = toggleSidebar();
      console.log("토글 결과:", isOpen);

      // 아이콘은 그대로 유지 (변경하지 않음)
    });
  }

  function toggleSidebar(): boolean {
    console.log("toggleSidebar 함수 호출됨");

    // 전역 toggleMobileMenu 함수 사용
    if (typeof (window as any).toggleMobileMenu === "function") {
      return (window as any).toggleMobileMenu();
    }

    // 폴백: 직접 구현
    const mobileMenu = document.querySelector(
      "#page-mobile-menu-overlay"
    ) as HTMLElement;

    if (!mobileMenu) {
      console.error("모바일 메뉴 오버레이를 찾을 수 없습니다.");
      return false;
    }

    const isOpen = mobileMenu.classList.contains("page-mobile-menu-open");
    console.log("현재 메뉴 상태:", isOpen ? "열림" : "닫힘");

    if (isOpen) {
      mobileMenu.classList.remove("page-mobile-menu-open");
      document.body.style.overflow = "";
      console.log("모바일 메뉴 닫힘");
      return false;
    } else {
      mobileMenu.classList.add("page-mobile-menu-open");
      document.body.style.overflow = "hidden";
      console.log(
        "모바일 메뉴 열림, 클래스 추가됨:",
        mobileMenu.classList.toString()
      );
      return true;
    }
  }

  // DOM이 로드되면 초기화
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeMobileMenu);
  } else {
    initializeMobileMenu();
  }

  // Astro 페이지 로드 시에도 초기화
  document.addEventListener("astro:page-load", initializeMobileMenu);
</script>
