<page-select>
  <button
    aria-label={Astro.locals.t("themeSelect.accessibleLabel")}
    aria-live="polite"
    class="page-theme-toggle-button"
    title={Astro.locals.t("themeSelect.accessibleLabel")}
    data-variant="ghost"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="sun"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2"></path>
      <path d="M12 20v2"></path>
      <path d="m4.93 4.93 1.41 1.41"></path>
      <path d="m17.66 17.66 1.41 1.41"></path>
      <path d="M2 12h2"></path>
      <path d="M20 12h2"></path>
      <path d="m6.34 17.66-1.41 1.41"></path>
      <path d="m19.07 4.93-1.41 1.41"></path>
    </svg>

    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="moon"
    >
      <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
    </svg>

    <span class="sr-only">Toggle theme</span>
  </button>
</page-select>

<style>
  /* page 스타일 테마 토글 버튼 - 다른 버튼들과 동일 */
  .page-theme-toggle-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--page-radius);
    background: var(--page-accent-light);
    border: none;
    color: var(--page-text-secondary);
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
  }

  .page-theme-toggle-button:hover {
    background: var(--page-neutral-200);
    color: var(--page-text);
    transform: translateY(-1px);
  }

  [data-theme="dark"] .page-theme-toggle-button:hover {
    background: var(--page-neutral-800);
    color: var(--page-text-dark);
  }

  .page-theme-toggle-button:focus-visible {
    outline: 2px solid var(--page-accent);
    outline-offset: 2px;
  }

  .page-theme-toggle-button:active {
    transform: scale(0.95);
  }

  /* page 스타일 아이콘 애니메이션 */
  .page-theme-toggle-button svg {
    position: absolute;
    transition: all 0.2s ease;
  }

  .page-theme-toggle-button .sun {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .page-theme-toggle-button .moon {
    opacity: 0 !important;
    transform: rotate(90deg) scale(0.8) !important;
  }

  [data-theme="dark"] .page-theme-toggle-button .sun {
    opacity: 0 !important;
    transform: rotate(-90deg) scale(0.8) !important;
  }

  [data-theme="dark"] .page-theme-toggle-button .moon {
    opacity: 1 !important;
    transform: rotate(0deg) scale(1) !important;
  }

  /* page 스타일 호버 시 회전 효과 */
  .page-theme-toggle-button:hover .sun {
    transform: rotate(180deg) scale(1.1);
  }

  .page-theme-toggle-button:hover .moon {
    transform: rotate(15deg) scale(1.1) !important;
  }

  [data-theme="dark"] .page-theme-toggle-button:hover .sun {
    transform: rotate(-180deg) scale(0.8) !important;
  }

  [data-theme="dark"] .page-theme-toggle-button:hover .moon {
    transform: rotate(15deg) scale(1.1) !important;
  }

  /* page 스타일 커스텀 속성 */
  page-select {
    display: contents;
  }

  /* 접근성 */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* 모바일 최적화 */
  @media (max-width: 768px) {
    .page-theme-toggle-button {
      width: 40px;
      height: 40px;
    }

    .page-theme-toggle-button svg {
      width: 18px;
      height: 18px;
    }
  }
</style>

<script>
  class pageThemeSelect extends HTMLElement {
    constructor() {
      super();
      this.initTheme();
      this.setupEventListeners();
    }

    initTheme() {
      // 저장된 테마 불러오기 또는 시스템 기본값
      const savedTheme = this.getSavedTheme();
      this.applyTheme(savedTheme);

      // DOM이 완전히 로드된 후 다시 한번 테마 적용
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", () => {
          this.applyTheme(savedTheme);
        });
      } else {
        // DOM이 이미 로드된 경우 즉시 적용
        setTimeout(() => {
          this.applyTheme(savedTheme);
        }, 0);
      }
    }

    getSavedTheme() {
      if (typeof localStorage !== "undefined") {
        return localStorage.getItem("starlight-theme") || this.getSystemTheme();
      }
      return this.getSystemTheme();
    }

    getSystemTheme() {
      return window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
    }

    applyTheme(theme: string) {
      document.documentElement.setAttribute("data-theme", theme);
      document.body.setAttribute("data-theme", theme);

      // 모든 Starlight 요소와 헤더, 푸터, CodeCopy, 모바일 메뉴 토글에 테마 적용
      const starlightElements = document.querySelectorAll(
        ".sl-container, .sl-content, .sl-sidebar, .sl-nav, .page-header, .page-footer-container, .page-code-copy-button, .page-mobile-menu-toggle"
      );
      starlightElements.forEach((element) => {
        element.setAttribute("data-theme", theme);
      });

      if (typeof localStorage !== "undefined") {
        localStorage.setItem("starlight-theme", theme);
      }

      // 테마 변경 이벤트 발생
      window.dispatchEvent(
        new CustomEvent("themechange", { detail: { theme } })
      );
    }

    setupEventListeners() {
      const button = this.querySelector("button");
      if (!button) return;

      button.addEventListener("click", () => {
        const currentTheme =
          document.documentElement.getAttribute("data-theme");
        const newTheme = currentTheme === "dark" ? "light" : "dark";

        // page 스타일 클릭 애니메이션
        button.style.transform = "scale(0.9)";
        setTimeout(() => {
          button.style.transform = "";
        }, 100);

        this.applyTheme(newTheme);
      });

      // 시스템 테마 변경 감지
      window
        .matchMedia("(prefers-color-scheme: dark)")
        .addEventListener("change", (e) => {
          if (!localStorage.getItem("starlight-theme")) {
            this.applyTheme(e.matches ? "dark" : "light");
          }
        });

      // 테마 변경 이벤트 리스너
      window.addEventListener("themechange", (event: any) => {
        const { theme } = event.detail;
        // 주요 요소들에만 테마 속성 적용 (성능 최적화)
        const keyElements = document.querySelectorAll(
          ".sl-container, .sl-content, .sl-sidebar, .sl-nav, .page-header, .page-footer-container, .page-code-copy-button, .page-mobile-menu-toggle, .page-mobile-menu-overlay"
        );
        keyElements.forEach((element) => {
          if (element instanceof HTMLElement) {
            element.setAttribute("data-theme", theme);
          }
        });
      });
    }
  }

  customElements.define("page-select", pageThemeSelect);
</script>
