---
import * as pkg from "@refineui/web-icons";
import { ICON_NAME_MAPPING } from "../lib/icon-names";
const createIconHTML = (pkg as { createIconHTML?: (name: string, style: "regular" | "filled") => (size?: number, color?: string, className?: string) => string }).createIconHTML;
const SIZE = 24;
const sunName = ICON_NAME_MAPPING.themeSun ?? "weather-sunny";
const moonName = ICON_NAME_MAPPING.themeMoon ?? "Moon";
// createIconHTML(인라인 문자)만 사용. weather-sunny regular는 폰트에 글리프가 없을 수 있어 filled 사용
const sunHtml = typeof createIconHTML === "function" ? createIconHTML(sunName, "filled")(SIZE, "currentColor", "refineui-icon sun") : "";
const moonHtml = typeof createIconHTML === "function" ? createIconHTML(moonName, "regular")(SIZE, "currentColor", "refineui-icon moon") : "";
---

<page-select>
  <button
    aria-label={Astro.locals.t("themeSelect.accessibleLabel")}
    aria-live="polite"
    class="page-theme-toggle-button"
    title={Astro.locals.t("themeSelect.accessibleLabel")}
    data-variant="ghost"
  >
    <span class="page-theme-toggle-icon-wrap">
      {sunHtml ? <Fragment set:html={sunHtml} /> : null}
      {moonHtml ? <Fragment set:html={moonHtml} /> : null}
    </span>
    <span class="sr-only">Toggle theme</span>
  </button>
</page-select>

<style>
  /* page 스타일 테마 토글 - SocialIcons와 동일 40x40 */
  .page-theme-toggle-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--page-radius);
    background: var(--page-accent-light);
    border: none;
    color: var(--page-text-secondary);
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
  }

  .page-theme-toggle-button:hover {
    background: var(--page-text-reverse) !important;
    color: var(--page-text) !important;
    transform: translateY(-1px) !important;
    box-shadow: var(--page-shadow-sm) !important;
  }

  .page-theme-toggle-button:focus-visible {
    outline: 2px solid var(--page-accent);
    outline-offset: 2px;
  }

  .page-theme-toggle-button:active {
    transform: scale(0.95);
  }

  /* Search와 동일: 버튼이 한 개의 아이콘 영역(24x24)만 flex로 중앙에 둠 */
  .page-theme-toggle-icon-wrap {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .page-theme-toggle-icon-wrap :global(.sun),
  .page-theme-toggle-icon-wrap :global(.moon) {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    margin: 0 !important;
    width: 24px !important;
    height: 24px !important;
    min-width: 24px !important;
    min-height: 24px !important;
    font-size: 24px !important;
    line-height: 24px !important;
    box-sizing: border-box !important;
    align-items: center !important;
  }
  /* 라이트: sun만 보임. header-icons의 .refineui-icon보다 우선하도록 선택자 강하게 */
  .page-theme-toggle-button .page-theme-toggle-icon-wrap :global(.moon),
  .page-theme-toggle-button
    .page-theme-toggle-icon-wrap
    :global(.refineui-icon.moon) {
    display: none !important;
  }
  .page-theme-toggle-button .page-theme-toggle-icon-wrap :global(.sun) {
    display: inline-flex !important;
  }
  /* 다크: moon만 보임 */
  :global([data-theme="dark"])
    .page-theme-toggle-button
    .page-theme-toggle-icon-wrap
    :global(.sun),
  :global([data-theme="dark"])
    .page-theme-toggle-button
    .page-theme-toggle-icon-wrap
    :global(.refineui-icon.sun) {
    display: none !important;
  }
  :global([data-theme="dark"])
    .page-theme-toggle-button
    .page-theme-toggle-icon-wrap
    :global(.moon),
  :global([data-theme="dark"])
    .page-theme-toggle-button
    .page-theme-toggle-icon-wrap
    :global(.refineui-icon.moon) {
    display: inline-flex !important;
  }

  /* page 스타일 커스텀 속성 */
  page-select {
    display: contents;
  }

  /* 접근성 */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 768px) {
    .page-theme-toggle-button {
      width: 32px !important;
      height: 32px !important;
      min-width: 32px !important;
      min-height: 32px !important;
    }
    .page-theme-toggle-icon-wrap {
      width: 20px;
      height: 20px;
    }
    .page-theme-toggle-icon-wrap :global(.sun),
    .page-theme-toggle-icon-wrap :global(.moon) {
      width: 20px !important;
      height: 20px !important;
      min-width: 20px !important;
      min-height: 20px !important;
      font-size: 20px !important;
      line-height: 20px !important;
    }
  }

  @media (max-width: 480px) {
    .page-theme-toggle-button {
      width: 32px !important;
      height: 32px !important;
      min-width: 32px !important;
      min-height: 32px !important;
    }
  }
</style>

<script>
  class pageThemeSelect extends HTMLElement {
    constructor() {
      super();
      this.initTheme();
      this.setupEventListeners();
    }

    initTheme() {
      // 저장된 테마 불러오기 또는 시스템 기본값
      const savedTheme = this.getSavedTheme();
      this.applyTheme(savedTheme);

      // DOM이 완전히 로드된 후 다시 한번 테마 적용
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", () => {
          this.applyTheme(savedTheme);
        });
      } else {
        // DOM이 이미 로드된 경우 즉시 적용
        setTimeout(() => {
          this.applyTheme(savedTheme);
        }, 0);
      }
    }

    getSavedTheme() {
      if (typeof localStorage !== "undefined") {
        return localStorage.getItem("starlight-theme") || this.getSystemTheme();
      }
      return this.getSystemTheme();
    }

    getSystemTheme() {
      return window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
    }

    applyTheme(theme: string) {
      document.documentElement.setAttribute("data-theme", theme);
      document.body.setAttribute("data-theme", theme);
      this.setAttribute("data-theme", theme);

      // 모든 Starlight 요소와 헤더, 푸터, CodeCopy, 모바일 메뉴 토글에 테마 적용
      const starlightElements = document.querySelectorAll(
        ".sl-container, .sl-content, .sl-sidebar, .sl-nav, .page-header, .page-footer-container, .page-code-copy-button, .page-mobile-menu-toggle",
      );
      starlightElements.forEach((element) => {
        element.setAttribute("data-theme", theme);
      });

      if (typeof localStorage !== "undefined") {
        localStorage.setItem("starlight-theme", theme);
      }

      // 테마 변경 이벤트 발생
      window.dispatchEvent(
        new CustomEvent("themechange", { detail: { theme } }),
      );
    }

    setupEventListeners() {
      const button = this.querySelector("button");
      if (!button) return;

      button.addEventListener("click", () => {
        const currentTheme =
          document.documentElement.getAttribute("data-theme");
        const newTheme = currentTheme === "dark" ? "light" : "dark";

        // page 스타일 클릭 애니메이션
        button.style.transform = "scale(0.9)";
        setTimeout(() => {
          button.style.transform = "";
        }, 100);

        this.applyTheme(newTheme);
      });

      // 시스템 테마 변경 감지
      window
        .matchMedia("(prefers-color-scheme: dark)")
        .addEventListener("change", (e) => {
          if (!localStorage.getItem("starlight-theme")) {
            this.applyTheme(e.matches ? "dark" : "light");
          }
        });

      // 테마 변경 이벤트 리스너
      window.addEventListener("themechange", (event: any) => {
        const { theme } = event.detail;
        // 주요 요소들에만 테마 속성 적용 (성능 최적화)
        const keyElements = document.querySelectorAll(
          ".sl-container, .sl-content, .sl-sidebar, .sl-nav, .page-header, .page-footer-container, .page-code-copy-button, .page-mobile-menu-toggle, .page-mobile-menu-overlay",
        );
        keyElements.forEach((element) => {
          if (element instanceof HTMLElement) {
            element.setAttribute("data-theme", theme);
          }
        });
      });
    }
  }

  customElements.define("page-select", pageThemeSelect);
</script>
