---
import * as pkg from "@refineui/web-icons";
import { ICON_NAME_MAPPING } from "../lib/icon-names";
const createIconHTML = (
  pkg as {
    createIconHTML?: (
      name: string,
      style: "regular" | "filled",
    ) => (size?: number, color?: string, className?: string) => string;
  }
).createIconHTML;
const SIZE = 24;
const sunName = ICON_NAME_MAPPING.themeSun ?? "weather-sunny";
const moonName = ICON_NAME_MAPPING.themeMoon ?? "Moon";
// Use only createIconHTML (inline). weather-sunny regular may be missing in font, so use filled
const sunHtml =
  typeof createIconHTML === "function"
    ? createIconHTML(sunName, "regular")(
        SIZE,
        "currentColor",
        "refineui-icon sun",
      )
    : "";
const moonHtml =
  typeof createIconHTML === "function"
    ? createIconHTML(moonName, "regular")(
        SIZE,
        "currentColor",
        "refineui-icon moon",
      )
    : "";
---

<page-select>
  <button
    aria-label={Astro.locals.t("themeSelect.accessibleLabel")}
    aria-live="polite"
    class="page-theme-toggle-button"
    title={Astro.locals.t("themeSelect.accessibleLabel")}
    data-variant="ghost"
  >
    <span class="page-theme-toggle-icon-wrap">
      {sunHtml ? <Fragment set:html={sunHtml} /> : null}
      {moonHtml ? <Fragment set:html={moonHtml} /> : null}
    </span>
    <span class="sr-only">Toggle theme</span>
  </button>
</page-select>

<style>
  /* Page-style theme toggle - same 40x40 as SocialIcons */
  .page-theme-toggle-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--page-radius);
    background: var(--page-accent-light);
    border: none;
    color: var(--page-text-secondary);
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
  }

  .page-theme-toggle-button:hover {
    background: var(--page-text-reverse);
    color: var(--page-text);
    transform: translateY(-1px);
    box-shadow: var(--page-shadow-sm);
  }

  .page-theme-toggle-button:focus-visible {
    outline: 2px solid var(--page-accent);
    outline-offset: 2px;
  }

  .page-theme-toggle-button:active {
    transform: scale(0.95);
  }

  /* Same as Search: single icon area (24x24) centered with flex */
  .page-theme-toggle-icon-wrap {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .page-theme-toggle-icon-wrap :global(.sun),
  .page-theme-toggle-icon-wrap :global(.moon) {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    margin: 0;
    width: 24px;
    height: 24px;
    min-width: 24px;
    min-height: 24px;
    font-size: 24px;
    line-height: 24px;
    box-sizing: border-box;
    align-items: center;
  }
  /* Light: show sun only. Strong selector to override header-icons .refineui-icon */
  .page-theme-toggle-button .page-theme-toggle-icon-wrap :global(.moon),
  .page-theme-toggle-button
    .page-theme-toggle-icon-wrap
    :global(.refineui-icon.moon) {
    display: none;
  }
  .page-theme-toggle-button .page-theme-toggle-icon-wrap :global(.sun) {
    display: inline-flex;
  }
  /* Dark: show moon only */
  :global([data-theme="dark"])
    .page-theme-toggle-button
    .page-theme-toggle-icon-wrap
    :global(.sun),
  :global([data-theme="dark"])
    .page-theme-toggle-button
    .page-theme-toggle-icon-wrap
    :global(.refineui-icon.sun) {
    display: none;
  }
  :global([data-theme="dark"])
    .page-theme-toggle-button
    .page-theme-toggle-icon-wrap
    :global(.moon),
  :global([data-theme="dark"])
    .page-theme-toggle-button
    .page-theme-toggle-icon-wrap
    :global(.refineui-icon.moon) {
    display: inline-flex;
  }

  /* Page-style custom properties */
  page-select {
    display: contents;
  }

  /* Accessibility */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 768px) {
    .page-theme-toggle-button {
      width: 32px;
      height: 32px;
      min-width: 32px;
      min-height: 32px;
    }
    .page-theme-toggle-icon-wrap {
      width: 20px;
      height: 20px;
    }
    .page-theme-toggle-icon-wrap :global(.sun),
    .page-theme-toggle-icon-wrap :global(.moon) {
      width: 20px;
      height: 20px;
      min-width: 20px;
      min-height: 20px;
      font-size: 20px;
      line-height: 20px;
    }
  }

  @media (max-width: 480px) {
    .page-theme-toggle-button {
      width: 32px;
      height: 32px;
      min-width: 32px;
      min-height: 32px;
    }
  }
</style>

<script>
  class pageThemeSelect extends HTMLElement {
    constructor() {
      super();
      this.initTheme();
      this.setupEventListeners();
    }

    initTheme() {
      // Restore saved theme or system default
      const savedTheme = this.getSavedTheme();
      this.applyTheme(savedTheme);

      // Re-apply theme after DOM is fully loaded
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", () => {
          this.applyTheme(savedTheme);
        });
      } else {
        // Apply immediately if DOM already loaded
        setTimeout(() => {
          this.applyTheme(savedTheme);
        }, 0);
      }
    }

    getSavedTheme() {
      if (typeof localStorage !== "undefined") {
        return localStorage.getItem("starlight-theme") || this.getSystemTheme();
      }
      return this.getSystemTheme();
    }

    getSystemTheme() {
      return window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
    }

    applyTheme(theme: string) {
      document.documentElement.setAttribute("data-theme", theme);
      document.body.setAttribute("data-theme", theme);
      this.setAttribute("data-theme", theme);

      // Apply theme to Starlight elements, header, footer, CodeCopy, mobile menu toggle
      const starlightElements = document.querySelectorAll(
        ".sl-container, .sl-content, .sl-sidebar, .sl-nav, .page-header, .page-footer-container, .page-code-copy-button, .page-mobile-menu-toggle",
      );
      starlightElements.forEach((element) => {
        element.setAttribute("data-theme", theme);
      });

      if (typeof localStorage !== "undefined") {
        localStorage.setItem("starlight-theme", theme);
      }

      // Dispatch theme change event
      window.dispatchEvent(
        new CustomEvent("themechange", { detail: { theme } }),
      );
    }

    setupEventListeners() {
      const button = this.querySelector("button");
      if (!button) return;

      button.addEventListener("click", () => {
        const currentTheme =
          document.documentElement.getAttribute("data-theme");
        const newTheme = currentTheme === "dark" ? "light" : "dark";

        // Page-style click animation
        button.style.transform = "scale(0.9)";
        setTimeout(() => {
          button.style.transform = "";
        }, 100);

        this.applyTheme(newTheme);
      });

      // Listen for system theme change
      window
        .matchMedia("(prefers-color-scheme: dark)")
        .addEventListener("change", (e) => {
          if (!localStorage.getItem("starlight-theme")) {
            this.applyTheme(e.matches ? "dark" : "light");
          }
        });

      // Theme change event listener
      window.addEventListener("themechange", (event: any) => {
        const { theme } = event.detail;
        // Apply theme attribute only to key elements (performance)
        const keyElements = document.querySelectorAll(
          ".sl-container, .sl-content, .sl-sidebar, .sl-nav, .page-header, .page-footer-container, .page-code-copy-button, .page-mobile-menu-toggle, .page-mobile-menu-overlay",
        );
        keyElements.forEach((element) => {
          if (element instanceof HTMLElement) {
            element.setAttribute("data-theme", theme);
          }
        });
      });
    }
  }

  customElements.define("page-select", pageThemeSelect);
</script>
