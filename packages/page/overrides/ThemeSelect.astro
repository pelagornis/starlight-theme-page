---
import * as pkg from "@refineui/web-icons";
const createIconHTML = (
  pkg as {
    createIconHTML?: (
      name: string,
      style: "regular" | "filled",
    ) => (size?: number, color?: string, className?: string) => string;
  }
).createIconHTML;
if (typeof createIconHTML !== "function")
  throw new Error("@refineui/web-icons: createIconHTML not found");
const sunIcon = createIconHTML("Lightbulb", "regular");
const moonIcon = createIconHTML("Moon", "regular");
---

<page-select>
  <button
    aria-label={Astro.locals.t("themeSelect.accessibleLabel")}
    aria-live="polite"
    class="page-theme-toggle-button"
    title={Astro.locals.t("themeSelect.accessibleLabel")}
    data-variant="ghost"
  >
    <Fragment set:html={sunIcon(24, "currentColor", "refineui-icon sun")} />
    <Fragment set:html={moonIcon(24, "currentColor", "refineui-icon moon")} />
    <span class="sr-only">Toggle theme</span>
  </button>
</page-select>

<style>
  /* page 스타일 테마 토글 - SocialIcons와 동일 40x40 */
  .page-theme-toggle-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--page-radius);
    background: var(--page-accent-light);
    border: none;
    color: var(--page-text-secondary);
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
  }

  .page-theme-toggle-button:hover {
    background: var(--page-text-reverse) !important;
    color: var(--page-text) !important;
    transform: translateY(-1px) !important;
    box-shadow: var(--page-shadow-sm) !important;
  }

  .page-theme-toggle-button:focus-visible {
    outline: 2px solid var(--page-accent);
    outline-offset: 2px;
  }

  .page-theme-toggle-button:active {
    transform: scale(0.95);
  }

  /* 아이콘 가운데 정렬 (두 개 겹쳐서 하나만 보이게), 크기 24px로 Slack과 통일
     인라인 inline-block 덮어써서 글리프가 24x24 박스 안에서 시각적 중앙 */
  .page-theme-toggle-button .sun,
  .page-theme-toggle-button .moon {
    position: absolute !important;
    left: 50% !important;
    top: 50% !important;
    margin: 0 !important;
    width: 24px !important;
    height: 24px !important;
    min-width: 24px !important;
    min-height: 24px !important;
    font-size: 24px !important;
    line-height: 24px !important;
    text-align: center !important;
    transform: translate(-50%, -50%);
    transition: opacity 0.2s ease, transform 0.2s ease;
    display: inline-flex !important;
    align-items: center !important;
    pointer-events: none;
  }

  .page-theme-toggle-button .sun {
    opacity: 1;
  }

  .page-theme-toggle-button .moon {
    opacity: 0;
    transform: translate(-50%, -50%) rotate(90deg) scale(0.8);
  }

  page-select[data-theme="dark"] .page-theme-toggle-button .sun,
  [data-theme="dark"] .page-theme-toggle-button .sun {
    opacity: 0;
    transform: translate(-50%, -50%) rotate(-90deg) scale(0.8);
  }

  page-select[data-theme="dark"] .page-theme-toggle-button .moon,
  [data-theme="dark"] .page-theme-toggle-button .moon {
    opacity: 1;
    transform: translate(-50%, -50%) rotate(0deg) scale(1);
  }

  .page-theme-toggle-button:hover .sun {
    transform: translate(-50%, -50%) rotate(180deg) scale(1.1);
  }

  .page-theme-toggle-button:hover .moon {
    transform: translate(-50%, -50%) rotate(15deg) scale(1.1);
  }

  page-select[data-theme="dark"] .page-theme-toggle-button:hover .sun,
  [data-theme="dark"] .page-theme-toggle-button:hover .sun {
    transform: translate(-50%, -50%) rotate(-180deg) scale(0.8);
  }

  page-select[data-theme="dark"] .page-theme-toggle-button:hover .moon,
  [data-theme="dark"] .page-theme-toggle-button:hover .moon {
    transform: translate(-50%, -50%) rotate(15deg) scale(1.1);
  }

  /* page 스타일 커스텀 속성 */
  page-select {
    display: contents;
  }

  /* 접근성 */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 768px) {
    .page-theme-toggle-button {
      width: 32px !important;
      height: 32px !important;
      min-width: 32px !important;
      min-height: 32px !important;
    }
    .page-theme-toggle-button .sun,
    .page-theme-toggle-button .moon {
      width: 20px !important;
      height: 20px !important;
      min-width: 20px !important;
      min-height: 20px !important;
      font-size: 20px !important;
      line-height: 20px !important;
    }
  }

  @media (max-width: 480px) {
    .page-theme-toggle-button {
      width: 32px !important;
      height: 32px !important;
      min-width: 32px !important;
      min-height: 32px !important;
    }
  }
</style>

<script>
  class pageThemeSelect extends HTMLElement {
    constructor() {
      super();
      this.initTheme();
      this.setupEventListeners();
    }

    initTheme() {
      // 저장된 테마 불러오기 또는 시스템 기본값
      const savedTheme = this.getSavedTheme();
      this.applyTheme(savedTheme);

      // DOM이 완전히 로드된 후 다시 한번 테마 적용
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", () => {
          this.applyTheme(savedTheme);
        });
      } else {
        // DOM이 이미 로드된 경우 즉시 적용
        setTimeout(() => {
          this.applyTheme(savedTheme);
        }, 0);
      }
    }

    getSavedTheme() {
      if (typeof localStorage !== "undefined") {
        return localStorage.getItem("starlight-theme") || this.getSystemTheme();
      }
      return this.getSystemTheme();
    }

    getSystemTheme() {
      return window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
    }

    applyTheme(theme: string) {
      document.documentElement.setAttribute("data-theme", theme);
      document.body.setAttribute("data-theme", theme);
      this.setAttribute("data-theme", theme);

      // 모든 Starlight 요소와 헤더, 푸터, CodeCopy, 모바일 메뉴 토글에 테마 적용
      const starlightElements = document.querySelectorAll(
        ".sl-container, .sl-content, .sl-sidebar, .sl-nav, .page-header, .page-footer-container, .page-code-copy-button, .page-mobile-menu-toggle",
      );
      starlightElements.forEach((element) => {
        element.setAttribute("data-theme", theme);
      });

      if (typeof localStorage !== "undefined") {
        localStorage.setItem("starlight-theme", theme);
      }

      // 테마 변경 이벤트 발생
      window.dispatchEvent(
        new CustomEvent("themechange", { detail: { theme } }),
      );
    }

    setupEventListeners() {
      const button = this.querySelector("button");
      if (!button) return;

      button.addEventListener("click", () => {
        const currentTheme =
          document.documentElement.getAttribute("data-theme");
        const newTheme = currentTheme === "dark" ? "light" : "dark";

        // page 스타일 클릭 애니메이션
        button.style.transform = "scale(0.9)";
        setTimeout(() => {
          button.style.transform = "";
        }, 100);

        this.applyTheme(newTheme);
      });

      // 시스템 테마 변경 감지
      window
        .matchMedia("(prefers-color-scheme: dark)")
        .addEventListener("change", (e) => {
          if (!localStorage.getItem("starlight-theme")) {
            this.applyTheme(e.matches ? "dark" : "light");
          }
        });

      // 테마 변경 이벤트 리스너
      window.addEventListener("themechange", (event: any) => {
        const { theme } = event.detail;
        // 주요 요소들에만 테마 속성 적용 (성능 최적화)
        const keyElements = document.querySelectorAll(
          ".sl-container, .sl-content, .sl-sidebar, .sl-nav, .page-header, .page-footer-container, .page-code-copy-button, .page-mobile-menu-toggle, .page-mobile-menu-overlay",
        );
        keyElements.forEach((element) => {
          if (element instanceof HTMLElement) {
            element.setAttribute("data-theme", theme);
          }
        });
      });
    }
  }

  customElements.define("page-select", pageThemeSelect);
</script>
