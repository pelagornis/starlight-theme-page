---
const { toc, entry, sidebar } = Astro.locals.starlightRoute;
import Sidebar from "./Sidebar.astro";
import MobileMenuOverlay from "./MobileMenuOverlay.astro";

// 사이드바가 있는지 확인
const hasSidebar = sidebar && sidebar.length > 0;
---

<main
  class={`page-main-container ${hasSidebar ? "with-sidebar" : "no-sidebar"} ${toc ? "with-toc" : "no-toc"}`}
>
  {
    hasSidebar && (
      <aside class="page-sidebar-nav">
        <Sidebar />
      </aside>
    )
  }

  <div
    class={`page-content-wrapper ${!hasSidebar ? "page-content-wrapper-full" : ""}`}
  >
    <slot />
  </div>

  {
    toc && (
      <aside class="page-toc-sidebar">
        <div class="page-toc-sticky">
          <slot name="right-sidebar" />
        </div>
      </aside>
    )
  }

  <MobileMenuOverlay />
</main>

<style>
  /* CSS 변수 정의 */
  :root {
    --page-sidebar-width: 320px;
    --page-toc-width: 320px;
    --page-content-gap: var(--page-space-10);
    --page-toc-right-margin: 40px;
    --page-toc-top-position: 88px;
    --page-toc-height: calc(100vh - 104px);
  }

  /* 화면 크기에 따른 동적 조절 */
  @media (min-width: 1600px) and (max-width: 1999px) {
    :root {
      --page-toc-width: 300px;
      --page-content-gap: var(--page-space-8);
    }
  }

  @media (min-width: 2000px) and (max-width: 2399px) {
    :root {
      --page-toc-width: 320px;
      --page-content-gap: var(--page-space-10);
    }
  }

  @media (min-width: 2400px) {
    :root {
      --page-toc-width: 360px;
      --page-content-gap: var(--page-space-12);
    }
  }

  /* 전체 레이아웃 래퍼 */
  .page-layout-wrapper {
    min-height: 100vh;
    background: var(--page-bg);
  }

  /* 메인 컨테이너 */
  .page-main-container {
    display: flex;
    min-height: calc(100vh - var(--page-header-height));
    position: relative;
  }

  /* 사이드바가 있는 경우 */
  .page-main-container.with-sidebar {
    gap: var(--page-content-gap);
  }

  /* 사이드바가 없는 경우 */
  .page-main-container.no-sidebar {
    gap: 0;
  }

  /* TOC가 있는 경우 */
  .page-main-container.with-toc {
    gap: var(--page-content-gap);
  }

  /* TOC가 없는 경우 */
  .page-main-container.no-toc {
    gap: var(--page-content-gap);
  }

  /* 왼쪽 사이드바 (축소된 크기) */
  .page-sidebar-nav {
    width: var(--page-sidebar-width);
    flex-shrink: 0;
    background: var(--page-bg);
    overflow-y: auto;
    transition: transform 0.3s ease;
  }

  /* 데스크톱에서 사이드바 표시 (축소된 크기) */
  @media (min-width: 769px) {
    .page-sidebar-nav {
      position: fixed;
      top: var(--page-header-height, 64px);
      left: 0;
      height: calc(100vh - var(--page-header-height, 64px));
      z-index: 10;
      transform: translateX(0);
      padding: var(--page-space-6);
      width: var(--page-sidebar-width);
    }

    .page-content-wrapper {
      margin-left: 200px;
      width: calc(100% - 200px);
      max-width: calc(100% - 200px);
    }
  }

  /* 모바일에서는 사이드바 숨기기 (햄버거 메뉴로만 접근) */
  @media (max-width: 768px) {
    .page-main-container {
      flex-direction: column;
      padding: 0;
    }

    .page-sidebar-nav {
      position: fixed;
      top: var(--page-header-height, 64px);
      left: 0;
      width: 200px;
      height: calc(100vh - var(--page-header-height, 64px));
      background: var(--page-bg);
      border-right: 1px solid var(--page-border);
      z-index: 1000;
      transform: translateX(-100%);
      transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      overflow-y: auto;
      box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
      display: block !important;
      visibility: visible !important;
    }

    .page-sidebar-nav[data-open="true"] {
      transform: translateX(0);
    }

    .page-content-wrapper {
      width: 100%;
      padding: 0 var(--page-space-4);
      margin-left: 0;
      min-width: 0;
      max-width: 100%;
    }
  }

  /* 컨텐츠 래퍼 - 반응형 자동 조절 */
  .page-content-wrapper {
    flex: 1;
    min-height: calc(100vh - var(--page-header-height));
    width: 100%;
    padding-top: var(--page-space-6);
    min-width: 0;
  }

  /* index 페이지일 때 전체 너비 사용 */
  .page-content-wrapper-full {
    margin-left: 0 !important;
    width: 100% !important;
    max-width: 1200px !important;
    margin: 0 auto !important;
    padding: 0 var(--page-space-8) !important;
  }

  /* 모바일에서 index 페이지 패딩 조정 */
  @media (max-width: 768px) {
    .page-content-wrapper-full {
      padding: 0 var(--page-space-4) !important;
    }
  }

  /* 반응형 max-width 조정 */
  @media (min-width: 1400px) {
    .page-content-wrapper-full {
      max-width: 1400px !important;
    }
  }

  @media (min-width: 1600px) {
    .page-content-wrapper-full {
      max-width: 1600px !important;
    }
  }

  .page-single-column {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--page-space-6) var(--page-space-8);
    animation: pageFadeIn 0.3s ease-out;
    background: var(--page-bg);
    flex: 1;
    width: 100%;
  }

  .page-two-column-layout {
    position: relative;
    padding: var(--page-space-6) var(--page-space-8);
    animation: pageFadeIn 0.3s ease-out;
    background: var(--page-bg);
    min-height: calc(100vh - var(--page-header-height));
    flex: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--page-space-8);
  }

  /* 매우 큰 화면에서 최대 너비 제한 */
  @media (min-width: 2000px) {
    .page-main-container {
      max-width: 1800px;
      margin: 0 auto;
    }
  }

  /* 초대형 화면에서 더 넓은 최대 너비 */
  @media (min-width: 2400px) {
    .page-main-container {
      max-width: 2000px;
      margin: 0 auto;
    }
  }

  /* 중간 화면에서 TOC를 위로 이동 - 반응형 */
  @media (min-width: 768px) and (max-width: 1279px) {
    .page-main-container {
      flex-direction: column;
      gap: var(--page-space-8);
      width: 100%;
      max-width: 100%;
      margin: 0;
      padding: var(--page-space-6);
    }

    .page-content-wrapper {
      margin-left: var(--page-sidebar-width);
      width: calc(100% - var(--page-sidebar-width));
      min-width: 0;
      order: 2;
    }

    .page-toc-sidebar {
      order: 1;
      margin-bottom: var(--page-space-8);
      width: 100%;
      display: none !important;
    }

    .page-toc-sticky {
      position: relative;
      top: auto;
      max-height: none;
      margin: 0;
      width: 100%;
    }
  }

  /* 중간 화면에서 최대 너비 제한 */
  @media (min-width: 1200px) and (max-width: 1599px) {
    .page-main-container {
      max-width: 1200px;
      margin: 0 auto;
    }
  }

  /* 큰 화면에서 TOC를 오른쪽에 표시 */
  @media (min-width: 1280px) {
    .page-main-container {
      display: flex;
      flex-direction: row;
      gap: var(--page-content-gap);
      width: 100%;
      max-width: 100%;
      margin: 0;
      padding: var(--page-space-10);
    }

    .page-content-wrapper {
      flex: 1;
      margin-left: var(--page-sidebar-width);
      width: auto;
      min-width: 0;
      max-width: none;
      margin-right: 5rem;
    }

    .page-toc-sidebar {
      display: block !important;
      position: fixed;
      right: var(--page-toc-right-margin);
      top: var(--page-toc-top-position);
      width: var(--page-toc-width);
      height: var(--page-toc-height);
      z-index: 99;
    }
  }

  @media (min-width: 1536px) {
    .page-two-column-layout {
      max-width: 1800px;
      gap: 3rem;
    }
  }

  @media (min-width: 1920px) {
    .page-two-column-layout {
      max-width: 2000px;
      gap: 4rem;
    }
  }

  .page-content-area {
    min-width: 0;
    position: relative;
  }

  .page-toc-sidebar {
    display: block;
    width: 320px;
    flex-shrink: 0;
  }

  @media (min-width: 768px) {
    .page-toc-sidebar {
      display: block;
      position: relative;
    }
  }

  .page-toc-sticky {
    position: fixed;
    top: calc(var(--page-header-height) + var(--page-space-8));
    max-height: calc(100vh - var(--page-header-height) - var(--page-space-10));
    overflow-y: auto;
    padding: var(--page-space-6);
    background: var(--page-bg);
    border: 1px solid var(--page-border);
    border-radius: 24px;
  }

  [data-theme="dark"] .page-toc-sticky {
    background: var(--page-bg);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  /* TOC 제목 스타일 */
  .page-toc-sticky :global(h2) {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--page-text);
    margin: 0 0 var(--page-space-4) 0;
    padding-bottom: var(--page-space-2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* TOC 링크 스타일 */
  .page-toc-sticky :global(ul) {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .page-toc-sticky :global(li) {
    margin: 0;
  }

  .page-toc-sticky :global(a) {
    display: block;
    padding: var(--page-space-2) 0;
    color: var(--page-text-secondary);
    text-decoration: none;
    font-size: 0.875rem;
    line-height: 1.4;
    transition: all 0.2s ease;
    border-radius: var(--page-radius-xl);
    margin: 2px 0;
  }

  .page-toc-sticky :global(a:hover) {
    color: var(--page-text);
    background: var(--page-accent-light);
    padding-left: var(--page-space-2);
  }

  .page-toc-sticky :global(a[aria-current="true"]) {
    color: var(--page-accent);
    font-weight: 500;
    background: var(--page-accent-light);
    padding-left: var(--page-space-2);
  }

  /* TOC 깊이별 들여쓰기 */
  .page-toc-sticky :global(ul ul) {
    margin-left: var(--page-space-4);
    border-left: 1px solid var(--page-border);
    padding-left: var(--page-space-2);
  }

  /* page 스타일 TOC 스크롤바 */
  .page-toc-sticky::-webkit-scrollbar {
    width: 4px;
  }

  .page-toc-sticky::-webkit-scrollbar-track {
    background: transparent;
  }

  .page-toc-sticky::-webkit-scrollbar-thumb {
    background: var(--page-border);
    border-radius: 2px;
  }

  .page-toc-sticky::-webkit-scrollbar-thumb:hover {
    background: var(--page-text-secondary);
  }

  /* page 스타일 TOC 링크 스타일링 - 간소화 */
  :global(.page-toc-sticky .sl-toc) {
    font-size: 0.875rem;
  }

  :global(.page-toc-sticky .sl-toc a) {
    color: var(--page-text-secondary) !important;
    text-decoration: none !important;
    display: block !important;
    padding: var(--page-space-2) 0 !important;
    border-radius: var(--page-radius-xl) !important;
    transition: all 0.2s ease !important;
    margin: 2px 0 !important;
  }

  :global(.page-toc-sticky .sl-toc a:hover) {
    color: var(--page-text) !important;
    background: var(--page-accent-light) !important;
    padding-left: var(--page-space-2) !important;
  }

  :global(.page-toc-sticky .sl-toc a[aria-current="true"]) {
    color: var(--page-accent) !important;
    background: var(--page-accent-light) !important;
    padding-left: var(--page-space-2) !important;
    font-weight: 500 !important;
  }

  /* page 스타일 TOC 제목 */
  :global(.page-toc-sticky .sl-toc > summary) {
    color: var(--page-text) !important;
    font-weight: 600 !important;
    font-size: 0.875rem !important;
    margin-bottom: var(--page-space-4) !important;
    padding-bottom: var(--page-space-2) !important;
    border-bottom: 1px solid var(--page-border) !important;
    text-transform: uppercase !important;
    letter-spacing: 0.05em !important;
  }

  /* page 스타일 중첩 TOC */
  :global(.page-toc-sticky .sl-toc ul) {
    list-style: none !important;
    margin-left: var(--page-space-4) !important;
    border-left: 1px solid var(--page-border) !important;
    padding-left: var(--page-space-2) !important;
  }

  :global(.page-toc-sticky .sl-toc ul a) {
    font-size: 0.8125rem !important;
  }

  /* Starlight 기본 TOC를 header 아래에 fixed로 표시 */
  :global(.sl-toc:not(.sl-toc-mobile)) {
    position: fixed !important;
    top: calc(var(--page-header-height) + var(--page-space-4)) !important;
    left: var(--page-sidebar-width) !important;
    right: var(--page-space-4) !important;
    z-index: 100 !important;
    max-height: calc(
      100vh - var(--page-header-height) - var(--page-space-8)
    ) !important;
    overflow-y: auto !important;
  }

  /* Starlight 기본 TOC 제목 스타일 - 원래 디자인 유지 */
  :global(.sl-toc > summary) {
    display: flex !important;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: var(--page-space-3) var(--page-space-4);
    background: var(--page-bg);
    border: 1px solid var(--page-border);
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--page-text);
    margin-bottom: var(--page-space-4);
  }

  /* Starlight 기본 TOC 목록 스타일 - 원래 디자인 유지 */
  :global(.sl-toc ul) {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  :global(.sl-toc li) {
    margin: 0 !important;
  }

  :global(.sl-toc a) {
    display: block !important;
    padding: var(--page-space-2) 0 !important;
    color: var(--page-text-secondary) !important;
    text-decoration: none !important;
    font-size: 0.875rem !important;
    line-height: 1.4 !important;
    transition: all 0.2s ease !important;
    border-radius: 6px !important;
    margin: 2px 0 !important;
  }

  :global(.sl-toc a:hover) {
    color: var(--page-text) !important;
    background: var(--page-accent-light) !important;
    padding-left: var(--page-space-2) !important;
  }

  :global(.sl-toc a[aria-current="true"]) {
    color: var(--page-accent) !important;
    background: var(--page-accent-light) !important;
    padding-left: var(--page-space-2) !important;
    font-weight: 500 !important;
  }

  /* 모바일에서 TOC 위치 조정 */
  @media (max-width: 767px) {
    .page-toc-sidebar {
      display: none !important;
    }

    /* 모바일에서 TOC 완전히 숨기기 */
    :global(.sl-toc:not(.sl-toc-mobile)) {
      display: none !important;
    }

    /* 컨텐츠에 상단 여백 추가 */
    .page-content-wrapper {
      padding-top: calc(var(--page-header-height) + var(--page-space-8));
    }
  }

  /* 중간 화면에서 TOC 숨기기 */
  @media (min-width: 768px) and (max-width: 1279px) {
    .page-toc-sidebar {
      display: none !important;
    }

    /* 중간 화면에서도 TOC 숨기기 */
    :global(.sl-toc:not(.sl-toc-mobile)) {
      display: none !important;
    }

    /* 중간 화면에서 컨텐츠 여백 추가 */
    .page-content-wrapper {
      padding-top: calc(var(--page-header-height));
    }
  }

  /* 다크 테마에서 TOC 스타일 */
  [data-theme="dark"] :global(.sl-toc) {
    background: var(--page-bg) !important;
    border-color: var(--page-border) !important;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3) !important;
  }

  [data-theme="dark"] :global(.sl-toc > summary) {
    background: var(--page-bg) !important;
    border-color: var(--page-border) !important;
    color: var(--page-text) !important;
  }

  /* 모바일 반응형 */
  @media (max-width: 768px) {
    .page-single-column,
    .page-two-column-layout {
      padding: var(--page-space-6) var(--page-space-4);
    }
  }

  /* 페이지 컨테이너 스타일 */
  .page-content-area {
    background: var(--page-bg);
    border-radius: var(--page-radius-lg);
    position: relative;
  }

  /* 작은 화면에서 카드 스타일 제거 */
  @media (max-width: 1279px) {
    .page-content-area {
      background: transparent;
      border-radius: 0;
    }
  }

  /* page 스타일 페이지 전환 애니메이션 */
  @keyframes pageFadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* 큰 화면에서 더 넓은 여백 */
  @media (min-width: 2560px) {
    .page-two-column-layout {
      max-width: 2400px;
      gap: 5rem;
    }

    .page-single-column {
      max-width: 1400px;
    }
  }
</style>
