---
import Default from "@astrojs/starlight/components/Search.astro";
---

<!-- 검색 버튼 -->
<button
  aria-label="Search"
  class="page-search-button"
  title="Search (Ctrl+K)"
  type="button"
  id="page-search-trigger"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="11" cy="11" r="8"></circle>
    <path d="m21 21-4.35-4.35"></path>
  </svg>
  <span class="sr-only">Search</span>
</button>

<!-- Starlight 기본 Search 컴포넌트 (완전히 렌더링하되 버튼만 숨김) -->
<Default />

<style>
  /* Starlight 기본 검색 버튼만 숨김 (모달과 다른 기능은 정상 작동) */
  :global(site-search button[data-open-modal]),
  :global(button[data-open-modal]),
  :global(.sl-search-button) {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
    opacity: 0 !important;
    visibility: hidden !important;
    /* 버튼은 클릭 가능하게 유지 (트리거용) */
    pointer-events: auto !important;
    z-index: -1 !important;
  }

  /* Starlight 검색 모달은 완전히 정상 작동하도록 보장 */
  :global(site-search dialog),
  :global(dialog[aria-label*="Search" i]),
  :global(.dialog-frame) {
    pointer-events: auto !important;
    visibility: visible !important;
    opacity: 1 !important;
  }

  /* page 스타일 검색 버튼 - 다른 버튼들과 동일한 스타일 */
  .page-search-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--page-radius);
    background: var(--page-accent-light);
    border: none;
    color: var(--page-text-secondary);
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
  }

  .page-search-button:hover {
    background: var(--page-neutral-200);
    color: var(--page-text);
    transform: translateY(-1px);
  }

  .page-search-button:focus-visible {
    outline: 2px solid var(--page-accent);
    outline-offset: 2px;
  }

  .page-search-button:active {
    transform: scale(0.95);
  }

  .page-search-button svg {
    width: 18px;
    height: 18px;
  }

  :global([data-theme="dark"]) .page-search-button:hover {
    background: var(--page-neutral-800) !important;
    color: var(--page-text) !important;
  }

  /* 접근성 */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* 모바일 최적화 */
  @media (max-width: 768px) {
    .page-search-button {
      width: 40px;
      height: 40px;
    }

    .page-search-button svg {
      width: 18px;
      height: 18px;
    }
  }

  @media (max-width: 480px) {
    .page-search-button {
      width: 32px !important;
      height: 32px !important;
      min-width: 32px !important;
      min-height: 32px !important;
    }

    .page-search-button svg {
      width: 16px !important;
      height: 16px !important;
      min-width: 16px !important;
      min-height: 16px !important;
    }
  }
</style>

<script>
  // 검색 버튼 클릭 시 Starlight 검색 모달 열기
  function initSearchButton() {
    const searchButton = document.querySelector(
      ".page-search-button"
    ) as HTMLButtonElement;
    if (!searchButton) return;

    // Starlight의 기본 검색 버튼 찾기 함수
    const findSearchButton = (): HTMLButtonElement | HTMLElement | null => {
      // Starlight 검색 버튼 찾기
      const selectors = [
        "button[data-open-modal]",
        "site-search button[data-open-modal]",
        'button[aria-label*="Search" i]',
        'button[aria-label*="検索" i]',
        ".sl-search-button",
        "[data-search-button]",
      ];

      for (const selector of selectors) {
        const element = document.querySelector(selector);
        if (
          element &&
          (element instanceof HTMLButtonElement ||
            element instanceof HTMLElement)
        ) {
          return element;
        }
      }
      return null;
    };

    // 버튼 클릭 이벤트
    searchButton.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();

      const triggerSearch = () => {
        // 1. 기본 검색 버튼 찾기 및 클릭
        const defaultSearchButton = findSearchButton();
        if (defaultSearchButton) {
          // 디버깅 (개발 환경에서만)
          if (import.meta.env.DEV) {
            console.log(
              "[Search Debug] Found search button:",
              defaultSearchButton
            );
            console.log(
              "[Search Debug] Button classes:",
              defaultSearchButton.className
            );
            console.log(
              "[Search Debug] Button type:",
              defaultSearchButton instanceof HTMLButtonElement
                ? "HTMLButtonElement"
                : "HTMLElement"
            );
          }

          if (defaultSearchButton instanceof HTMLButtonElement) {
            // HTMLButtonElement인 경우 직접 클릭
            defaultSearchButton.click();
            return true;
          } else {
            // HTMLElement인 경우 클릭 이벤트 디스패치 및 직접 클릭
            const clickEvent = new MouseEvent("click", {
              bubbles: true,
              cancelable: true,
              view: window,
            });
            defaultSearchButton.dispatchEvent(clickEvent);

            // 추가로 직접 클릭 시도 (일부 경우에 작동)
            if (
              "click" in defaultSearchButton &&
              typeof defaultSearchButton.click === "function"
            ) {
              defaultSearchButton.click();
            }
            return true;
          }
        }

        // 2. Starlight 검색 모달 직접 열기 (dialog 요소)
        const dialog = document.querySelector(
          'site-search dialog, dialog[aria-label*="Search" i], dialog[aria-label*="検索" i]'
        ) as HTMLDialogElement;
        if (dialog && typeof dialog.showModal === "function") {
          try {
            dialog.showModal();
            return true;
          } catch (err) {
            console.debug("dialog.showModal() failed:", err);
          }
        }

        // 3. 키보드 이벤트 시뮬레이션 (Ctrl/Cmd + K)
        const isMac = navigator.platform.toUpperCase().indexOf("MAC") >= 0;
        const keyboardEvent = new KeyboardEvent("keydown", {
          key: "k",
          code: "KeyK",
          ctrlKey: !isMac,
          metaKey: isMac,
          bubbles: true,
          cancelable: false,
        });

        // window와 document 모두에 디스패치
        window.dispatchEvent(keyboardEvent);
        document.dispatchEvent(keyboardEvent);

        return false;
      };

      // 즉시 시도
      if (triggerSearch()) {
        return;
      }

      // DOM이 아직 준비되지 않았을 수 있으므로 여러 번 재시도
      let attempts = 0;
      const maxAttempts = 5;
      const retryInterval = setInterval(() => {
        attempts++;
        if (triggerSearch() || attempts >= maxAttempts) {
          clearInterval(retryInterval);
        }
      }, 100);
    });

    // MutationObserver로 기본 검색 버튼이 DOM에 추가될 때까지 감지
    const observer = new MutationObserver(() => {
      const defaultSearchButton = findSearchButton();
      if (defaultSearchButton) {
        observer.disconnect();
      }
    });

    observer.observe(document.body, {
      childList: true,
      subtree: true,
    });

    // docsearch 모달 닫기 이벤트 처리 (중복 방지)
    let clickHandler: ((e: MouseEvent) => void) | null = null;
    let escapeHandler: ((e: KeyboardEvent) => void) | null = null;
    let cancelHandler: ((e: MouseEvent) => void) | null = null;

    const closeDocSearch = () => {
      // Starlight 검색 모달 닫기 (dialog 요소)
      const dialog = document.querySelector(
        'site-search dialog, dialog[aria-label*="Search" i], dialog[aria-label*="検索" i]'
      ) as HTMLDialogElement;

      if (dialog && typeof dialog.close === "function") {
        try {
          dialog.close();

          // 키보드 포커스 복원
          const button = findSearchButton();
          if (button && button instanceof HTMLElement) {
            button.focus();
          }
          return;
        } catch (err) {
          console.debug("dialog.close() failed:", err);
        }
      }

      // fallback: close-modal 버튼 클릭
      const closeButton = document.querySelector(
        "button[data-close-modal]"
      ) as HTMLButtonElement;
      if (closeButton) {
        closeButton.click();
      }
    };

    const setupModalCloseHandlers = () => {
      // 기존 핸들러 제거 (중복 방지) - 등록할 때와 동일한 phase 사용
      if (clickHandler) {
        document.removeEventListener("click", clickHandler, false);
      }
      if (escapeHandler) {
        document.removeEventListener("keydown", escapeHandler, false);
      }
      if (cancelHandler) {
        document.removeEventListener("click", cancelHandler, false);
      }

      // 모달 바깥 클릭 감지 (Starlight dialog)
      clickHandler = (e: MouseEvent) => {
        const dialog = document.querySelector(
          'site-search dialog, dialog[aria-label*="Search" i], dialog[aria-label*="検索" i]'
        ) as HTMLDialogElement;

        if (!dialog || !dialog.open) {
          return;
        }

        const target = e.target as HTMLElement;
        if (!target) return;

        // dialog 내부 요소 클릭은 무시 (검색 기능이 작동하도록)
        const dialogFrame = dialog.querySelector(".dialog-frame");

        // dialog 자체를 클릭했거나, dialog 내부지만 dialog-frame 밖인 경우 닫기
        if (
          target === dialog ||
          (dialog.contains(target) &&
            dialogFrame &&
            !dialogFrame.contains(target))
        ) {
          e.stopPropagation();
          e.preventDefault();
          closeDocSearch();
        }
      };

      // ESC 키로 닫기
      escapeHandler = (e: KeyboardEvent) => {
        if (e.key === "Escape") {
          const dialog = document.querySelector(
            'site-search dialog, dialog[aria-label*="Search" i], dialog[aria-label*="検索" i]'
          ) as HTMLDialogElement;
          if (dialog && dialog.open) {
            e.preventDefault();
            e.stopPropagation();
            closeDocSearch();
          }
        }
      };

      // Cancel 버튼 클릭 감지 (이벤트 위임 사용)
      cancelHandler = (e: MouseEvent) => {
        const target = e.target as HTMLElement;
        const closeButton = target.closest("button[data-close-modal]");
        if (closeButton) {
          // Starlight가 먼저 처리할 수 있도록 이벤트 전파는 막지 않음
          // 하지만 안전하게 닫기 시도
          setTimeout(() => {
            const dialog = document.querySelector(
              'site-search dialog, dialog[aria-label*="Search" i], dialog[aria-label*="検索" i]'
            ) as HTMLDialogElement;
            if (dialog && dialog.open) {
              closeDocSearch();
            }
          }, 10);
        }
      };

      // 이벤트 리스너 등록 (bubble phase에서 실행하여 DocSearch가 먼저 처리하도록)
      // capture phase를 사용하지 않음으로써 DocSearch의 이벤트가 먼저 처리됨
      document.addEventListener("click", clickHandler, false);
      document.addEventListener("keydown", escapeHandler, false);
      document.addEventListener("click", cancelHandler, false);
    };

    // 모달 직접 클릭 핸들러 제거 (DocSearch가 직접 처리하도록 함)
    // 대신 document 레벨에서만 배경 클릭 감지

    // 모달이 열릴 때마다 이벤트 리스너 재설정
    const modalObserver = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        mutation.addedNodes.forEach((node) => {
          if (node instanceof HTMLElement) {
            const dialog =
              node.querySelector?.("dialog") ||
              (node.tagName === "DIALOG" ? node : null);
            if (dialog && dialog.closest("site-search")) {
              setupModalCloseHandlers();
            }
          }
        });

        // dialog의 open 속성 변경 감지 (모달 열림/닫힘)
        if (
          mutation.type === "attributes" &&
          mutation.attributeName === "open"
        ) {
          const dialog = mutation.target as HTMLDialogElement;
          if (dialog.tagName === "DIALOG" && dialog.closest("site-search")) {
            if (dialog.open) {
              // 모달이 열릴 때
              setupModalCloseHandlers();
            }
          }
        }
      });
    });

    modalObserver.observe(document.body, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ["aria-hidden", "style"],
    });

    // 초기 모달 닫기 이벤트 설정
    setupModalCloseHandlers();

    // 키보드 단축키 (Ctrl/Cmd + K) 지원
    document.addEventListener("keydown", (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === "k") {
        e.preventDefault();
        // 이미 검색 모달이 열려있는지 확인
        const dialog = document.querySelector(
          'site-search dialog, dialog[aria-label*="Search" i], dialog[aria-label*="検索" i]'
        ) as HTMLDialogElement;
        if (dialog && dialog.open) {
          // 모달이 열려있으면 닫기
          closeDocSearch();
        } else {
          // 모달이 닫혀있으면 열기
          searchButton.click();
        }
      }
    });
  }

  // 초기화
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSearchButton);
  } else {
    initSearchButton();
  }

  // Astro 페이지 변경 시에도 초기화
  document.addEventListener("astro:page-load", initSearchButton);
</script>
