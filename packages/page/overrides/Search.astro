---
import Default from "@astrojs/starlight/components/Search.astro";
---

<Default />

<script>
  // 전역 변수로 observer 참조 저장
  let observer: MutationObserver | null = null;
  let isInitialized = false;

  // kbd 요소의 배경색을 강제로 제거
  function removeKbdBackground() {
    const kbdElements = document.querySelectorAll("kbd");
    kbdElements.forEach((kbd) => {
      kbd.style.backgroundColor = "transparent";
      kbd.style.background = "transparent";
    });
  }

  // 초기화 함수
  function initializeSearch() {
    // 이미 초기화되었다면 중복 실행 방지
    if (isInitialized) {
      return;
    }

    // DOM이 로드된 후 실행
    removeKbdBackground();

    // 기존 observer 정리
    if (observer) {
      observer.disconnect();
      observer = null;
    }

    // 테마 변경 시에도 실행 (최적화된 observer)
    observer = new MutationObserver((mutations) => {
      let shouldUpdate = false;

      mutations.forEach((mutation) => {
        if (
          mutation.type === "attributes" &&
          mutation.attributeName === "data-theme"
        ) {
          shouldUpdate = true;
        }
      });

      if (shouldUpdate) {
        // 디바운스 적용
        clearTimeout((window as any).searchUpdateTimeout);
        (window as any).searchUpdateTimeout = setTimeout(() => {
          removeKbdBackground();
        }, 100);
      }
    });

    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });

    isInitialized = true;
  }

  // 정리 함수
  function cleanup() {
    if (observer) {
      observer.disconnect();
      observer = null;
    }

    if ((window as any).searchUpdateTimeout) {
      clearTimeout((window as any).searchUpdateTimeout);
      (window as any).searchUpdateTimeout = null;
    }

    isInitialized = false;
  }

  // DOM이 로드되면 초기화
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeSearch);
  } else {
    initializeSearch();
  }

  // Astro 페이지 로드 시에도 초기화 (기존 observer 정리 후)
  document.addEventListener("astro:page-load", () => {
    cleanup();
    initializeSearch();
  });

  // 페이지 언로드 시 정리
  window.addEventListener("beforeunload", cleanup);
</script>

<style is:global>
  /* page 스타일 검색 다이얼로그 */
  site-search {
    & dialog {
      background-color: var(--page-bg-elevated);
      border: 1px solid var(--page-border);
      border-radius: var(--page-radius-lg);
      box-shadow: var(--page-shadow-xl);
      backdrop-filter: blur(20px);
      color: var(--page-text);
    }

    & input {
      background-color: var(--page-bg);
      border: 1px solid var(--page-border);
      border-radius: var(--page-radius);
      color: var(--page-text);
      transition: all 0.2s ease;
      font-family: var(--page-font-family);
      padding: 12px 16px;
      font-size: 16px;
    }

    & input:focus-visible {
      outline: none;
      border-color: var(--page-accent);
      box-shadow: 0 0 0 2px var(--page-accent-light);
    }

    & input::placeholder {
      color: var(--page-text-muted);
    }

    /* page 스타일 검색 결과 */
    & mark {
      background: var(--page-accent-light);
      color: var(--page-accent);
      border-radius: 3px;
      padding: 0 2px;
    }

    /* 검색 결과 아이템 */
    & .sl-flex {
      color: var(--page-text);
    }

    & h3 {
      color: var(--page-text);
    }

    & p {
      color: var(--page-text-secondary);
    }

    /* 검색 결과 링크 */
    & a {
      color: var(--page-text);
      border-radius: var(--page-radius);
      transition: all 0.2s ease;
    }

    & a:hover {
      background: var(--page-accent-light);
    }
  }

  /* page 스타일 검색 버튼 - 다른 버튼들과 동일 */
  :global(.sl-search-button) {
    background: var(--page-bg-secondary) !important;
    border: 1px solid var(--page-border) !important;
    border-radius: var(--page-radius) !important;
    color: var(--page-text-secondary) !important;
    transition: all 0.2s ease !important;
    font-family: var(--page-font-family) !important;
    padding: 8px 12px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    /* Starlight 기본 변수 강제 오버라이드 */
    --sl-color-gray-1: var(--page-bg-secondary) !important;
    --sl-color-gray-2: var(--page-border) !important;
    --sl-color-gray-3: var(--page-border-strong) !important;
    --sl-color-gray-4: var(--page-text-secondary) !important;
    --sl-color-gray-5: var(--page-text) !important;
    --sl-color-gray-6: var(--page-text) !important;
    --sl-color-white: var(--page-bg) !important;
    --sl-color-black: var(--page-text) !important;
  }

  :global(.sl-search-button:hover) {
    background: var(--page-bg-elevated) !important;
    border-color: var(--page-border-strong) !important;
    color: var(--page-text) !important;
    transform: translateY(-1px) !important;
    box-shadow: var(--page-shadow-sm) !important;
    /* 호버 상태에서도 Starlight 변수 오버라이드 */
    --sl-color-gray-1: var(--page-bg-elevated) !important;
    --sl-color-gray-2: var(--page-border-strong) !important;
    --sl-color-gray-3: var(--page-border-strong) !important;
    --sl-color-gray-4: var(--page-text) !important;
    --sl-color-gray-5: var(--page-text) !important;
    --sl-color-gray-6: var(--page-text) !important;
  }

  [data-theme="dark"] :global(.sl-search-button) {
    background: var(--page-bg-secondary) !important;
    border-color: var(--page-border) !important;
    color: var(--page-text-secondary) !important;
    /* 다크 모드에서 Starlight 변수 오버라이드 */
    --sl-color-gray-1: var(--page-bg-secondary) !important;
    --sl-color-gray-2: var(--page-border) !important;
    --sl-color-gray-3: var(--page-border-strong) !important;
    --sl-color-gray-4: var(--page-text-secondary) !important;
    --sl-color-gray-5: var(--page-text) !important;
    --sl-color-gray-6: var(--page-text) !important;
    --sl-color-white: var(--page-bg) !important;
    --sl-color-black: var(--page-text) !important;
  }

  [data-theme="dark"] :global(.sl-search-button:hover) {
    background: var(--page-bg-elevated) !important;
    border-color: var(--page-border-strong) !important;
    color: var(--page-text) !important;
    /* 다크 모드 호버 상태에서도 Starlight 변수 오버라이드 */
    --sl-color-gray-1: var(--page-bg-elevated) !important;
    --sl-color-gray-2: var(--page-border-strong) !important;
    --sl-color-gray-3: var(--page-border-strong) !important;
    --sl-color-gray-4: var(--page-text) !important;
    --sl-color-gray-5: var(--page-text) !important;
    --sl-color-gray-6: var(--page-text) !important;
  }

  /* 검색 버튼 포커스 효과 - 다른 버튼들과 동일 */
  :global(.sl-search-button:focus-visible) {
    outline: 2px solid var(--page-accent) !important;
    outline-offset: 2px !important;
  }

  /* 검색 버튼 내부 아이콘 */
  :global(.sl-search-button svg) {
    width: 16px !important;
    height: 16px !important;
    color: inherit !important;
  }

  /* 검색 버튼 내부 텍스트 */
  :global(.sl-search-button span) {
    color: inherit !important;
    font-weight: 500 !important;
    font-size: 14px !important;
  }

  /* 검색 다이얼로그 내부 스타일 개선 */
  site-search {
    & dialog {
      /* 다크 모드에서 배경 개선 */
      [data-theme="dark"] & {
        background-color: var(--page-bg-elevated) !important;
        border-color: var(--page-border) !important;
      }
    }

    & input {
      /* 다크 모드에서 입력 필드 개선 */
      [data-theme="dark"] & {
        background-color: var(--page-bg) !important;
        border-color: var(--page-border) !important;
        color: var(--page-text) !important;
      }
    }

    & input:focus-visible {
      /* 다크 모드에서 포커스 개선 */
      [data-theme="dark"] & {
        border-color: var(--page-accent) !important;
        box-shadow: 0 0 0 2px var(--page-accent-light) !important;
      }
    }

    & input::placeholder {
      /* 다크 모드에서 플레이스홀더 개선 */
      [data-theme="dark"] & {
        color: var(--page-text-muted) !important;
      }
    }

    /* 검색 결과 스타일 개선 */
    & .sl-flex {
      [data-theme="dark"] & {
        color: var(--page-text) !important;
      }
    }

    & h3 {
      [data-theme="dark"] & {
        color: var(--page-text) !important;
      }
    }

    & p {
      [data-theme="dark"] & {
        color: var(--page-text-secondary) !important;
      }
    }

    & a {
      [data-theme="dark"] & {
        color: var(--page-text) !important;
      }
    }

    & a:hover {
      [data-theme="dark"] & {
        background: var(--page-accent-light) !important;
      }
    }
  }

  ::backdrop {
    --sl-color-backdrop-overlay: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(4px);
  }

  [data-theme="light"] ::backdrop {
    --sl-color-backdrop-overlay: rgba(255, 255, 255, 0.8);
  }

  /* page 스타일 검색 애니메이션 */
  @media (prefers-reduced-motion: no-preference) {
    site-search {
      & dialog,
      & dialog::backdrop {
        transition:
          display 300ms allow-discrete,
          overlay 300ms allow-discrete;
        animation-timing-function: ease-out;
        animation-fill-mode: forwards;
        will-change: transform, opacity, backdrop-filter, background-color;
      }

      & dialog {
        animation-name: page-search-dialog-zoom-out;
        animation-duration: 150ms;
        transform: translateZ(0);
      }

      & dialog[open] {
        animation-duration: 50ms;
        animation-name: page-search-dialog-zoom-in;
      }

      & dialog::backdrop {
        -webkit-backdrop-filter: none;
        backdrop-filter: none;

        animation-duration: 150ms;
        animation-name: page-search-backdrop-fade-out;
      }

      & dialog[open]::backdrop {
        animation-duration: 50ms;
        animation-name: page-search-backdrop-fade-in;
      }
    }
  }

  /* page 스타일 검색 백드롭 애니메이션 */
  @keyframes page-search-backdrop-fade-in {
    from {
      background-color: transparent;
    }
    to {
      background-color: var(--sl-color-backdrop-overlay);
    }
  }

  @keyframes page-search-backdrop-fade-out {
    from {
      background-color: var(--sl-color-backdrop-overlay);
    }
    to {
      background-color: transparent;
    }
  }

  site-search {
    --page-search-dialog-zoom-scale: 1;
    --page-search-dialog-zoom-translate-y: 0;
  }

  @media (min-width: 72rem) {
    site-search {
      --page-search-dialog-zoom-scale: 0.95;
      --page-search-dialog-zoom-translate-y: -1rem;
    }
  }

  @keyframes page-search-dialog-zoom-in {
    from {
      opacity: 0;
      transform: scale(var(--page-search-dialog-zoom-scale))
        translateY(var(--page-search-dialog-zoom-translate-y));
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @keyframes page-search-dialog-zoom-out {
    from {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
    to {
      opacity: 0;
      transform: scale(var(--page-search-dialog-zoom-scale))
        translateY(var(--page-search-dialog-zoom-translate-y));
    }
  }
</style>
