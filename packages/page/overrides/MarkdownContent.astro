---
import Default from "@astrojs/starlight/components/MarkdownContent.astro";
import CodeCopy from "../components/CodeCopy.astro";
---

<div class="page-content">
  <Default>
    <slot />
  </Default>
</div>

<style is:global>
  .page-content {
    animation: pageFadeIn 0.3s ease-out;
  }

  /* page 스타일 타이포그래피 */
  .page-content .sl-markdown-content {
    line-height: 1.7;
    color: var(--page-text);
    font-family: var(--page-font-family);
  }

  /* page 스타일 헤딩 */
  .page-content .sl-markdown-content h1,
  .page-content .sl-markdown-content h2,
  .page-content .sl-markdown-content h3,
  .page-content .sl-markdown-content h4,
  .page-content .sl-markdown-content h5,
  .page-content .sl-markdown-content h6 {
    font-weight: 700;
    line-height: 1.3;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--page-text);
    scroll-margin-top: 5rem;
    letter-spacing: -0.02em;
  }

  .page-content .sl-markdown-content h1 {
    font-size: 2.25rem;
    margin-top: 0;
    color: var(--page-accent);
    font-weight: 800;
  }

  .page-content .sl-markdown-content h2 {
    font-size: 1.875rem;
    border-bottom: 1px solid var(--page-border);
    padding-bottom: 0.5rem;
    position: relative;
  }

  .page-content .sl-markdown-content h2::after {
    content: "";
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 3rem;
    height: 1px;
    background: var(--page-accent);
  }

  .page-content .sl-markdown-content h3 {
    font-size: 1.5rem;
    color: var(--page-text);
  }

  .page-content .sl-markdown-content h4 {
    font-size: 1.25rem;
    color: var(--page-text);
  }

  /* page 스타일 문단 */
  .page-content .sl-markdown-content p {
    margin: 1.25rem 0;
    line-height: 1.7;
    color: var(--page-text);
  }

  /* page 스타일 리스트 */
  .page-content .sl-markdown-content ul,
  .page-content .sl-markdown-content ol {
    margin: 1.25rem 0;
    padding-left: 1.5rem;
  }

  .page-content .sl-markdown-content li {
    margin: 0.5rem 0;
    line-height: 1.6;
    color: var(--page-text);
  }

  .page-content .sl-markdown-content ul > li::marker {
    color: var(--page-accent);
  }

  .page-content .sl-markdown-content ol > li::marker {
    color: var(--page-accent);
    font-weight: 600;
  }

  /* page 스타일 링크 */
  .page-content .sl-markdown-content a {
    color: var(--page-accent);
    text-decoration: none;
    font-weight: 500;
    position: relative;
    transition: all 0.2s ease;
    border-radius: 2px;
  }

  .page-content .sl-markdown-content a::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--page-accent);
    transition: width 0.2s ease;
  }

  .page-content .sl-markdown-content a:hover {
    color: var(--page-accent);
    background: var(--page-accent-light);
    padding: 0 2px;
    margin: 0 -2px;
  }

  .page-content .sl-markdown-content a:hover::after {
    width: 100%;
  }

  /* page 스타일 인용구 */
  .page-content .sl-markdown-content blockquote {
    margin: 2rem 0;
    padding: 1.5rem;
    border-left: 3px solid var(--page-accent);
    background: var(--page-bg-secondary);
    border-radius: 0 var(--page-radius) var(--page-radius) 0;
    position: relative;
  }

  .page-content .sl-markdown-content blockquote p {
    margin: 0;
    font-style: italic;
    font-size: 1.05rem;
    color: var(--page-text-secondary);
  }

  /* page 스타일 코드 블록 */
  .page-content .sl-markdown-content pre {
    margin: 2rem 0;
    padding: 1.5rem;
    border-radius: var(--page-radius-lg);
    background: var(--page-bg-secondary);
    border: 1px solid var(--page-border);
    overflow-x: auto;
    position: relative;
    box-shadow: var(--page-shadow-sm);
  }

  .page-content .sl-markdown-content code {
    font-family: "SF Mono", Monaco, "Cascadia Code", "Roboto Mono", Consolas,
      "Courier New", monospace;
    font-size: 0.9em;
  }

  .page-content .sl-markdown-content :not(pre) > code {
    background: var(--page-accent-light);
    color: var(--page-accent);
    padding: 0.25rem 0.5rem;
    border-radius: var(--page-radius-sm);
    font-size: 0.875em;
    font-weight: 600;
  }

  [data-theme="dark"] .page-content .sl-markdown-content :not(pre) > code {
    background: var(--page-accent-light);
    color: var(--page-accent);
  }

  /* page 스타일 테이블 */
  .page-content .sl-markdown-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    background: var(--page-bg);
    border: 1px solid var(--page-border);
    border-radius: var(--page-radius);
    overflow: hidden;
    box-shadow: var(--page-shadow-sm);
  }

  .page-content .sl-markdown-content th,
  .page-content .sl-markdown-content td {
    padding: 0.75rem 1rem;
    text-align: left;
    border-bottom: 1px solid var(--page-border);
  }

  .page-content .sl-markdown-content th {
    background: var(--page-bg-secondary);
    font-weight: 600;
    color: var(--page-text);
  }

  .page-content .sl-markdown-content td {
    color: var(--page-text);
  }

  .page-content .sl-markdown-content tr:hover {
    background: var(--page-accent-light);
  }

  /* page 스타일 이미지 */
  .page-content .sl-markdown-content img {
    max-width: 100%;
    height: auto;
    border-radius: var(--page-radius);
    box-shadow: var(--page-shadow-sm);
    transition: all 0.2s ease;
  }

  .page-content .sl-markdown-content img:hover {
    transform: translateY(-2px);
    box-shadow: var(--page-shadow-md);
  }

  /* page 스타일 구분선 */
  .page-content .sl-markdown-content hr {
    margin: 3rem 0;
    border: none;
    height: 1px;
    background: var(--page-border);
  }

  /* page 스타일 정의 리스트 */
  .page-content .sl-markdown-content dd:not(:where(.not-content *)) {
    padding-inline-start: 2rem;
    margin-bottom: 1rem;
    padding-left: 1.5rem;
    border-left: 2px solid var(--page-border);
  }

  .page-content .sl-markdown-content dt {
    font-weight: 600;
    color: var(--page-text);
    margin-top: 1rem;
  }

  /* page 스타일 Starlight Aside 컴포넌트 */
  .page-content .sl-markdown-content .starlight-aside {
    border-radius: var(--page-radius-lg);
    box-shadow: var(--page-shadow-sm);
    transition: all 0.2s ease;
    background: var(--page-bg-secondary);
    border: 1px solid var(--page-border);
  }

  .page-content .sl-markdown-content .starlight-aside:hover {
    transform: translateY(-1px);
    box-shadow: var(--page-shadow-md);
  }

  /* page 스타일 강조 텍스트 */
  .page-content .sl-markdown-content strong {
    color: var(--page-text);
    font-weight: 700;
  }

  .page-content .sl-markdown-content em {
    color: var(--page-text-secondary);
    font-style: italic;
  }

  /* 다크 모드 조정 */
  [data-theme="dark"] .page-content .sl-markdown-content blockquote {
    background: var(--page-bg-secondary);
  }

  [data-theme="dark"] .page-content .sl-markdown-content pre {
    background: var(--page-bg-secondary);
  }

  [data-theme="dark"] .page-content .sl-markdown-content table {
    background: var(--page-bg);
  }

  [data-theme="dark"] .page-content .sl-markdown-content th {
    background: var(--page-bg-secondary);
  }

  [data-theme="dark"] .page-content .sl-markdown-content .starlight-aside {
    background: var(--page-bg-secondary);
  }

  /* 반응형 조정 */
  @media (max-width: 768px) {
    .page-content .sl-markdown-content h1 {
      font-size: 1.875rem;
    }

    .page-content .sl-markdown-content h2 {
      font-size: 1.5rem;
    }

    .page-content .sl-markdown-content pre {
      margin-left: -1rem;
      margin-right: -1rem;
      border-radius: 0;
    }

    .page-content .sl-markdown-content table {
      font-size: 0.875rem;
    }
  }

  /* 큰 화면 최적화 */
  @media (min-width: 1536px) {
    .page-content .sl-markdown-content {
      font-size: 1.125rem;
      line-height: 1.8;
    }

    .page-content .sl-markdown-content h1 {
      font-size: 2.5rem;
    }

    .page-content .sl-markdown-content h2 {
      font-size: 2rem;
    }

    .page-content .sl-markdown-content h3 {
      font-size: 1.625rem;
    }

    .page-content .sl-markdown-content p {
      margin: 1.5rem 0;
    }

    .page-content .sl-markdown-content blockquote {
      padding: 2rem;
      font-size: 1.1rem;
    }
  }

  /* page 스타일 스크롤바 */
  .page-content .sl-markdown-content pre::-webkit-scrollbar {
    height: 6px;
  }

  .page-content .sl-markdown-content pre::-webkit-scrollbar-track {
    background: var(--page-bg-secondary);
  }

  .page-content .sl-markdown-content pre::-webkit-scrollbar-thumb {
    background: var(--page-neutral-300);
    border-radius: 3px;
  }

  .page-content .sl-markdown-content pre::-webkit-scrollbar-thumb:hover {
    background: var(--page-neutral-400);
  }

  [data-theme="dark"]
    .page-content
    .sl-markdown-content
    pre::-webkit-scrollbar-track {
    background: var(--page-bg-secondary);
  }

  [data-theme="dark"]
    .page-content
    .sl-markdown-content
    pre::-webkit-scrollbar-thumb {
    background: var(--page-neutral-600);
  }

  [data-theme="dark"]
    .page-content
    .sl-markdown-content
    pre::-webkit-scrollbar-thumb:hover {
    background: var(--page-neutral-500);
  }
</style>

<CodeCopy />
