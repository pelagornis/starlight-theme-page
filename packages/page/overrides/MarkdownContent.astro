---
// 완전히 커스텀된 MarkdownContent 컴포넌트
---

<article class="page-markdown-content">
  <slot />
</article>

<style is:global>
  /* 커스텀 MarkdownContent 스타일 */
  .page-markdown-content {
    animation: pageFadeIn 0.3s ease-out;
    line-height: 1.7;
    color: var(--page-text);
    font-family: var(--page-font-family);
    max-width: 100%;
    will-change: auto;
  }

  /* 페이지 페이드인 애니메이션 */
  @keyframes pageFadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* 화면 크기 변경 시 애니메이션 최적화 */
  @media (prefers-reduced-motion: reduce) {
    .page-markdown-content {
      animation: none;
    }
  }

  /* 헤딩 스타일 */
  .page-markdown-content h1,
  .page-markdown-content h2,
  .page-markdown-content h3,
  .page-markdown-content h4,
  .page-markdown-content h5,
  .page-markdown-content h6 {
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 1rem;
    color: var(--page-text);
    scroll-margin-top: 5rem;
    letter-spacing: -0.02em;
  }

  .page-markdown-content h1 {
    font-size: 2.25rem;
    color: var(--page-accent);
    font-weight: 800;
    margin-top: 0;
  }

  .page-markdown-content h2 {
    font-size: 1.875rem;
    border-bottom: 1px solid var(--page-border);
    padding-bottom: 0.5rem;
    position: relative;
    margin-top: 2.5rem;
  }

  .page-markdown-content h2::after {
    content: "";
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 3rem;
    height: 1px;
    background: var(--page-accent);
  }

  .page-markdown-content h3 {
    font-size: 1.5rem;
    color: var(--page-text);
    margin-top: 2rem;
  }

  .page-markdown-content h4 {
    font-size: 1.25rem;
    color: var(--page-text);
    margin-top: 1.5rem;
  }

  /* 문단 스타일 */
  .page-markdown-content p {
    margin: 1.25rem 0;
    line-height: 1.7;
    color: var(--page-text);
  }

  /* 리스트 스타일 */
  .page-markdown-content ul,
  .page-markdown-content ol {
    margin: 1.25rem 0;
    padding-left: 1.5rem;
  }

  .page-markdown-content li {
    margin: 0.5rem 0;
    line-height: 1.6;
    color: var(--page-text);
  }

  .page-markdown-content ul > li::marker {
    color: var(--page-accent);
  }

  .page-markdown-content ol > li::marker {
    color: var(--page-accent);
    font-weight: 600;
  }

  /* 링크 스타일 */
  .page-markdown-content a {
    color: var(--page-accent);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s ease;
    border-bottom: 1px solid transparent;
  }

  .page-markdown-content a:hover {
    color: var(--page-accent-hover);
    border-bottom-color: var(--page-accent);
  }

  /* 인용구 스타일 */
  .page-markdown-content blockquote {
    margin: 2rem 0;
    padding: 1.5rem;
    border-left: 3px solid var(--page-accent);
    background: var(--page-bg-secondary);
    border-radius: 0 var(--page-radius) var(--page-radius) 0;
    position: relative;
  }

  .page-markdown-content blockquote p {
    margin: 0;
    font-style: italic;
    font-size: 1.05rem;
    color: var(--page-text-secondary);
  }

  /* 코드 블록 스타일 */
  .page-markdown-content pre {
    padding: 1.5rem;
    border-radius: var(--page-radius-lg);
    background: var(--page-bg-secondary);
    border: 1px solid var(--page-border);
    overflow-x: auto;
    position: relative;
    box-shadow: var(--page-shadow-sm);
    margin: 1.5rem 0;
  }

  .page-markdown-content code {
    font-family: "SF Mono", Monaco, "Cascadia Code", "Roboto Mono", Consolas,
      "Courier New", monospace;
    font-size: 0.9em;
  }

  .page-markdown-content :not(pre) > code {
    background: var(--page-accent-light);
    color: var(--page-accent);
    padding: 0.25rem 0.5rem;
    border-radius: var(--page-radius-sm);
    font-size: 0.875em;
    font-weight: 600;
  }

  /* 테이블 스타일 */
  .page-markdown-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    background: var(--page-bg);
    border: 1px solid var(--page-border);
    border-radius: var(--page-radius);
    overflow: hidden;
    box-shadow: var(--page-shadow-sm);
  }

  .page-markdown-content th,
  .page-markdown-content td {
    padding: 0.75rem 1rem;
    text-align: left;
    border-bottom: 1px solid var(--page-border);
  }

  .page-markdown-content th {
    background: var(--page-bg-secondary);
    font-weight: 600;
    color: var(--page-text);
  }

  .page-markdown-content td {
    color: var(--page-text);
  }

  .page-markdown-content tr:hover {
    background: var(--page-accent-light);
  }

  /* 이미지 스타일 */
  .page-markdown-content img {
    max-width: 100%;
    height: auto;
    border-radius: var(--page-radius);
    box-shadow: var(--page-shadow-sm);
    transition: all 0.2s ease;
  }

  .page-markdown-content img:hover {
    transform: translateY(-2px);
    box-shadow: var(--page-shadow-md);
  }

  /* 구분선 스타일 */
  .page-markdown-content hr {
    margin: 3rem 0;
    border: none;
    height: 1px;
    background: var(--page-border);
  }

  /* 정의 리스트 스타일 */
  .page-markdown-content dd {
    padding-inline-start: 2rem;
    margin-bottom: 1rem;
    padding-left: 1.5rem;
    border-left: 2px solid var(--page-border);
  }

  .page-markdown-content dt {
    font-weight: 600;
    color: var(--page-text);
  }

  /* 강조 텍스트 */
  .page-markdown-content strong {
    color: var(--page-text);
    font-weight: 700;
  }

  .page-markdown-content em {
    color: var(--page-text-secondary);
    font-style: italic;
  }

  /* 다크 모드 조정 */
  [data-theme="dark"] .page-markdown-content blockquote {
    background: var(--page-bg-secondary);
  }

  [data-theme="dark"] .page-markdown-content pre {
    background: var(--page-bg-secondary);
  }

  [data-theme="dark"] .page-markdown-content table {
    background: var(--page-bg);
  }

  [data-theme="dark"] .page-markdown-content th {
    background: var(--page-bg-secondary);
  }

  /* 반응형 조정 */
  @media (max-width: 768px) {
    .page-markdown-content h1 {
      font-size: 1.875rem;
    }

    .page-markdown-content h2 {
      font-size: 1.5rem;
    }

    .page-markdown-content pre {
      margin-left: -1rem;
      margin-right: -1rem;
      border-radius: 0;
    }

    .page-markdown-content table {
      font-size: 0.875rem;
    }
  }

  /* 큰 화면 최적화 */
  @media (min-width: 1536px) {
    .page-markdown-content {
      font-size: 1.125rem;
      line-height: 1.8;
    }

    .page-markdown-content h1 {
      font-size: 2.5rem;
    }

    .page-markdown-content h2 {
      font-size: 2rem;
    }

    .page-markdown-content h3 {
      font-size: 1.625rem;
    }

    .page-markdown-content p {
      margin: 1.5rem 0;
    }

    .page-markdown-content blockquote {
      padding: 2rem;
      font-size: 1.1rem;
    }
  }

  /* 스크롤바 스타일 */
  .page-markdown-content pre::-webkit-scrollbar {
    height: 6px;
  }

  .page-markdown-content pre::-webkit-scrollbar-track {
    background: var(--page-bg-secondary);
  }

  .page-markdown-content pre::-webkit-scrollbar-thumb {
    background: var(--page-neutral-300);
    border-radius: 3px;
  }

  .page-markdown-content pre::-webkit-scrollbar-thumb:hover {
    background: var(--page-neutral-400);
  }

  [data-theme="dark"] .page-markdown-content pre::-webkit-scrollbar-track {
    background: var(--page-bg-secondary);
  }

  [data-theme="dark"] .page-markdown-content pre::-webkit-scrollbar-thumb {
    background: var(--page-neutral-600);
  }

  [data-theme="dark"]
    .page-markdown-content
    pre::-webkit-scrollbar-thumb:hover {
    background: var(--page-neutral-500);
  }
</style>
