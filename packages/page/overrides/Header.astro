---
import config from "virtual:starlight/user-config";
import SiteTitle from "virtual:starlight/components/SiteTitle";
import type { NavigationItem, NavigationLink } from "../index.ts";
import {
  DocsHeaderNav,
  DocsHeaderSearch,
  DocsMobileMenuToggle,
  type DocsHeaderNavSection,
  type DocsSearchItem,
} from "./DocsHeader";
import { DocsThemeSelect } from "./DocsThemeSelect";
import { docsLabels } from "./labels";
import { serializeNav, type DocsNavEntry } from "./nav";

const labels = docsLabels(Astro.locals.t);

const configured: NavigationItem[] = process.env.PAGE_NAVIGATION ? JSON.parse(process.env.PAGE_NAVIGATION) : [];
const { hasSidebar, sidebar, lang, locale } = Astro.locals.starlightRoute;
const currentPath = decodeURI(Astro.url.pathname);
const nav = serializeNav(sidebar);

function translate(item: { label?: string; translations?: Record<string, string> }, fallback = "") {
  return item.translations?.[lang] ?? item.label ?? fallback;
}

function localize(href: string) {
  if (!locale || !href.startsWith("/") || href.startsWith(`/${locale}/`)) return href;
  return `/${locale}${href}`;
}

/** Sidebar groups keep their config order, so the config index finds the translated group. */
function sidebarGroup(label: string) {
  const index = (config.sidebar ?? []).findIndex(
    (entry) => typeof entry === "object" && "label" in entry && entry.label === label,
  );
  const group: DocsNavEntry | undefined = nav[index];
  return group?.type === "group" ? group : undefined;
}

/** One dropdown link per direct sidebar link, and one per nested group pointing at its first page. */
function sidebarLinks(label: string) {
  const group = sidebarGroup(label);
  if (!group) return [];
  const links = new Map<string, { label: string; href: string; active: boolean }>();
  for (const link of group.entries) {
    const key = link.section ?? link.href;
    const existing = links.get(key);
    if (existing) existing.active ||= link.isCurrent;
    else links.set(key, { label: link.section ?? link.label, href: link.href, active: link.isCurrent });
  }
  return [...links.values()];
}

const trimSlash = (path: string) => path.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => trimSlash(href) === trimSlash(currentPath);
const isWithin = (href: string) =>
  isCurrent(href) || (trimSlash(href) !== "/" && trimSlash(currentPath).startsWith(`${trimSlash(href)}/`));

const sections: DocsHeaderNavSection[] = configured.map((item, index) => {
  if ("href" in item) {
    const href = localize(item.href);
    return { value: `nav-${index}`, label: translate(item), href, active: isWithin(href), links: [] };
  }
  const links = item.sidebar
    ? sidebarLinks(item.sidebar)
    : (item.items ?? []).map((link: NavigationLink) => {
        const href = localize(link.href);
        return { label: translate(link), href, active: isCurrent(href) };
      });
  const label = translate(item, item.sidebar ? sidebarGroup(item.sidebar)?.label : "");
  return { value: `nav-${index}`, label, href: links[0]?.href ?? "", active: links.some((link) => link.active), links };
});

const searchItems: DocsSearchItem[] = nav.flatMap((entry) =>
  entry.type === "link"
    ? [{ value: entry.href, label: entry.label, href: entry.href, group: "", external: entry.external }]
    : entry.entries.map((link) => ({
        value: link.href,
        label: link.label,
        href: link.href,
        group: link.section ?? entry.label,
        external: link.external,
      })),
);
---

<div data-refineui-docs-header>
  <SiteTitle />
  <DocsHeaderNav
    client:load
    sections={sections}
    label={labels.nav}
  />
  <div data-refineui-docs-header-end>
    <DocsHeaderSearch client:load items={searchItems} contentSearch={Boolean(config.pagefind)} labels={labels} />
    <div data-refineui-docs-tools>
      <div data-refineui-docs-theme>
        <DocsThemeSelect client:load labels={labels} />
      </div>
    </div>
    {hasSidebar ? <DocsMobileMenuToggle client:load labels={labels} /> : null}
  </div>
</div>
