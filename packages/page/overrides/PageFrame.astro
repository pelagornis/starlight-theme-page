---
import config from "virtual:starlight/user-config";
import MobileMenuFooter from "virtual:starlight/components/MobileMenuFooter";
import { COLLAPSED_KEY, DocsShell, STORAGE_KEY } from "./DocsShell";
import { DocsSidebar } from "./DocsSidebar";
import { docsLabels } from "./labels";
import { serializeNav } from "./nav";

const { hasSidebar, siteTitle, siteTitleHref, sidebar } = Astro.locals.starlightRoute;
const entries = hasSidebar ? serializeNav(sidebar) : [];
const labels = docsLabels(Astro.locals.t);
const githubHref = Array.isArray(config.social)
  ? config.social.find((entry) => entry.icon === "github")?.href
  : undefined;

// @astrojs/react strips `<link rel="stylesheet">` from island HTML, so stylesheets in the
// content (such as Expressive Code's) are rendered outside the DocsShell island.
const content = hasSidebar ? await Astro.slots.render("default") : "";
const stylesheets = [...new Set(content.match(/<link\s[^>]*rel="stylesheet"[^>]*>/g) ?? [])];
---

<div class="page sl-flex" data-docs-page={hasSidebar ? "with-sidebar" : "flush"}>
  <header class="header"><slot name="header" /></header>
  {
    hasSidebar && (
      <nav
        class="sidebar print:hidden"
        data-docs-mobile-sidebar
        aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}
      >
        <div id="starlight__sidebar" class="sidebar-pane">
          <div class="sidebar-content sl-flex">
            <DocsSidebar
              client:load
              title={siteTitle}
              titleHref={siteTitleHref}
              entries={entries}
              navLabel={labels.nav}
            />
            <MobileMenuFooter />
          </div>
        </div>
      </nav>
    )
  }
  <div class="main-frame">
    {
      hasSidebar ? (
        <>
          <script is:inline define:vars={{ sizeKey: STORAGE_KEY, collapsedKey: COLLAPSED_KEY }}>
            {
              const root = document.documentElement;
              const size = Number(localStorage.getItem(sizeKey));
              if (size > 0) root.style.setProperty("--docs-sidebar-size", String(size));
              root.toggleAttribute("data-docs-sidebar-collapsed", localStorage.getItem(collapsedKey) === "1");
            }
          </script>
          <Fragment set:html={stylesheets.join("")} />
          <DocsShell
            client:load
            title={siteTitle}
            titleHref={siteTitleHref}
            entries={entries}
            githubHref={githubHref}
            labels={labels}
          >
            <Fragment set:html={content} />
          </DocsShell>
        </>
      ) : (
        <slot />
      )
    }
  </div>
</div>

<style>
  @layer starlight.core {
    .page {
      flex-direction: column;
      min-height: 100vh;
    }

    .header {
      z-index: var(--sl-z-index-navbar);
      position: fixed;
      inset-inline-start: 0;
      inset-block-start: 0;
      width: 100%;
      height: var(--sl-nav-height);
      border-bottom: 1px solid var(--sl-color-hairline-shade);
      padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
      padding-inline-end: var(--sl-nav-pad-x);
      background-color: var(--sl-color-bg-nav);
    }

    .sidebar-pane {
      visibility: var(--sl-sidebar-visibility, hidden);
      position: fixed;
      z-index: var(--sl-z-index-menu);
      inset-block: var(--sl-nav-height) 0;
      inset-inline-start: 0;
      width: 100%;
      background-color: var(--sl-color-black);
      overflow-y: auto;
    }

    :global(body[data-mobile-menu-expanded]) [data-docs-mobile-sidebar] .sidebar-pane {
      --sl-sidebar-visibility: visible;
    }

    .sidebar-content {
      height: 100%;
      min-height: max-content;
      padding: 0;
      flex-direction: column;
      gap: 0;
    }

    .main-frame {
      padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
      padding-inline-start: 0;
      min-height: calc(100vh - var(--sl-nav-height));
    }

    @media (min-width: 50rem) {
      .main-frame {
        padding-top: var(--sl-nav-height);
        height: calc(100vh - var(--sl-nav-height));
        min-height: calc(100vh - var(--sl-nav-height));
      }

      :global([data-docs-page="with-sidebar"]) .sidebar {
        display: none;
      }

      .sidebar-pane {
        --sl-sidebar-visibility: hidden;
      }
    }
  }
</style>
