---
// Page-style mobile menu overlay
import * as pkg from "@refineui/web-icons";
import { ICON_NAME_MAPPING } from "../lib/icon-names";
const createIconHTML = (
  pkg as {
    createIconHTML?: (
      name: string,
      style: "regular" | "filled",
    ) => (size?: number, color?: string, className?: string) => string;
  }
).createIconHTML;
const closeIcon =
  typeof createIconHTML === "function"
    ? createIconHTML(ICON_NAME_MAPPING.dismiss ?? "Dismiss", "regular")
    : () => "";
---

<style>
  .page-mobile-menu-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    z-index: 9999;
    display: none;
    align-items: flex-start;
    justify-content: flex-start;
  }

  .page-mobile-menu-overlay.page-mobile-menu-open {
    display: flex;
  }

  .page-mobile-menu-content {
    width: 100%;
    height: 100%;
    background: var(--page-bg);
    border-right: 1px solid var(--page-border);
    display: flex;
    flex-direction: column;
    box-shadow: 4px 0 20px rgba(0, 0, 0, 0.1);
  }

  /* Shown only on mobile: match mobile header - padding space-4, button 32px, icon 20px */
  .page-mobile-menu-header {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 0 var(--page-space-4);
    min-height: 52px;
    border-bottom: 1px solid var(--page-border);
    background: var(--page-bg);
  }

  .page-mobile-menu-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    min-width: 32px;
    min-height: 32px;
    padding: var(--page-space-2);
    border: none;
    border-radius: var(--page-radius);
    background: var(--page-accent-light);
    color: var(--page-text-secondary);
    box-sizing: border-box;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .page-mobile-menu-close :global(.refineui-icon),
  .page-mobile-menu-close :global(span[class*="refineui"]) {
    font-family: "RefineUI-System-Icons-Regular", sans-serif;
    width: 20px;
    height: 20px;
    min-width: 20px;
    min-height: 20px;
    font-size: 20px;
    line-height: 1;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
  }

  .page-mobile-menu-close:hover {
    background: var(--page-text-reverse);
    color: var(--page-text);
    transform: translateY(-1px);
    box-shadow: var(--page-shadow-sm);
  }

  .page-mobile-menu-close:focus-visible {
    outline: 2px solid var(--page-accent);
    outline-offset: 2px;
  }

  .page-mobile-menu-nav {
    flex: 1;
    padding: var(--page-space-4);
    overflow-y: auto;
  }

  /* Sidebar styles inside mobile menu */
  .page-mobile-menu-nav .page-sidebar-container {
    gap: var(--page-space-6);
    flex-direction: column;
    display: flex;
  }

  .page-mobile-menu-nav .page-sidebar-group {
    gap: var(--page-space-3);
    flex-direction: column;
    display: flex;
    margin-bottom: var(--page-space-6);
  }

  .page-mobile-menu-nav .page-sidebar-group:last-child {
    margin-bottom: 0;
  }

  .page-mobile-menu-nav .page-sidebar-group-title {
    font-weight: 700;
    font-size: 0.75rem;
    line-height: 1.2;
    padding: var(--page-space-2) var(--page-space-3);
    border-radius: var(--page-radius);
    color: var(--page-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: transparent;
    margin-bottom: var(--page-space-2);
  }

  .page-mobile-menu-nav .page-sidebar-group-links {
    font-size: 0.875rem;
    line-height: 1.4;
    gap: var(--page-space-1);
    display: flex;
    flex-direction: column;
  }

  .page-mobile-menu-nav .page-sidebar-link {
    text-underline-offset: 2px;
    color: var(--page-text-secondary);
    font-weight: 500;
    padding: var(--page-space-3) var(--page-space-4);
    border-radius: var(--page-radius);
    align-items: center;
    width: 100%;
    min-height: 40px;
    display: flex;
    color: inherit;
    text-decoration: inherit;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    font-size: 0.875rem;
  }

  .page-mobile-menu-nav .page-sidebar-link[aria-current="page"] {
    color: var(--page-accent);
    font-weight: 600;
    background: var(--page-accent-light);
    position: relative;
  }

  .page-mobile-menu-nav .page-sidebar-link[aria-current="page"]::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    border-radius: 0 var(--page-radius-sm) var(--page-radius-sm) 0;
  }

  .page-mobile-menu-nav .page-sidebar-link:hover {
    color: var(--page-text);
    background: var(--page-accent-light);
    transform: translateX(4px);
  }

  .page-mobile-menu-nav .page-sidebar-badge {
    color: var(--page-neutral-white);
    line-height: 1;
    font-size: 0.75rem;
    padding: var(--page-space-1) var(--page-space-2);
    background: var(--page-neutral-700);
    border-radius: var(--page-radius-sm);
    margin-left: auto;
    font-weight: 600;
  }

  /* Dark theme mobile menu styles */
  [data-theme="dark"] .page-mobile-menu-content {
    background: var(--page-bg);
    border-color: var(--page-border);
  }

  [data-theme="dark"] .page-mobile-menu-header {
    background: var(--page-bg-secondary);
    border-color: var(--page-border);
  }

  [data-theme="dark"] .page-mobile-menu-header h3 {
    color: var(--page-text);
  }

  [data-theme="dark"] .page-mobile-menu-close {
    background: transparent;
    border-color: var(--page-border);
    color: var(--page-text);
  }

  [data-theme="dark"] .page-mobile-menu-close:hover {
    border-color: var(--page-accent);
    background: var(--page-bg-secondary);
  }

  [data-theme="dark"] .page-mobile-menu-nav .page-sidebar-link {
    color: var(--page-text-secondary);
  }

  [data-theme="dark"]
    .page-mobile-menu-nav
    .page-sidebar-link[aria-current="page"] {
    color: var(--page-accent);
    background: var(--page-accent-light);
  }

  [data-theme="dark"] .page-mobile-menu-nav .page-sidebar-link:hover {
    color: var(--page-text);
    background: var(--page-accent-light);
  }

  [data-theme="dark"] .page-mobile-menu-nav .page-sidebar-badge {
    background: var(--page-neutral-700);
    color: var(--page-neutral-white);
  }

  /* Dark mode overlay background emphasis */
  [data-theme="dark"] .page-mobile-menu-overlay {
    background: rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(8px);
  }

  /* Global dark mode style overrides */
  :global([data-theme="dark"]) .page-mobile-menu-overlay {
    background: rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(8px);
    color: inherit;
  }

  :global([data-theme="dark"]) .page-mobile-menu-content {
    background: var(--page-bg);
    border-color: var(--page-border);
    color: var(--page-text);
  }

  :global([data-theme="dark"]) .page-mobile-menu-header {
    background: var(--page-bg);
    border-color: var(--page-border);
    color: var(--page-text);
  }

  /* Close button uses theme variables like header buttons (no separate dark override) */
</style>

<!-- Mobile menu overlay -->
<div class="page-mobile-menu-overlay" id="page-mobile-menu-overlay">
  <div class="page-mobile-menu-content">
    <div class="page-mobile-menu-header">
      <button class="page-mobile-menu-close" aria-label="Close menu">
        <Fragment set:html={closeIcon(20, "currentColor", "refineui-icon")} />
      </button>
    </div>
    <nav class="page-mobile-menu-nav"></nav>
  </div>
</div>

<script>
  // Store event listener refs in module scope
  let isInitialized = false;
  let closeButtonHandler: (() => void) | null = null;
  let overlayClickHandler: ((event: Event) => void) | null = null;
  let astroPageLoadHandler: (() => void) | null = null;

  function initializeMobileMenuOverlay() {
    // Prevent duplicate initialization
    if (isInitialized) {
      return;
    }

    const mobileMenu = document.querySelector(
      "#page-mobile-menu-overlay",
    ) as HTMLElement;

    if (!mobileMenu) {
      console.error("Mobile menu overlay not found.");
      return;
    }

    // Update with actual sidebar content
    updateMobileMenuContent();

    // Add close button listener (avoid duplicate registration)
    const closeButton = mobileMenu.querySelector(".page-mobile-menu-close");
    if (closeButton && !closeButtonHandler) {
      closeButtonHandler = () => {
        toggleMobileMenu();
      };
      closeButton.addEventListener("click", closeButtonHandler);
    }

    // Close on overlay click (avoid duplicate registration)
    if (!overlayClickHandler) {
      overlayClickHandler = (event: Event) => {
        if (event.target === mobileMenu) {
          toggleMobileMenu();
        }
      };
      mobileMenu.addEventListener("click", overlayClickHandler);
    }

    isInitialized = true;
  }

  function updateMobileMenuContent() {
    const mobileMenu = document.querySelector("#page-mobile-menu-overlay");
    if (!mobileMenu) return;

    // Get actual sidebar content
    const sidebar = document.querySelector(".page-sidebar");
    const mobileNav = mobileMenu.querySelector(".page-mobile-menu-nav");

    if (sidebar && mobileNav) {
      mobileNav.innerHTML = sidebar.innerHTML;
    }
  }

  function toggleMobileMenu(): boolean {
    // Find mobile menu overlay
    const mobileMenu = document.querySelector(
      "#page-mobile-menu-overlay",
    ) as HTMLElement;

    if (!mobileMenu) {
      return false;
    }

    const isOpen = mobileMenu.classList.contains("page-mobile-menu-open");

    if (isOpen) {
      mobileMenu.classList.remove("page-mobile-menu-open");
      mobileMenu.style.display = "none";
      document.body.style.overflow = "";
      return false;
    } else {
      mobileMenu.style.display = "flex";
      mobileMenu.classList.add("page-mobile-menu-open");
      document.body.style.overflow = "hidden";
      return true;
    }
  }

  // Cleanup event listeners
  function cleanup() {
    const mobileMenu = document.querySelector(
      "#page-mobile-menu-overlay",
    ) as HTMLElement;
    const closeButton = mobileMenu?.querySelector(".page-mobile-menu-close");

    if (closeButton && closeButtonHandler) {
      closeButton.removeEventListener("click", closeButtonHandler);
      closeButtonHandler = null;
    }

    if (mobileMenu && overlayClickHandler) {
      mobileMenu.removeEventListener("click", overlayClickHandler);
      overlayClickHandler = null;
    }

    if (astroPageLoadHandler) {
      document.removeEventListener("astro:page-load", astroPageLoadHandler);
      astroPageLoadHandler = null;
    }

    isInitialized = false;
  }

  // Initialize when DOM is ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeMobileMenuOverlay);
  } else {
    initializeMobileMenuOverlay();
  }

  // Also initialize on Astro page load (after cleaning existing listeners)
  document.addEventListener("astro:page-load", () => {
    cleanup();
    initializeMobileMenuOverlay();
  });

  // Cleanup on page unload
  window.addEventListener("beforeunload", cleanup);
</script>
