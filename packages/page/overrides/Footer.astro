---
import config from "virtual:starlight/user-config";
import context from "virtual:starlight/project-context";
import Pagination from "virtual:starlight/components/Pagination";
import { DocsSiteFooter } from "./DocsSiteFooter";
import { docsLabels } from "./labels";
import { serializeNav, type DocsNavLink } from "./nav";

const { sidebar, editUrl, locale, hasSidebar } = Astro.locals.starlightRoute;
const footerText = process.env.PAGE_FOOTER_TEXT;

function stripTrailingSlash(path: string) {
  return path.replace(/\/$/, "") || "/";
}

function localizedPathname(localeCode: string | undefined): string {
  const url = new URL(Astro.url);
  if (localeCode === "root") localeCode = "";
  const base = stripTrailingSlash(import.meta.env.BASE_URL);
  const hasBase = url.pathname.startsWith(base);
  if (hasBase) url.pathname = url.pathname.replace(base, "");
  const [_leadingSlash, baseSegment] = url.pathname.split("/");
  const htmlExt = ".html";
  const isRootHtml = baseSegment?.endsWith(htmlExt);
  const baseSlug = isRootHtml ? baseSegment?.slice(0, -1 * htmlExt.length) : baseSegment;
  if (baseSlug && baseSlug in config.locales) {
    if (localeCode) url.pathname = url.pathname.replace(baseSlug, localeCode);
    else if (isRootHtml) url.pathname = "/index.html";
    else url.pathname = url.pathname.replace("/" + baseSlug, "");
  } else if (localeCode) {
    url.pathname = baseSegment === "index.html" ? "/" + localeCode + ".html" : "/" + localeCode + url.pathname;
  }
  if (hasBase) url.pathname = base + url.pathname;
  if (context.trailingSlash === "never") url.pathname = stripTrailingSlash(url.pathname);
  return url.pathname;
}

/** Top-level pages stay; each nested section collapses to one link to its first page. */
function representativeLinks(links: DocsNavLink[]) {
  const seen = new Set<string>();
  return links.flatMap((link) => {
    if (!link.section) return [{ label: link.label, href: link.href, external: link.external }];
    if (seen.has(link.section)) return [];
    seen.add(link.section);
    return [{ label: link.section, href: link.href, external: link.external }];
  });
}

const groups = hasSidebar
  ? serializeNav(sidebar).flatMap((entry) => {
      if (entry.type === "link") {
        return [{ label: entry.label, links: [{ label: entry.label, href: entry.href, external: entry.external }] }];
      }
      return [{ label: entry.label, links: representativeLinks(entry.entries) }];
    })
  : [];

const social = Array.isArray(config.social)
  ? config.social.map((entry) => ({
      label: entry.label,
      href: entry.href,
      external: true,
    }))
  : [];

const languages = config.isMultilingual
  ? Object.entries(config.locales).map(([code, entry]) => ({
      value: localizedPathname(code),
      label: entry!.label,
    }))
  : [];
---

<div data-refineui-docs-end>
  <div data-refineui-docs-footer>
    <Pagination />
  </div>
  <div class="not-content">
    <DocsSiteFooter
      client:load
      groups={groups}
      social={social}
      copyright={footerText}
      editHref={editUrl}
      editLabel={editUrl ? Astro.locals.t("page.editLink") : undefined}
      languages={languages}
      languageValue={languages.length > 1 ? localizedPathname(locale) : undefined}
      languageLabel={Astro.locals.t("languageSelect.accessibleLabel")}
      navLabel={docsLabels(Astro.locals.t).footer}
    />
  </div>
</div>
