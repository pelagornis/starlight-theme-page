---
import Default from "@astrojs/starlight/components/Footer.astro";
import config from "virtual:starlight/user-config";

const {
  pagination,
  editUrl,
  lastUpdated,
  entry: {
    data: { template },
    slug,
  },
} = Astro.locals.starlightRoute;

// Check if index page (slug is index, empty, or locale code)
const isIndexPage =
  slug === "index" ||
  slug === "" ||
  (config.locales && Object.keys(config.locales).includes(slug));

const showFooterInSplash =
  template === "splash" &&
  !isIndexPage &&
  !!(
    editUrl ||
    lastUpdated ||
    pagination.next ||
    pagination.prev ||
    config.credits
  );
---

{
  showFooterInSplash && (
    <div class="page-footer-wrapper">
      <div class="page-footer-container">
        <Default />
      </div>
    </div>
  )
}

{
  !showFooterInSplash && template === "splash" && (
    <div class="page-footer-padding" />
  )
}

{
  template === "doc" && (
    <div class="page-footer-wrapper">
      <div class="page-footer-container">
        <Default />
      </div>
    </div>
  )
}

<style>
  .page-footer-wrapper {
    margin-top: var(--page-space-8);
  }

  .page-footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--page-space-8) var(--page-space-6);
    background: var(--page-bg-secondary);
    border-top: 1px solid var(--page-border);
    border-radius: var(--page-radius-lg);
  }

  [data-theme="dark"] .page-footer-container {
    background: var(--page-bg-secondary);
    border-top-color: var(--page-border);
    color: var(--page-text);
  }

  /* Global dark mode overrides */
  :global([data-theme="dark"]) .page-footer-container {
    background: var(--page-bg-secondary);
    border-top-color: var(--page-border);
    color: var(--page-text);
  }

  .page-footer-padding {
    margin-bottom: -3vh;
  }

  /* Starlight default footer overrides */
  :global(.sl-footer) {
    background: transparent;
    border: none;
    padding: 0;
    color: var(--page-text);
  }

  [data-theme="dark"] :global(.sl-footer) {
    background: transparent;
    color: var(--page-text);
  }

  :global([data-theme="dark"]) :global(.sl-footer) {
    background: transparent;
    color: var(--page-text);
  }

  :global(.page-footer-container .sl-footer) {
    background: transparent;
    border: none;
    padding: 0;
    color: var(--page-text);
  }

  [data-theme="dark"] :global(.page-footer-container .sl-footer) {
    background: transparent;
    color: var(--page-text);
  }

  :global(.sl-footer .sl-flex) {
    flex-direction: column;
    gap: 1.5rem;
  }

  :global(.page-footer-container .page-footer-container .sl-flex) {
    flex-direction: column;
    gap: 1.5rem;
  }

  :global(.page-footer-container .meta) {
    gap: 0.75rem 3rem;
    justify-content: space-between;
    flex-wrap: wrap;
    margin-top: 0;
    font-size: var(--sl-text-sm);
    color: var(--page-text-secondary);
  }

  [data-theme="dark"] :global(.page-footer-container .meta) {
    color: var(--page-text-secondary);
  }

  :global(.page-footer-container .meta > p:only-child) {
    margin-inline-start: auto;
  }

  :global(.page-footer-container .kudos) {
    align-items: center;
    gap: 0.5em;
    margin: 1.5rem auto;
    font-size: var(--sl-text-xs);
    text-decoration: none;
    color: var(--page-text-secondary);
  }

  :global(.page-footer-container .page-footer-container .kudos) {
    align-items: center;
    gap: 0.5em;
    margin: 1.5rem auto;
    font-size: var(--sl-text-xs);
    text-decoration: none;
    color: var(--page-text-secondary);
  }

  [data-theme="dark"] :global(.page-footer-container .kudos) {
    color: var(--page-text-secondary);
  }

  [data-theme="dark"]
    :global(.page-footer-container .page-footer-container .kudos) {
    color: var(--page-text-secondary);
  }

  :global(.page-footer-container .kudos svg) {
    color: var(--page-accent);
  }

  :global(.page-footer-container .page-footer-container .kudos svg) {
    color: var(--page-accent);
  }

  [data-theme="dark"] :global(.page-footer-container .kudos svg) {
    color: var(--page-accent);
  }

  [data-theme="dark"]
    :global(.page-footer-container .page-footer-container .kudos svg) {
    color: var(--page-accent);
  }

  :global(.page-footer-container .kudos:hover) {
    color: var(--page-text);
  }

  :global(.page-footer-container .page-footer-container .kudos:hover) {
    color: var(--page-text);
  }

  [data-theme="dark"] :global(.page-footer-container .kudos:hover) {
    color: var(--page-text);
  }

  [data-theme="dark"]
    :global(.page-footer-container .page-footer-container .kudos:hover) {
    color: var(--page-text);
  }

  /* Pagination style */
  :global(.page-footer-container .pagination-links) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--page-space-4);
    margin: var(--page-space-6) 0;
  }

  /* Single column when one link */
  :global(.page-footer-container .pagination-links:has(a:only-child)) {
    grid-template-columns: 1fr;
  }

  :global(.page-footer-container .pagination-links a) {
    background: var(--page-bg);
    border: 1px solid var(--page-border);
    border-radius: var(--page-radius);
    padding: var(--page-space-4);
    text-decoration: none;
    transition: all 0.2s ease;
    display: flex;
    gap: var(--page-space-1);
    color: var(--page-text);
  }

  :global(.page-footer-container .pagination-links a:hover) {
    background: var(--page-accent-light);
    transform: translateY(-1px);
  }

  [data-theme="dark"] :global(.page-footer-container .pagination-links a) {
    background: var(--page-bg);
    border-color: var(--page-border);
    color: var(--page-text);
  }

  [data-theme="dark"]
    :global(.page-footer-container .pagination-links a:hover) {
    background: var(--page-accent-light);
    color: var(--page-accent);
  }

  /* Pagination title and description style */
  :global(.page-footer-container .pagination-links .link-title) {
    font-weight: 600;
    color: var(--page-text);
    font-size: 1.5rem;
  }

  :global(.page-footer-container .pagination-links .description) {
    color: var(--page-text-secondary);
    font-size: 0.8125rem;
  }

  :global(
      .page-footer-container
        .page-footer-container
        .pagination-links
        .description
    ) {
    color: var(--page-text-secondary);
    font-size: 0.8125rem;
  }

  :global(.page-footer-container .pagination-links a:hover .title) {
    color: var(--page-accent);
  }

  :global(
      .page-footer-container
        .page-footer-container
        .pagination-links
        a:hover
        .title
    ) {
    color: var(--page-accent);
  }

  :global(.page-footer-container .pagination-links a:hover .description) {
    color: var(--page-text);
  }

  :global(
      .page-footer-container
        .page-footer-container
        .pagination-links
        a:hover
        .description
    ) {
    color: var(--page-text);
  }

  /* Dark mode pagination style */
  [data-theme="dark"] :global(.page-footer-container .pagination-links .title) {
    color: var(--page-text);
  }

  [data-theme="dark"]
    :global(.page-footer-container .pagination-links .description) {
    color: var(--page-text-secondary);
  }

  [data-theme="dark"]
    :global(.page-footer-container .pagination-links a:hover .title) {
    color: var(--page-accent);
  }

  [data-theme="dark"]
    :global(.page-footer-container .pagination-links a:hover .description) {
    color: var(--page-text);
  }

  /* Edit link style */
  :global(.page-footer-container .edit-page) {
    background: var(--page-accent-light);
    color: var(--page-accent);
    border: 1px solid var(--page-border);
    border-radius: var(--page-radius);
    padding: var(--page-space-2) var(--page-space-4);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: var(--page-space-1);
  }

  :global(.page-footer-container .edit-page:hover) {
    background: var(--page-accent);
    color: var(--page-bg);
    transform: translateY(-1px);
  }

  [data-theme="dark"] :global(.page-footer-container .edit-page) {
    background: var(--page-accent-light);
    color: var(--page-accent);
    border-color: var(--page-border);
  }

  [data-theme="dark"] :global(.page-footer-container .edit-page:hover) {
    background: var(--page-accent);
    color: var(--page-bg);
  }

  [data-theme="dark"] :global(.page-footer-container .last-updated) {
    background: var(--page-bg-secondary);
    color: var(--page-text-muted);
    border-color: var(--page-border);
  }

  /* Last updated style */
  :global(.page-footer-container .last-updated) {
    color: var(--page-text-muted);
    font-size: 0.8125rem;
    margin: var(--page-space-4) 0;
    padding: var(--page-space-2);
    background: var(--page-bg-secondary);
    border-radius: var(--page-radius);
    border: 1px solid var(--page-border);
  }

  /* Dark mode wrapper style */
  [data-theme="dark"] .page-footer-wrapper {
    background: var(--page-bg);
    color: var(--page-text);
  }

  [data-theme="dark"] .page-footer-padding {
    background: var(--page-bg);
    color: var(--page-text);
  }

  :global([data-theme="dark"]) .page-footer-wrapper {
    background: var(--page-bg);
    color: var(--page-text);
  }

  :global([data-theme="dark"]) .page-footer-padding {
    background: var(--page-bg);
    color: var(--page-text);
  }

  /* Mobile responsive */
  @media (max-width: 768px) {
    .page-footer-container {
      padding: var(--page-space-6) var(--page-space-4);
    }

    :global(.page-footer-container .pagination-links) {
      grid-template-columns: 1fr;
      gap: var(--page-space-2);
    }
  }
</style>
