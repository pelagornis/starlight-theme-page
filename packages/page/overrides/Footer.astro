---
import Default from "@astrojs/starlight/components/Footer.astro";
import config from "virtual:starlight/user-config";

const {
  pagination,
  editUrl,
  lastUpdated,
  entry: {
    data: { template },
    slug,
  },
} = Astro.locals.starlightRoute;

// index 페이지인지 확인 (slug가 index이거나 빈 문자열이거나 언어 코드인 경우)
const isIndexPage =
  slug === "index" ||
  slug === "" ||
  (config.locales && Object.keys(config.locales).includes(slug));

const showFooterInSplash =
  template === "splash" &&
  !isIndexPage &&
  !!(
    editUrl ||
    lastUpdated ||
    pagination.next ||
    pagination.prev ||
    config.credits
  );
---

{
  showFooterInSplash && (
    <div class="page-footer-wrapper">
      <div class="page-footer-container">
        <Default />
      </div>
    </div>
  )
}

{
  !showFooterInSplash && template === "splash" && (
    <div class="page-footer-padding" />
  )
}

{
  template === "doc" && (
    <div class="page-footer-wrapper">
      <div class="page-footer-container">
        <Default />
      </div>
    </div>
  )
}

<style>
  .page-footer-wrapper {
    margin-top: var(--page-space-8);
  }

  .page-footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--page-space-8) var(--page-space-6);
    background: var(--page-bg-secondary);
    border-top: 1px solid var(--page-border);
    border-radius: var(--page-radius-lg);
  }

  [data-theme="dark"] .page-footer-container {
    background: var(--page-bg-secondary) !important;
    border-top-color: var(--page-border) !important;
  }

  .page-footer-padding {
    margin-bottom: -3vh;
  }

  /* Starlight 기본 푸터 스타일 오버라이드 */
  :global(.sl-footer) {
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    color: var(--page-text) !important;
  }

  [data-theme="dark"] :global(.sl-footer) {
    background: transparent !important;
    color: var(--page-bg-secondary) !important;
  }

  :global(.page-footer-container .sl-footer) {
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    color: var(--page-text) !important;
  }

  [data-theme="dark"] :global(.page-footer-container .sl-footer) {
    background: transparent !important;
    color: var(--page-text) !important;
  }

  :global(.sl-footer .sl-flex) {
    flex-direction: column;
    gap: 1.5rem;
  }

  :global(.page-footer-container .page-footer-container .sl-flex) {
    flex-direction: column;
    gap: 1.5rem;
  }

  :global(.page-footer-container .meta) {
    gap: 0.75rem 3rem;
    justify-content: space-between;
    flex-wrap: wrap;
    margin-top: 0;
    font-size: var(--sl-text-sm);
    color: var(--page-text-secondary);
  }

  [data-theme="dark"] :global(.page-footer-container .meta) {
    color: var(--page-text-secondary) !important;
  }

  :global(.page-footer-container .meta > p:only-child) {
    margin-inline-start: auto;
  }

  :global(.page-footer-container .kudos) {
    align-items: center;
    gap: 0.5em;
    margin: 1.5rem auto;
    font-size: var(--sl-text-xs);
    text-decoration: none;
    color: var(--page-text-secondary);
  }

  :global(.page-footer-container .page-footer-container .kudos) {
    align-items: center;
    gap: 0.5em;
    margin: 1.5rem auto;
    font-size: var(--sl-text-xs);
    text-decoration: none;
    color: var(--page-text-secondary);
  }

  [data-theme="dark"] :global(.page-footer-container .kudos) {
    color: var(--page-text-secondary) !important;
  }

  [data-theme="dark"]
    :global(.page-footer-container .page-footer-container .kudos) {
    color: var(--page-text-secondary) !important;
  }

  :global(.page-footer-container .kudos svg) {
    color: var(--page-accent);
  }

  :global(.page-footer-container .page-footer-container .kudos svg) {
    color: var(--page-accent);
  }

  [data-theme="dark"] :global(.page-footer-container .kudos svg) {
    color: var(--page-accent) !important;
  }

  [data-theme="dark"]
    :global(.page-footer-container .page-footer-container .kudos svg) {
    color: var(--page-accent) !important;
  }

  :global(.page-footer-container .kudos:hover) {
    color: var(--page-text);
  }

  :global(.page-footer-container .page-footer-container .kudos:hover) {
    color: var(--page-text);
  }

  [data-theme="dark"] :global(.page-footer-container .kudos:hover) {
    color: var(--page-text) !important;
  }

  [data-theme="dark"]
    :global(.page-footer-container .page-footer-container .kudos:hover) {
    color: var(--page-text) !important;
  }

  /* 페이지네이션 스타일 */
  :global(.page-footer-container .pagination-links) {
    display: grid !important;
    grid-template-columns: 1fr 1fr !important;
    gap: var(--page-space-4) !important;
    margin: var(--page-space-6) 0 !important;
  }

  /* 링크가 하나일 때 한 열로 표시 */
  :global(.page-footer-container .pagination-links:has(a:only-child)) {
    grid-template-columns: 1fr !important;
  }

  :global(.page-footer-container .pagination-links a) {
    background: var(--page-bg) !important;
    border: 1px solid var(--page-border) !important;
    border-radius: var(--page-radius) !important;
    padding: var(--page-space-4) !important;
    text-decoration: none !important;
    transition: all 0.2s ease !important;
    display: flex !important;
    gap: var(--page-space-1) !important;
    color: var(--page-text) !important;
  }

  :global(.page-footer-container .pagination-links a:hover) {
    background: var(--page-accent-light) !important;
    transform: translateY(-1px) !important;
  }

  [data-theme="dark"] :global(.page-footer-container .pagination-links a) {
    background: var(--page-bg) !important;
    border-color: var(--page-border) !important;
    color: var(--page-text) !important;
  }

  [data-theme="dark"]
    :global(.page-footer-container .pagination-links a:hover) {
    background: var(--page-accent-light) !important;
    color: var(--page-accent) !important;
  }

  /* 페이지네이션 제목과 설명 스타일 */
  :global(.page-footer-container .pagination-links .link-title) {
    font-weight: 600 !important;
    color: var(--page-text) !important;
    font-size: 1.5rem !important;
  }

  :global(.page-footer-container .pagination-links .description) {
    color: var(--page-text-secondary) !important;
    font-size: 0.8125rem !important;
  }

  :global(
      .page-footer-container
        .page-footer-container
        .pagination-links
        .description
    ) {
    color: var(--page-text-secondary) !important;
    font-size: 0.8125rem !important;
  }

  :global(.page-footer-container .pagination-links a:hover .title) {
    color: var(--page-accent) !important;
  }

  :global(
      .page-footer-container
        .page-footer-container
        .pagination-links
        a:hover
        .title
    ) {
    color: var(--page-accent) !important;
  }

  :global(.page-footer-container .pagination-links a:hover .description) {
    color: var(--page-text) !important;
  }

  :global(
      .page-footer-container
        .page-footer-container
        .pagination-links
        a:hover
        .description
    ) {
    color: var(--page-text) !important;
  }

  /* 다크모드 페이지네이션 스타일 */
  [data-theme="dark"] :global(.page-footer-container .pagination-links .title) {
    color: var(--page-text) !important;
  }

  [data-theme="dark"]
    :global(.page-footer-container .pagination-links .description) {
    color: var(--page-text-secondary) !important;
  }

  [data-theme="dark"]
    :global(.page-footer-container .pagination-links a:hover .title) {
    color: var(--page-accent) !important;
  }

  [data-theme="dark"]
    :global(.page-footer-container .pagination-links a:hover .description) {
    color: var(--page-text) !important;
  }

  /* 편집 링크 스타일 */
  :global(.page-footer-container .edit-page) {
    background: var(--page-accent-light) !important;
    color: var(--page-accent) !important;
    border: 1px solid var(--page-border) !important;
    border-radius: var(--page-radius) !important;
    padding: var(--page-space-2) var(--page-space-4) !important;
    text-decoration: none !important;
    font-weight: 500 !important;
    transition: all 0.2s ease !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: var(--page-space-1) !important;
  }

  :global(.page-footer-container .edit-page:hover) {
    background: var(--page-accent) !important;
    color: var(--page-bg) !important;
    transform: translateY(-1px) !important;
  }

  [data-theme="dark"] :global(.page-footer-container .edit-page) {
    background: var(--page-accent-light) !important;
    color: var(--page-accent) !important;
    border-color: var(--page-border) !important;
  }

  [data-theme="dark"] :global(.page-footer-container .edit-page:hover) {
    background: var(--page-accent) !important;
    color: var(--page-bg) !important;
  }

  [data-theme="dark"] :global(.page-footer-container .last-updated) {
    background: var(--page-bg-secondary) !important;
    color: var(--page-text-muted) !important;
    border-color: var(--page-border) !important;
  }

  /* 최종 업데이트 정보 스타일 */
  :global(.page-footer-container .last-updated) {
    color: var(--page-text-muted) !important;
    font-size: 0.8125rem !important;
    margin: var(--page-space-4) 0 !important;
    padding: var(--page-space-2) !important;
    background: var(--page-bg-secondary) !important;
    border-radius: var(--page-radius) !important;
    border: 1px solid var(--page-border) !important;
  }

  /* 다크모드 래퍼 스타일 */
  [data-theme="dark"] .page-footer-wrapper {
    background: var(--page-bg) !important;
  }

  [data-theme="dark"] .page-footer-padding {
    background: var(--page-bg) !important;
  }

  /* 모바일 반응형 */
  @media (max-width: 768px) {
    .page-footer-container {
      padding: var(--page-space-6) var(--page-space-4);
    }

    :global(.page-footer-container .pagination-links) {
      grid-template-columns: 1fr !important;
      gap: var(--page-space-2) !important;
    }
  }
</style>
