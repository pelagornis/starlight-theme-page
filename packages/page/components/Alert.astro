---
// Alert.astro
export interface Props {
  type?: "info" | "success" | "warning" | "error";
  title?: string;
}

const { type = "info", title } = Astro.props;
---

<div class={`page-alert page-alert-${type}`}>
  <div class="page-alert-content">
    {title && <div class="page-alert-title">{title}</div>}
    <div class="page-alert-body">
      <slot />
    </div>
  </div>
</div>

<style>
  .page-alert {
    padding: 16px;
    border-radius: 8px;
    margin: 1rem 0;
    background: var(--page-bg-secondary);
    border: 1px solid var(--page-border);
  }

  .page-alert-content {
    width: 100%;
  }

  .page-alert-title {
    font-weight: 600;
    font-size: 18px;
    margin-bottom: 4px;
    color: var(--page-text);
  }

  .page-alert-body {
    font-size: 14px;
    line-height: 1.5;
    color: var(--page-text-secondary);
  }

  /* Info Alert */
  .page-alert-info {
    background: var(--blue50);
    border-color: var(--blue200);
  }

  .page-alert-info .page-alert-title {
    color: var(--blue700);
  }

  :global([data-theme="dark"]) .page-alert-info {
    background: var(--blue950) !important;
    border-color: var(--blue800) !important;
  }

  :global([data-theme="dark"]) .page-alert-info .page-alert-title {
    color: var(--blue300) !important;
  }

  :global([data-theme="dark"]) .page-alert-info .page-alert-body {
    color: var(--page-text-secondary) !important;
  }

  /* Success Alert */
  .page-alert-success {
    background: var(--green50);
    border-color: var(--green200);
  }

  .page-alert-success .page-alert-title {
    color: var(--green700);
  }

  :global([data-theme="dark"]) .page-alert-success {
    background: var(--green950) !important;
    border-color: var(--green800) !important;
  }

  :global([data-theme="dark"]) .page-alert-success .page-alert-title {
    color: var(--green300) !important;
  }

  :global([data-theme="dark"]) .page-alert-success .page-alert-body {
    color: var(--page-text-secondary) !important;
  }

  /* Warning Alert */
  .page-alert-warning {
    background: var(--orange50);
    border-color: var(--orange200);
  }

  .page-alert-warning .page-alert-title {
    color: var(--orange700);
  }

  :global([data-theme="dark"]) .page-alert-warning {
    background: var(--orange950) !important;
    border-color: var(--orange800) !important;
  }

  :global([data-theme="dark"]) .page-alert-warning .page-alert-title {
    color: var(--orange300) !important;
  }

  :global([data-theme="dark"]) .page-alert-warning .page-alert-body {
    color: var(--page-text-secondary) !important;
  }

  /* Error Alert */
  .page-alert-error {
    background: var(--red50);
    border-color: var(--red200);
  }

  .page-alert-error .page-alert-title {
    color: var(--red700);
  }

  :global([data-theme="dark"]) .page-alert-error {
    background: var(--red950) !important;
    border-color: var(--red800) !important;
  }

  :global([data-theme="dark"]) .page-alert-error .page-alert-title {
    color: var(--red300) !important;
  }

  :global([data-theme="dark"]) .page-alert-error .page-alert-body {
    color: var(--page-text-secondary) !important;
  }

  /* 반응형 */
  @media (max-width: 768px) {
    .page-alert {
      padding: 12px;
    }

    .page-alert-title {
      font-size: 13px;
    }

    .page-alert-body {
      font-size: 13px;
    }
  }
</style>
