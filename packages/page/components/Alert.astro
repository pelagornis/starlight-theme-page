---
// Alert.astro
export interface Props {
  type?: "info" | "success" | "warning" | "error";
  title?: string;
}

const { type = "info", title } = Astro.props;
---

<div class={`page-alert page-alert-${type}`}>
  <div class="page-alert-content">
    {title && <div class="page-alert-title">{title}</div>}
    <div class="page-alert-body">
      <slot />
    </div>
  </div>
</div>

<style>
  .page-alert {
    padding: 16px;
    border-radius: 8px;
    margin: 1rem 0;
    background: var(--page-bg-secondary);
    border: 1px solid var(--page-border);
  }

  .page-alert-content {
    width: 100%;
  }

  .page-alert-title {
    font-weight: 600;
    font-size: 18px;
    margin-bottom: 4px;
    color: var(--page-text);
  }

  .page-alert-body {
    font-size: 14px;
    line-height: 1.5;
    color: var(--page-text-secondary);
  }

  /* Info Alert */
  .page-alert-info {
    background: var(--blue-50);
    border-color: var(--blue-200);
  }

  .page-alert-info .page-alert-title {
    color: var(--blue-700);
  }

  :global([data-theme="dark"]) .page-alert-info {
    background: var(--blue-950);
    border-color: var(--blue-800);
  }

  :global([data-theme="dark"]) .page-alert-info .page-alert-title {
    color: var(--blue-300);
  }

  :global([data-theme="dark"]) .page-alert-info .page-alert-body {
    color: var(--page-text-secondary);
  }

  /* Success Alert */
  .page-alert-success {
    background: var(--green-50);
    border-color: var(--green-200);
  }

  .page-alert-success .page-alert-title {
    color: var(--green-700);
  }

  :global([data-theme="dark"]) .page-alert-success {
    background: var(--green-950);
    border-color: var(--green-800);
  }

  :global([data-theme="dark"]) .page-alert-success .page-alert-title {
    color: var(--green-300);
  }

  :global([data-theme="dark"]) .page-alert-success .page-alert-body {
    color: var(--page-text-secondary);
  }

  /* Warning Alert */
  .page-alert-warning {
    background: var(--orange-50);
    border-color: var(--orange-200);
  }

  .page-alert-warning .page-alert-title {
    color: var(--orange-700);
  }

  :global([data-theme="dark"]) .page-alert-warning {
    background: var(--orange-950);
    border-color: var(--orange-800);
  }

  :global([data-theme="dark"]) .page-alert-warning .page-alert-title {
    color: var(--orange-300);
  }

  :global([data-theme="dark"]) .page-alert-warning .page-alert-body {
    color: var(--page-text-secondary);
  }

  /* Error Alert */
  .page-alert-error {
    background: var(--red-50);
    border-color: var(--red-200);
  }

  .page-alert-error .page-alert-title {
    color: var(--red-700);
  }

  :global([data-theme="dark"]) .page-alert-error {
    background: var(--red-950);
    border-color: var(--red-800);
  }

  :global([data-theme="dark"]) .page-alert-error .page-alert-title {
    color: var(--red-300);
  }

  :global([data-theme="dark"]) .page-alert-error .page-alert-body {
    color: var(--page-text-secondary);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .page-alert {
      padding: 12px;
    }

    .page-alert-title {
      font-size: 13px;
    }

    .page-alert-body {
      font-size: 13px;
    }
  }
</style>
