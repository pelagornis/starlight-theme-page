---
// Card.astro
export interface Props {
  variant?: "default" | "elevated" | "outlined" | "gradient";
  padding?: "sm" | "md" | "lg";
  icon?: string;
  title?: string;
  subtitle?: string;
  href?: string;
  target?: string;
}

const {
  variant = "default",
  padding = "md",
  icon,
  title,
  subtitle,
  href,
  target,
} = Astro.props;

const Tag = href ? "a" : "div";
const attrs = href ? { href, target } : {};
---

<Tag class={`page-card page-card-${variant} page-card-${padding}`} {...attrs}>
  {
    (icon || title) && (
      <div class="page-card-header">
        {icon && <div class="page-card-icon">{icon}</div>}
        {(title || subtitle) && (
          <div class="page-card-title-group">
            {title && <div class="page-card-title">{title}</div>}
            {subtitle && <div class="page-card-subtitle">{subtitle}</div>}
          </div>
        )}
      </div>
    )
  }
  <div class="page-card-body">
    <slot />
  </div>
</Tag>

<style>
  .page-card {
    display: block;
    margin-top: 0 !important;
    background: var(--neutral-white);
    border: 1px solid var(--neutral-300);
    border-radius: 12px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }

  .page-card:hover {
    border-color: var(--neutral-400);
  }

  [data-theme="dark"] .page-card {
    background: var(--neutral-900) !important;
    border-color: var(--page-border) !important;
    color: var(--neutral-200) !important;
    box-shadow: none !important;
  }

  /* Stronger dark mode selector */
  :global([data-theme="dark"]) .page-card {
    background: var(--neutral-900) !important;
    border-color: var(--page-border) !important;
    color: var(--neutral-200) !important;
    box-shadow: none !important;
  }

  [data-theme="dark"] .page-card:hover {
    border-color: var(--page-neutral-850) !important;
    box-shadow: none !important;
  }

  /* Stronger dark mode hover selector */
  :global([data-theme="dark"]) .page-card:hover {
    border-color: var(--page-neutral-850) !important;
    box-shadow: none !important;
  }

  /* Variants */

  .page-card-outlined {
    background: transparent;
    border-width: 2px;
    backdrop-filter: none;
  }

  .page-card-outlined::before {
    display: none;
  }

  [data-theme="dark"] .page-card-outlined {
    background: transparent;
  }

  /* Padding */
  .page-card-sm {
    padding: 16px;
  }

  .page-card-md {
    padding: 24px;
  }

  .page-card-lg {
    padding: 32px;
  }

  /* Header */
  .page-card-header {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 16px;
  }

  .page-card-icon {
    font-size: 28px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: #f8f9fa;
    border-radius: 12px;
    border: 1px solid #e9ecef;
  }

  [data-theme="dark"] .page-card-icon {
    background: linear-gradient(
      135deg,
      rgba(96, 165, 250, 0.1) 0%,
      rgba(96, 165, 250, 0.05) 100%
    );
    border-color: rgba(96, 165, 250, 0.2);
  }

  .page-card-gradient .page-card-icon {
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.2) 0%,
      rgba(255, 255, 255, 0.1) 100%
    );
    border-color: rgba(255, 255, 255, 0.3);
  }

  .page-card-title-group {
    flex: 1;
    min-width: 0;
  }

  .page-card-title {
    font-weight: 700;
    font-size: 18px;
    color: #1e293b;
    margin-bottom: 4px;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  [data-theme="dark"] .page-card-title {
    color: #f1f5f9 !important;
  }

  /* Stronger dark mode title selector */
  :global([data-theme="dark"]) .page-card-title {
    color: #f1f5f9 !important;
  }

  /* Additional dark mode title selector */
  :global([data-theme="dark"]) .page-card .page-card-title {
    color: #f1f5f9 !important;
  }

  .page-card-gradient .page-card-title {
    color: white;
  }

  .page-card-subtitle {
    font-size: 14px;
    color: #64748b;
    line-height: 1.5;
    font-weight: 500;
  }

  [data-theme="dark"] .page-card-subtitle {
    color: #94a3b8 !important;
  }

  /* Stronger dark mode subtitle selector */
  :global([data-theme="dark"]) .page-card-subtitle {
    color: #94a3b8 !important;
  }

  /* Additional dark mode subtitle selector */
  :global([data-theme="dark"]) .page-card .page-card-subtitle {
    color: #94a3b8 !important;
  }

  .page-card-gradient .page-card-subtitle {
    color: rgba(255, 255, 255, 0.8);
  }

  /* Body */
  .page-card-body {
    color: #475569;
    line-height: 1.7;
    font-size: 15px;
  }

  [data-theme="dark"] .page-card-body {
    color: #cbd5e1 !important;
  }

  /* Stronger dark mode body selector */
  :global([data-theme="dark"]) .page-card-body {
    color: #cbd5e1 !important;
  }

  /* Additional dark mode body selector */
  :global([data-theme="dark"]) .page-card .page-card-body {
    color: #cbd5e1 !important;
  }

  .page-card-gradient .page-card-body {
    color: rgba(255, 255, 255, 0.9);
  }

  /* Link styles */
  .page-card[href] {
    cursor: pointer;
    text-decoration: none !important;
    color: inherit !important;
    margin-top: 1rem !important;
  }

  .page-card[href]:hover {
    border-color: var(--blue-500);
    text-decoration: none !important;
    color: inherit !important;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
  }

  .page-card[href]:hover::after {
    width: 0 !important;
  }

  [data-theme="dark"] .page-card[href] {
    background: var(--neutral-850) !important;
    border-color: var(--page-border) !important;
    color: var(--neutral-200) !important;
    box-shadow: none !important;
  }

  [data-theme="dark"] .page-card[href]:hover {
    border-color: var(--page-neutral-850) !important;
    box-shadow: none !important;
  }

  /* Stronger dark mode link card selector */
  :global([data-theme="dark"]) .page-card[href] {
    background: var(--neutral-850) !important;
    border-color: var(--page-border) !important;
    color: var(--neutral-200) !important;
    box-shadow: none !important;
  }

  :global([data-theme="dark"]) .page-card[href]:hover {
    border-color: var(--page-neutral-850) !important;
    box-shadow: none !important;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .page-card-sm {
      padding: 14px;
    }

    .page-card-md {
      padding: 20px;
    }

    .page-card-lg {
      padding: 28px;
    }

    .page-card-icon {
      font-size: 24px;
      width: 40px;
      height: 40px;
    }

    .page-card-title {
      font-size: 16px;
    }

    .page-card-subtitle {
      font-size: 13px;
    }

    .page-card-body {
      font-size: 14px;
    }
  }

  /* Animation */
  @keyframes cardFadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .page-card {
    animation: cardFadeIn 0.6s ease-out;
  }
</style>
