---
// PackageManagerTabs.astro
import Tabs from "./Tabs.astro";

export interface Props {
  packageName?: string;
  npmCommand?: string;
  pnpmCommand?: string;
  yarnCommand?: string;
  id?: string;
}

const {
  packageName = "@pelagornis/page",
  npmCommand = `npm install ${packageName}`,
  pnpmCommand = `pnpm add ${packageName}`,
  yarnCommand = `yarn add ${packageName}`,
  id = `package-tabs-${Math.random().toString(36).substr(2, 9)}`,
} = Astro.props;

const tabs = [
  { id: "npm", label: "npm", icon: "📦" },
  { id: "pnpm", label: "pnpm", icon: "🚀" },
  { id: "yarn", label: "Yarn", icon: "🧶" },
];
---

<Tabs tabs={tabs} defaultTab="npm" id={id}>
  <div class="package-command" data-command={npmCommand} data-tab="npm">
    <pre><code>{npmCommand}</code></pre>
  </div>

  <div class="package-command" data-command={pnpmCommand} data-tab="pnpm">
    <pre><code>{pnpmCommand}</code></pre>
  </div>

  <div class="package-command" data-command={yarnCommand} data-tab="yarn">
    <pre><code>{yarnCommand}</code></pre>
  </div>
</Tabs>

<style>
  /* ===== Package command style ===== */
  .package-command {
    margin: 1rem 0;
  }

  .package-command pre {
    padding: 1.5rem;
    border-radius: var(--page-radius-lg);
    background: var(--page-bg-secondary);
    border: 1px solid var(--page-border);
    overflow-x: auto;
    position: relative;
    box-shadow: var(--page-shadow-sm);
    font-family: "SF Mono", Monaco, "Cascadia Code", "Roboto Mono", Consolas,
      "Courier New", monospace;
    font-size: 0.9em;
    line-height: 1.5;
    margin: 0;
  }

  .package-command code {
    background: transparent;
    border: none;
    color: var(--page-text);
    font-family: inherit;
    font-size: inherit;
    padding: 0;
    margin: 0;
  }

  /* Dark mode style */
  [data-theme="dark"] .package-command pre {
    background: var(--page-bg-secondary) !important;
    border-color: var(--page-border) !important;
  }

  [data-theme="dark"] .package-command code {
    color: var(--page-text) !important;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .package-command pre {
      padding: 1rem;
      font-size: 0.875em;
    }
  }
</style>
