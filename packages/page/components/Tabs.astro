---
// Tabs.astro
export interface Props {
  tabs: Array<{
    id: string;
    label: string;
    icon?: string;
  }>;
  defaultTab?: string;
  id?: string;
}

const {
  tabs,
  defaultTab = tabs[0]?.id,
  id = `tabs-${Math.random().toString(36).substr(2, 9)}`,
} = Astro.props;
---

<div class="page-tabs" data-tabs-id={id}>
  <div class="page-tabs-header">
    {
      tabs.map((tab) => (
        <button
          class={`page-tab-button ${tab.id === defaultTab ? "active" : ""}`}
          data-tab={tab.id}
          data-tabs-id={id}
        >
          {tab.icon && <span class="tab-icon">{tab.icon}</span>}
          <span class="tab-label">{tab.label}</span>
        </button>
      ))
    }
  </div>

  <div class="page-tabs-content">
    <div class="page-tab-panels">
      <slot />
    </div>
  </div>
</div>

<style>
  /* ===== Tabs style ===== */
  .page-tabs {
    margin: 2rem 0;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  .page-tabs-header {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    row-gap: 8px;
    margin-bottom: 20px;
    padding: 4px;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
    background: var(--page-bg-secondary);
    border-radius: 12px;
    border: 1px solid var(--page-border);
  }

  /* Tab button */
  .page-tab-button {
    flex: 1 1 0;
    min-width: 0;
    margin-top: 0 !important;
    padding: 12px 16px;
    background: transparent;
    border: none;
    color: var(--page-text-secondary);
    font-weight: 500;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s ease;
    border-radius: 8px;
    white-space: normal;
    display: flex;
    align-items: center;
    gap: 8px;
    justify-content: center;
    position: relative;
    text-align: center;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .page-tab-button:hover {
    color: var(--page-text);
    background: var(--page-bg);
  }

  .page-tab-button.active {
    color: var(--page-text);
    background: var(--page-bg);
    font-weight: 600;
    box-shadow: var(--page-shadow-sm);
  }

  /* Dark mode style */
  [data-theme="dark"] .page-tabs-header {
    background: var(--page-bg-secondary);
    border-color: var(--page-border);
  }

  [data-theme="dark"] .page-tab-button {
    color: var(--page-text-secondary);
  }

  [data-theme="dark"] .page-tab-button:hover {
    color: var(--page-text);
    background: var(--page-bg-elevated);
  }

  [data-theme="dark"] .page-tab-button.active {
    color: var(--page-text);
    background: var(--page-bg-elevated);
    box-shadow: var(--page-shadow-md);
  }

  /* Tab icon */
  .tab-icon {
    font-size: 16px;
    width: 16px;
    height: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tab-label {
    font-size: 14px;
    font-weight: inherit;
    min-width: 0;
    line-height: 1.35;
  }

  /* Tab content */
  .page-tabs-content {
    position: relative;
  }

  .page-tab-panels {
    position: relative;
  }

  .page-tab-panels > * {
    display: none;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .page-tab-button {
      flex: 1 1 100%;
      min-width: 0;
      padding: 10px 12px;
      font-size: 13px;
    }

    .tab-icon {
      font-size: 14px;
      width: 14px;
      height: 14px;
      flex-shrink: 0;
    }
  }

  /* Focus style */
  .page-tab-button:focus-visible {
    outline: 2px solid var(--page-accent);
    outline-offset: 2px;
  }
</style>

<script>
  // Tab switch
  document.addEventListener("DOMContentLoaded", function () {
    const tabContainers = document.querySelectorAll(".page-tabs");

    tabContainers.forEach((container) => {
      const tabsId = container.getAttribute("data-tabs-id");
      const tabButtons = container.querySelectorAll(
        `[data-tabs-id="${tabsId}"]`
      );
      const tabPanels = container.querySelectorAll(".page-tab-panels > *");

      // Init: hide all tab panels
      tabPanels.forEach((panel) => {
        (panel as HTMLElement).style.display = "none";
        (panel as HTMLElement).style.opacity = "0";
      });

      // Activate first tab only
      if (tabButtons.length > 0 && tabPanels.length > 0) {
        tabButtons[0].classList.add("active");
        (tabPanels[0] as HTMLElement).style.display = "block";
        (tabPanels[0] as HTMLElement).style.opacity = "1";
      }

      tabButtons.forEach((button, index) => {
        button.addEventListener("click", () => {
          // Deactivate all tab buttons in this container
          tabButtons.forEach((btn) => btn.classList.remove("active"));
          // Hide all tab panels in this container
          tabPanels.forEach((panel) => {
            (panel as HTMLElement).style.display = "none";
            (panel as HTMLElement).style.opacity = "0";
          });

          // Activate selected tab
          button.classList.add("active");
          if (tabPanels[index]) {
            (tabPanels[index] as HTMLElement).style.display = "block";
            (tabPanels[index] as HTMLElement).style.opacity = "1";
          }
        });
      });
    });
  });
</script>
