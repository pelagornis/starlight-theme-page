---
// Badge.astro
export interface Props {
  variant?: "default" | "primary" | "success" | "warning" | "error";
  size?: "sm" | "md" | "lg";
  icon?: string;
}

const { variant = "default", size = "md", icon } = Astro.props;
---

<span class={`page-badge page-badge-${variant} page-badge-${size}`}>
  {icon && <span class="page-badge-icon">{icon}</span>}
  <span class="page-badge-text">
    <slot />
  </span>
</span>

<style>
  .page-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 12px;
    line-height: 1;
    white-space: nowrap;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    backdrop-filter: blur(10px);
    border: 1px solid;
    position: relative;
    overflow: hidden;
  }

  /* 전역 스타일로 강제 적용 */
  :global(.page-badge p) {
    margin: 0 !important;
    padding: 0 !important;
  }

  .page-badge::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: 10px;
    pointer-events: none;
  }

  .page-badge:hover {
    transform: translateY(-1px) scale(1.05);
    box-shadow:
      0 4px 12px -2px rgba(0, 0, 0, 0.15),
      0 0 0 1px rgba(59, 130, 246, 0.1);
  }

  .page-badge-icon {
    font-size: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }

  .page-badge:hover .page-badge-icon {
    transform: scale(1.1);
  }

  .page-badge-text {
    color: inherit;
    font-weight: inherit;
  }

  /* Variants */
  .page-badge-default {
    background: var(--neutral100);
    border-color: var(--neutral300);
    color: var(--neutral600);
  }

  [data-theme="dark"] .page-badge-default {
    background: var(--neutral800);
    border-color: var(--neutral600);
    color: var(--neutral200);
  }

  .page-badge-primary {
    background: var(--blue100);
    border-color: var(--blue300);
    color: var(--blue700);
  }

  [data-theme="dark"] .page-badge-primary {
    background: var(--blue900);
    border-color: var(--blue700);
    color: var(--blue200);
  }

  .page-badge-success {
    background: var(--green100);
    border-color: var(--green300);
    color: var(--green700);
  }

  [data-theme="dark"] .page-badge-success {
    background: var(--green900);
    border-color: var(--green700);
    color: var(--green200);
  }

  .page-badge-warning {
    background: var(--orange100);
    border-color: var(--orange300);
    color: var(--orange700);
  }

  [data-theme="dark"] .page-badge-warning {
    background: var(--orange900);
    border-color: var(--orange700);
    color: var(--orange200);
  }

  .page-badge-error {
    background: var(--red100);
    border-color: var(--red300);
    color: var(--red700);
  }

  [data-theme="dark"] .page-badge-error {
    background: var(--red900);
    border-color: var(--red700);
    color: var(--red200);
  }

  /* Sizes */
  .page-badge-sm {
    padding: 4px 8px;
    font-size: 11px;
    border-radius: 8px;
    gap: 4px;
  }

  .page-badge-sm .page-badge-icon {
    font-size: 11px;
  }

  .page-badge-md {
    padding: 6px 12px;
    font-size: 12px;
    border-radius: 10px;
    gap: 6px;
  }

  .page-badge-md .page-badge-icon {
    font-size: 12px;
  }

  .page-badge-lg {
    padding: 8px 16px;
    font-size: 14px;
    border-radius: 12px;
    gap: 8px;
  }

  .page-badge-lg .page-badge-icon {
    font-size: 14px;
  }

  /* 반응형 */
  @media (max-width: 768px) {
    .page-badge {
      padding: 5px 10px;
      font-size: 11px;
    }

    .page-badge-lg {
      padding: 7px 14px;
      font-size: 13px;
    }
  }

  /* 애니메이션 */
  @keyframes badgePulse {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.05);
    }
    100% {
      transform: scale(1);
    }
  }

  .page-badge:hover {
    animation: badgePulse 0.3s ease-in-out;
  }

  /* 포커스 스타일 */
  .page-badge:focus-visible {
    outline: 2px solid rgba(59, 130, 246, 0.5);
    outline-offset: 2px;
  }

  [data-theme="dark"] .page-badge:focus-visible {
    outline-color: rgba(96, 165, 250, 0.5);
  }
</style>
