---
// Badge.astro
export interface Props {
  variant?: "default" | "primary" | "success" | "warning" | "error";
  size?: "sm" | "md" | "lg";
}

const { variant = "default", size = "md" } = Astro.props;
---

<span class={`page-badge page-badge-${variant} page-badge-${size}`}>
  <span class="page-badge-text">
    <slot />
  </span>
</span>

<style>
  .page-badge {
    display: inline-flex;
    align-items: center;
    padding: 6px 12px;
    border-radius: 6px;
    font-weight: 500;
    font-size: 12px;
    line-height: 1;
    white-space: nowrap;
    border: 1px solid;
  }

  /* 전역 스타일로 강제 적용 */
  :global(.page-badge p) {
    margin: 0 !important;
    padding: 0 !important;
  }

  .page-badge-text {
    color: inherit;
    font-weight: inherit;
  }

  /* Variants */
  .page-badge-default {
    background: var(--neutral100);
    border-color: var(--neutral300);
    color: var(--neutral600);
  }

  :global([data-theme="dark"]) .page-badge-default {
    background: var(--neutral800) !important;
    border-color: var(--neutral600) !important;
    color: var(--neutral200) !important;
  }

  .page-badge-primary {
    background: var(--blue100);
    border-color: var(--blue300);
    color: var(--blue700);
  }

  :global([data-theme="dark"]) .page-badge-primary {
    background: var(--blue900) !important;
    border-color: var(--blue700) !important;
    color: var(--blue200) !important;
  }

  .page-badge-success {
    background: var(--green100);
    border-color: var(--green300);
    color: var(--green700);
  }

  :global([data-theme="dark"]) .page-badge-success {
    background: var(--green900) !important;
    border-color: var(--green700) !important;
    color: var(--green200) !important;
  }

  .page-badge-warning {
    background: var(--orange100);
    border-color: var(--orange300);
    color: var(--orange700);
  }

  :global([data-theme="dark"]) .page-badge-warning {
    background: var(--orange900) !important;
    border-color: var(--orange700) !important;
    color: var(--orange200) !important;
  }

  .page-badge-error {
    background: var(--red100);
    border-color: var(--red300);
    color: var(--red700);
  }

  :global([data-theme="dark"]) .page-badge-error {
    background: var(--red900) !important;
    border-color: var(--red700) !important;
    color: var(--red200) !important;
  }

  /* Sizes */
  .page-badge-sm {
    padding: 4px 8px;
    font-size: 11px;
    border-radius: 4px;
  }

  .page-badge-md {
    padding: 6px 12px;
    font-size: 12px;
    border-radius: 6px;
  }

  .page-badge-lg {
    padding: 8px 16px;
    font-size: 14px;
    border-radius: 8px;
  }

  /* 반응형 */
  @media (max-width: 768px) {
    .page-badge {
      padding: 5px 10px;
      font-size: 11px;
    }

    .page-badge-lg {
      padding: 7px 14px;
      font-size: 13px;
    }
  }

  /* 포커스 스타일 */
  .page-badge:focus-visible {
    outline: 2px solid var(--page-accent);
    outline-offset: 2px;
  }
</style>
