---
// Badge.astro
export interface Props {
  variant?: "default" | "primary" | "success" | "warning" | "error";
  size?: "sm" | "md" | "lg";
}

const { variant = "default", size = "md" } = Astro.props;
---

<span class={`page-badge page-badge-${variant} page-badge-${size}`}>
  <span class="page-badge-text">
    <slot />
  </span>
</span>

<style>
  .page-badge {
    display: inline-flex;
    align-items: center;
    padding: 6px 12px;
    border-radius: 6px;
    font-weight: 500;
    font-size: 12px;
    line-height: 1;
    white-space: nowrap;
    border: 1px solid;
  }

  /* 전역 스타일로 강제 적용 */
  :global(.page-badge p) {
    margin: 0 !important;
    padding: 0 !important;
  }

  .page-badge-text {
    color: inherit;
    font-weight: inherit;
  }

  /* Variants */
  .page-badge-default {
    background: var(--neutral-100);
    border-color: var(--neutral-300);
    color: var(--neutral-600);
  }

  :global([data-theme="dark"]) .page-badge-default {
    background: var(--neutral-800) !important;
    border-color: var(--neutral-600) !important;
    color: var(--neutral-200) !important;
  }

  .page-badge-primary {
    background: var(--blue-100);
    border-color: var(--blue-300);
    color: var(--blue-700);
  }

  :global([data-theme="dark"]) .page-badge-primary {
    background: var(--blue-900) !important;
    border-color: var(--blue-700) !important;
    color: var(--blue-200) !important;
  }

  .page-badge-success {
    background: var(--green-100);
    border-color: var(--green-300);
    color: var(--green-700);
  }

  :global([data-theme="dark"]) .page-badge-success {
    background: var(--green-900) !important;
    border-color: var(--green-700) !important;
    color: var(--green-200) !important;
  }

  .page-badge-warning {
    background: var(--orange-100);
    border-color: var(--orange-300);
    color: var(--orange-700);
  }

  :global([data-theme="dark"]) .page-badge-warning {
    background: var(--orange-900) !important;
    border-color: var(--orange-700) !important;
    color: var(--orange-200) !important;
  }

  .page-badge-error {
    background: var(--red-100);
    border-color: var(--red-300);
    color: var(--red-700);
  }

  :global([data-theme="dark"]) .page-badge-error {
    background: var(--red-900) !important;
    border-color: var(--red-700) !important;
    color: var(--red-200) !important;
  }

  /* Sizes */
  .page-badge-sm {
    padding: 4px 8px;
    font-size: 11px;
    border-radius: 4px;
  }

  .page-badge-md {
    padding: 6px 12px;
    font-size: 12px;
    border-radius: 6px;
  }

  .page-badge-lg {
    padding: 8px 16px;
    font-size: 14px;
    border-radius: 8px;
  }

  /* 반응형 */
  @media (max-width: 768px) {
    .page-badge {
      padding: 5px 10px;
      font-size: 11px;
    }

    .page-badge-lg {
      padding: 7px 14px;
      font-size: 13px;
    }
  }

  /* 포커스 스타일 */
  .page-badge:focus-visible {
    outline: 2px solid var(--page-accent);
    outline-offset: 2px;
  }
</style>
