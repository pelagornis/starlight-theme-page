---
import * as pkg from "@refineui/web-icons";
import { ICON_NAME_MAPPING } from "../lib/icon-names";
const createIconHTML = (
  pkg as {
    createIconHTML?: (
      name: string,
      style: "regular" | "filled",
    ) => (size?: number, color?: string, className?: string) => string;
  }
).createIconHTML;
const closeIcon =
  typeof createIconHTML === "function"
    ? createIconHTML(ICON_NAME_MAPPING.dismiss ?? "Dismiss", "regular")
    : () => "";
const arrowRightIcon =
  typeof createIconHTML === "function"
    ? createIconHTML(ICON_NAME_MAPPING.next ?? "Next", "regular")
    : () => "";
interface Props {
  basePath?: string;
  provider?: "openai" | "claude" | "gemini";
  model?: string;
  locale?: string;
}
const {
  basePath = "",
  provider: providerProp,
  model,
  locale: localeProp = "en",
} = Astro.props;
const provider = providerProp ?? "openai";
const apiChatBase = (basePath ? basePath.replace(/\/$/, "") : "") + "/api/chat";

const chatStrings: Record<
  string,
  {
    empty: string;
    placeholder: string;
    title: string;
    close: string;
    send: string;
    you: string;
    assistant: string;
    disclaimer: string;
  }
> = {
  en: {
    empty: "Ask about the documentation.",
    placeholder: "Ask a question...",
    title: "Doc chat",
    close: "Close chat",
    send: "Send",
    you: "You",
    assistant: "Assistant",
    disclaimer: "Answers are generated using AI and may contain errors.",
  },
  ko: {
    empty: "문서에 대해 질문하세요.",
    placeholder: "질문해 보세요...",
    title: "문서 채팅",
    close: "채팅 닫기",
    send: "보내기",
    you: "나",
    assistant: "어시스턴트",
    disclaimer:
      "답변은 인공지능을 사용하여 생성되었으며 오류가 포함될 수 있습니다.",
  },
  ja: {
    empty: "ドキュメントについて質問してください。",
    placeholder: "質問を入力...",
    title: "ドキュメントチャット",
    close: "チャットを閉じる",
    send: "送信",
    you: "あなた",
    assistant: "アシスタント",
    disclaimer: "回答はAIにより生成され、誤りが含まれる場合があります。",
  },
  zh: {
    empty: "询问文档相关内容。",
    placeholder: "输入您的问题...",
    title: "文档对话",
    close: "关闭对话",
    send: "发送",
    you: "我",
    assistant: "助手",
    disclaimer: "回答由AI生成，可能包含错误。",
  },
};
const localeKey = localeProp === "root" ? "en" : localeProp;
const t = chatStrings[localeKey] ?? chatStrings.en;
---

<div class="page-chat-wrapper">
  <div class="page-chat-backdrop" id="page-chat-backdrop" aria-hidden="true">
  </div>
  <aside
    class="page-chat-pane"
    id="page-chat-pane"
    aria-label={t.title}
    aria-hidden="true"
  >
    <div
      class="page-chat-pane-resize"
      id="page-chat-pane-resize"
      role="separator"
      aria-label="Resize chat panel"
    >
    </div>
    <div class="page-chat-pane-inner">
      <header class="page-chat-pane-header">
        <span class="page-chat-pane-title">{t.title}</span>
        <button
          type="button"
          class="page-chat-pane-close"
          id="page-chat-pane-close"
          aria-label={t.close}
        >
          <Fragment set:html={closeIcon(20, "currentColor", "refineui-icon")} />
        </button>
      </header>
      <p class="page-chat-pane-disclaimer">{t.disclaimer}</p>
      <div class="page-chat-pane-messages" id="page-chat-pane-messages">
        <p class="page-chat-pane-empty" id="page-chat-pane-empty">{t.empty}</p>
      </div>
      <form
        class="page-chat-pane-form"
        id="page-chat-pane-form"
        method="post"
        data-api-chat-base={apiChatBase}
        data-provider={provider}
        data-model={model ?? ""}
        data-chat-label-you={t.you}
        data-chat-label-assistant={t.assistant}
      >
        <div class="page-chat-pane-input-bar">
          <input
            class="page-chat-pane-input"
            id="page-chat-pane-input"
            type="text"
            placeholder={t.placeholder}
            autocomplete="off"
            disabled={!provider}
          />
          <button
            type="submit"
            class="page-chat-pane-send"
            id="page-chat-pane-send"
            aria-label={t.send}
            disabled={!provider}
          >
            <Fragment
              set:html={arrowRightIcon(20, "currentColor", "refineui-icon")}
            />
          </button>
        </div>
      </form>
    </div>
  </aside>
</div>

<style>
  .page-chat-wrapper {
    flex: 0 0 auto;
    min-width: 0;
    width: 0;
    transition: width 0.22s ease;
  }
  body.page-chat-open .page-chat-wrapper {
    width: var(--page-chat-pane-width, 360px);
  }
  body.page-chat-open.page-chat-pane-resizing .page-chat-wrapper {
    transition: none;
  }

  @media (min-width: 1025px) {
    .page-chat-wrapper {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      width: 0;
      overflow: hidden;
      z-index: 50;
      pointer-events: none;
      display: flex;
      flex-direction: column;
    }
    body.page-chat-open .page-chat-wrapper {
      width: var(--page-chat-pane-width, 360px);
      pointer-events: auto;
    }
    .page-chat-pane {
      position: relative;
      top: 0;
      right: 0;
      bottom: 0;
      width: 100% !important;
      height: 100%;
      min-width: 0;
      overflow: hidden;
      opacity: 1;
      pointer-events: auto;
      display: flex;
      flex-direction: column;
      background: var(--page-bg);
      border-left: 1px solid var(--page-border);
      box-shadow: -2px 0 12px rgba(0, 0, 0, 0.06);
    }
    [data-theme="dark"] .page-chat-pane {
      border-left-color: var(--page-border);
      box-shadow: -2px 0 16px rgba(0, 0, 0, 0.15);
    }
    .page-chat-backdrop {
      display: none;
    }
  }

  @media (max-width: 1024px) {
    .page-chat-wrapper {
      position: fixed;
      inset: 0;
      width: auto !important;
      pointer-events: none;
      z-index: 50;
    }
    body.page-chat-open .page-chat-wrapper {
      width: auto !important;
      pointer-events: auto;
    }
    .page-chat-pane {
      position: fixed;
      right: 0;
      top: auto;
      bottom: 0;
      left: 0;
      width: 0 !important;
      min-width: 0;
      height: 0;
      max-height: 0;
      opacity: 0;
      pointer-events: none;
      display: flex;
      flex-direction: column;
      background: var(--page-bg);
      border-left: none;
      border-radius: var(--page-radius-lg) var(--page-radius-lg) 0 0;
      transition:
        height 0.28s ease,
        max-height 0.28s ease,
        box-shadow 0.28s ease;
    }
  }

  body.page-chat-pane-resizing {
    user-select: none;
    cursor: col-resize;
  }

  .page-chat-pane-resize {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 6px;
    cursor: col-resize;
    z-index: 2;
    flex-shrink: 0;
  }
  .page-chat-pane-resize:hover,
  .page-chat-pane-resize:active {
    background: var(--page-accent);
    opacity: 0.2;
  }
  .page-chat-pane-resize::after {
    content: "";
    position: absolute;
    left: 2px;
    top: 50%;
    transform: translateY(-50%);
    width: 2px;
    height: 40px;
    border-radius: 1px;
    background: var(--page-border);
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .page-chat-pane-resize:hover::after {
    opacity: 1;
  }

  @media (max-width: 1024px) {
    .page-chat-pane-resize {
      display: none;
    }
  }

  .page-chat-pane-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    width: 100%;
  }

  body.page-chat-open :global(.page-toc-sidebar),
  body.page-chat-open :global(.sl-toc:not(.sl-toc-mobile)) {
    display: none !important;
  }

  .page-chat-pane-messages {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: var(--page-space-4);
    display: flex;
    flex-direction: column;
    gap: var(--page-space-4);
    background: var(--page-bg-secondary);
  }
  [data-theme="dark"] .page-chat-pane-messages {
    background: var(--page-bg);
  }
  .page-chat-pane-empty {
    margin: auto;
    font-size: var(--page-font-size-sm);
    color: var(--page-text-secondary);
    text-align: center;
    padding: var(--page-space-8) var(--page-space-4);
    line-height: var(--page-line-height-normal);
  }

  .page-chat-pane-msg {
    padding: var(--page-space-3) var(--page-space-4);
    border-radius: var(--page-radius-lg);
    max-width: 85%;
    font-size: var(--page-font-size-sm);
    line-height: 1.5;
  }
  .page-chat-pane-msg.user {
    align-self: flex-end;
    background: var(--page-accent);
    color: var(--page-text-reverse);
  }
  .page-chat-pane-msg.assistant {
    align-self: flex-start;
    background: var(--page-bg);
    color: var(--page-text);
    border: 1px solid var(--page-border);
  }
  [data-theme="dark"] .page-chat-pane-msg.assistant {
    background: var(--page-bg-secondary);
    border-color: var(--page-border);
  }
  .page-chat-pane-msg .page-chat-pane-sources {
    margin-top: var(--page-space-2);
    padding-top: var(--page-space-2);
    border-top: 1px solid var(--page-border);
    font-size: var(--page-font-size-xs);
    color: var(--page-text-secondary);
  }
  .page-chat-pane-msg .page-chat-pane-sources a {
    color: var(--page-accent);
    text-decoration: none;
  }
  .page-chat-pane-msg .page-chat-pane-sources a:hover {
    text-decoration: underline;
  }

  /* Chat markdown styles (refined) */
  .page-chat-pane-msg-body {
    word-break: break-word;
    line-height: 1.6;
  }
  .page-chat-pane-msg-body p:first-child { margin-top: 0; }
  .page-chat-pane-msg-body p:last-child { margin-bottom: 0; }
  .page-chat-pane-msg-body p { margin: 0.5em 0; }
  .page-chat-pane-msg-body strong { font-weight: 600; }
  .page-chat-pane-msg-body em { font-style: italic; }

  .page-chat-pane-msg-body ul, .page-chat-pane-msg-body ol {
    margin: 0.5em 0;
    padding-left: 1.5em;
  }
  .page-chat-pane-msg-body ul { list-style-type: disc; }
  .page-chat-pane-msg-body ol { list-style-type: decimal; }
  .page-chat-pane-msg-body li { margin: 0.3em 0; }
  .page-chat-pane-msg-body li > ul, .page-chat-pane-msg-body li > ol {
    margin: 0.2em 0;
    padding-left: 1.25em;
  }

  .page-chat-pane-msg-body pre {
    margin: 0.65em 0;
    padding: 0.875em 1rem;
    overflow-x: auto;
    border-radius: var(--page-radius-md, 8px);
    background: var(--page-neutral-100);
    border: 1px solid var(--page-neutral-200);
    font-size: 0.8125rem;
    line-height: 1.55;
    -webkit-overflow-scrolling: touch;
  }
  [data-theme="dark"] .page-chat-pane-msg-body pre {
    background: var(--page-neutral-800);
    border-color: var(--page-neutral-700);
  }
  .page-chat-pane-msg-body pre code {
    padding: 0;
    background: none;
    font-family: ui-monospace, "SF Mono", Menlo, Monaco, Consolas, monospace;
    font-size: inherit;
  }
  .page-chat-pane-msg-body code {
    font-family: ui-monospace, "SF Mono", Menlo, Monaco, Consolas, monospace;
    font-size: 0.9em;
  }
  .page-chat-pane-msg-body :not(pre) > code {
    padding: 0.2em 0.45em;
    border-radius: 4px;
    background: var(--page-neutral-100);
    border: 1px solid var(--page-neutral-200);
    font-size: 0.875em;
  }
  [data-theme="dark"] .page-chat-pane-msg-body :not(pre) > code {
    background: var(--page-neutral-800);
    border-color: var(--page-neutral-700);
  }

  .page-chat-pane-msg-body a {
    color: var(--page-accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .page-chat-pane-msg-body a:hover {
    text-decoration: none;
    border-bottom-color: currentColor;
  }

  .page-chat-pane-msg-body blockquote {
    margin: 0.6em 0;
    padding: 0.4em 0 0.4em 1em;
    border-left: 3px solid var(--page-accent);
    color: var(--page-text-secondary);
    font-size: 0.95em;
  }
  [data-theme="dark"] .page-chat-pane-msg-body blockquote {
    border-left-color: var(--page-accent);
  }

  .page-chat-pane-msg-body h1, .page-chat-pane-msg-body h2, .page-chat-pane-msg-body h3,
  .page-chat-pane-msg-body h4, .page-chat-pane-msg-body h5, .page-chat-pane-msg-body h6 {
    margin: 0.85em 0 0.4em;
    font-weight: 600;
    line-height: 1.35;
  }
  .page-chat-pane-msg-body h1:first-child, .page-chat-pane-msg-body h2:first-child,
  .page-chat-pane-msg-body h3:first-child, .page-chat-pane-msg-body h4:first-child,
  .page-chat-pane-msg-body h5:first-child, .page-chat-pane-msg-body h6:first-child {
    margin-top: 0;
  }
  .page-chat-pane-msg-body h1 { font-size: 1.1em; }
  .page-chat-pane-msg-body h2 { font-size: 1.05em; border-bottom: 1px solid var(--page-border); padding-bottom: 0.2em; }
  .page-chat-pane-msg-body h3, .page-chat-pane-msg-body h4, .page-chat-pane-msg-body h5, .page-chat-pane-msg-body h6 { font-size: 1em; }

  .page-chat-pane-msg-body table {
    border-collapse: collapse;
    font-size: 0.9em;
    margin: 0.6em 0;
    width: 100%;
    border-radius: var(--page-radius, 6px);
    overflow: hidden;
    border: 1px solid var(--page-border);
  }
  .page-chat-pane-msg-body th, .page-chat-pane-msg-body td {
    border: 1px solid var(--page-border);
    padding: 0.4em 0.65em;
    text-align: left;
  }
  .page-chat-pane-msg-body th {
    background: var(--page-neutral-100);
    font-weight: 600;
  }
  [data-theme="dark"] .page-chat-pane-msg-body th {
    background: var(--page-neutral-800);
  }
  .page-chat-pane-msg-body tr:nth-child(even) td {
    background: var(--page-neutral-50);
  }
  [data-theme="dark"] .page-chat-pane-msg-body tr:nth-child(even) td {
    background: var(--page-neutral-900);
  }

  .page-chat-pane-msg-body hr {
    margin: 0.85em 0;
    border: none;
    border-top: 1px solid var(--page-border);
  }

  .page-chat-pane-form {
    flex-shrink: 0;
    padding: var(--page-space-4);
    background: var(--page-bg);
    border-top: 1px solid var(--page-border);
  }
  .page-chat-pane-input-bar {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0;
    width: 100%;
    min-width: 0;
    border: 1px solid var(--page-border);
    border-radius: var(--page-radius-lg);
    background: var(--page-bg);
    overflow: hidden;
  }
  .page-chat-pane-input-bar:focus-within {
    border-color: var(--page-accent);
    outline: 2px solid var(--page-accent);
    outline-offset: 2px;
  }
  [data-theme="dark"] .page-chat-pane-input-bar {
    background: var(--page-bg);
    border-color: var(--page-border);
  }
  .page-chat-pane-input {
    flex: 1 1 auto;
    min-width: 0;
    width: 0;
    padding: var(--page-space-3) var(--page-space-4);
    border: none;
    background: transparent;
    color: var(--page-text);
    font-size: var(--page-font-size-base);
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .page-chat-pane-input:focus {
    outline: none;
  }
  .page-chat-pane-input::placeholder {
    color: var(--page-text-muted);
  }

  /* Same as Search/nav: inline-flex center icon */
  .page-chat-pane-send {
    width: 44px;
    height: 44px;
    min-width: 44px;
    max-width: 44px;
    min-height: 44px;
    padding: 0;
    border: none;
    border-left: 1px solid var(--page-border);
    border-radius: 0;
    background: transparent;
    color: var(--page-accent);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    flex-grow: 0;
    position: relative;
  }
  .page-chat-pane-send :global(.refineui-icon),
  .page-chat-pane-send :global(span[class*="refineui"]) {
    font-family: "RefineUI-System-Icons-Regular", sans-serif !important;
    width: 20px !important;
    height: 20px !important;
    min-width: 20px !important;
    min-height: 20px !important;
    font-size: 20px !important;
    line-height: 20px !important;
    box-sizing: border-box !important;
    display: inline-flex !important;
    align-items: center !important;
    margin: 0 !important;
    padding: 0 !important;
  }
  .page-chat-pane-send:hover:not(:disabled) {
    background: var(--page-bg);
    color: var(--page-accent);
  }
  .page-chat-pane-send:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  [data-theme="dark"] .page-chat-pane-send {
    border-left-color: var(--page-border);
  }
  [data-theme="dark"] .page-chat-pane-send:hover:not(:disabled) {
    background: var(--page-bg-secondary);
  }

  .page-chat-pane-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    padding: var(--page-space-3) var(--page-space-5);
    background: var(--page-bg);
    border-bottom: 1px solid var(--page-border);
  }
  .page-chat-pane-title {
    font-size: var(--page-font-size-base);
    font-weight: var(--page-font-weight-semibold);
    color: var(--page-text);
  }
  /* Same as Search/nav: inline-flex + 20px icon center */
  .page-chat-pane-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    margin: 0 0 0 auto;
    border: none;
    border-radius: var(--page-radius);
    background: transparent;
    color: var(--page-text-secondary);
    cursor: pointer;
    position: relative;
  }
  .page-chat-pane-close :global(.refineui-icon),
  .page-chat-pane-close :global(span[class*="refineui"]) {
    font-family: "RefineUI-System-Icons-Regular", sans-serif !important;
    width: 20px !important;
    height: 20px !important;
    min-width: 20px !important;
    min-height: 20px !important;
    font-size: 20px !important;
    line-height: 20px !important;
    box-sizing: border-box !important;
    display: inline-flex !important;
    align-items: center !important;
    margin: 0 !important;
    padding: 0 !important;
  }
  .page-chat-pane-close:hover {
    background: var(--page-bg-secondary);
    color: var(--page-text);
  }
  .page-chat-pane-disclaimer {
    flex-shrink: 0;
    margin: 0;
    padding: var(--page-space-2) var(--page-space-5);
    font-size: var(--page-font-size-xs);
    color: var(--page-text-secondary);
    line-height: 1.4;
  }

  @media (max-width: 1024px) {
    .page-chat-pane {
      top: auto;
      left: 0;
      right: 0;
      bottom: 0;
      width: 100% !important;
      min-width: 0 !important;
      max-width: 100vw;
      height: 0;
      max-height: 0;
      border-left: none;
      border-radius: var(--page-radius-lg) var(--page-radius-lg) 0 0;
      box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.08);
      transition:
        height 0.28s ease,
        max-height 0.28s ease,
        box-shadow 0.28s ease;
      box-sizing: border-box;
    }
    body.page-chat-open .page-chat-pane {
      width: 100% !important;
      min-width: 0 !important;
      max-width: 100vw;
      height: 70vh;
      max-height: 70vh;
      opacity: 1;
      pointer-events: auto;
      box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.12);
    }
    [data-theme="dark"] body.page-chat-open .page-chat-pane {
      box-shadow: 0 -4px 28px rgba(0, 0, 0, 0.25);
    }
    .page-chat-pane-inner,
    .page-chat-pane-form,
    .page-chat-pane-messages,
    .page-chat-pane-input-bar {
      width: 100%;
      max-width: 100%;
      min-width: 0;
      box-sizing: border-box;
    }
  }
</style>

<script>
  import { renderChatMarkdown } from "../lib/chat-markdown";
  (function () {
    const form = document.getElementById("page-chat-pane-form");
    const apiChatBase = form?.dataset.apiChatBase ?? "";
    const provider = form?.dataset.provider ?? "openai";
    const model = form?.dataset.model || undefined;
    const chatLabelYou = form?.dataset.chatLabelYou ?? "You";
    const chatLabelAssistant = form?.dataset.chatLabelAssistant ?? "Assistant";

    const messagesEl = document.getElementById("page-chat-pane-messages");
    const input = document.getElementById("page-chat-pane-input");
    const sendBtn = document.getElementById("page-chat-pane-send");
    const pane = document.getElementById("page-chat-pane");
    const backdrop = document.getElementById("page-chat-backdrop");
    const closeBtn = document.getElementById("page-chat-pane-close");
    const resizeHandle = document.getElementById("page-chat-pane-resize");

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      e.stopPropagation();
      const message = input?.value?.trim();
      if (!message || !provider) return;
      addMessage("user", message);
      if (input) input.value = "";
      if (sendBtn) sendBtn.disabled = true;
      try {
        const res = await fetch(`${apiChatBase}/${provider}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            message,
            provider,
            locale: document.documentElement.lang || "en",
            model: model || undefined,
          }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Request failed");
        let bodyHtml;
        try {
          bodyHtml = renderChatMarkdown(data.answer);
        } catch (_) {
          bodyHtml = data.answer.replace(/\n/g, "<br>");
        }
        addMessage("assistant", data.answer, data.sources, bodyHtml);
      } catch (err) {
        addMessage("assistant", "Error: " + (err?.message || String(err)), []);
      } finally {
        if (sendBtn) sendBtn.disabled = false;
      }
    });

    const CHAT_PANE_MIN_WIDTH = 280;
    const CHAT_PANE_MAX_WIDTH = 600;
    const CHAT_PANE_STORAGE_KEY = "page-chat-pane-width";

    function getChatPaneWidth() {
      const v = document.body.style.getPropertyValue("--page-chat-pane-width");
      if (v && v.endsWith("px")) return parseInt(v, 10);
      return 360;
    }
    function applySavedChatWidth() {
      try {
        const saved = localStorage.getItem(CHAT_PANE_STORAGE_KEY);
        if (saved) {
          const w = Math.max(
            CHAT_PANE_MIN_WIDTH,
            Math.min(CHAT_PANE_MAX_WIDTH, parseInt(saved, 10)),
          );
          document.body.style.setProperty("--page-chat-pane-width", w + "px");
        }
      } catch (_) {}
    }

    function closeChat() {
      document.body.classList.remove("page-chat-open");
      document.body.dispatchEvent(new CustomEvent("page-chat-toggle"));
      try {
        sessionStorage.setItem("page-chat-open", "0");
      } catch (_) {}
    }

    function setAriaHidden(open) {
      if (pane) pane.setAttribute("aria-hidden", open ? "false" : "true");
      if (backdrop)
        backdrop.setAttribute("aria-hidden", open ? "false" : "true");
    }

    document.body.addEventListener("page-chat-toggle", () => {
      const open = document.body.classList.contains("page-chat-open");
      setAriaHidden(open);
      if (open) applySavedChatWidth();
    });
    setAriaHidden(document.body.classList.contains("page-chat-open"));
    if (document.body.classList.contains("page-chat-open"))
      applySavedChatWidth();

    backdrop?.addEventListener("click", closeChat);
    closeBtn?.addEventListener("click", closeChat);

    if (resizeHandle) {
      let startX = 0;
      let startWidth = 360;
      function onMove(e) {
        const dx = startX - e.clientX;
        const w = Math.round(
          Math.max(
            CHAT_PANE_MIN_WIDTH,
            Math.min(CHAT_PANE_MAX_WIDTH, startWidth + dx),
          ),
        );
        document.body.style.setProperty("--page-chat-pane-width", w + "px");
        resizeHandle.setAttribute("aria-valuenow", String(w));
      }
      function onUp() {
        document.body.classList.remove("page-chat-pane-resizing");
        const w = getChatPaneWidth();
        try {
          localStorage.setItem(CHAT_PANE_STORAGE_KEY, String(w));
        } catch (_) {}
        document.removeEventListener("pointermove", onMove);
        document.removeEventListener("pointerup", onUp);
        document.removeEventListener("pointercancel", onUp);
      }
      resizeHandle.addEventListener("pointerdown", function (e) {
        if (e.button !== 0) return;
        e.preventDefault();
        startX = e.clientX;
        startWidth = getChatPaneWidth();
        document.body.classList.add("page-chat-pane-resizing");
        document.addEventListener("pointermove", onMove);
        document.addEventListener("pointerup", onUp);
        document.addEventListener("pointercancel", onUp);
      });
    }

    const emptyEl = document.getElementById("page-chat-pane-empty");
    const CHAT_HISTORY_KEY = "page-chat-pane-history";
    let chatHistory = [];

    function saveHistory() {
      try {
        const key = CHAT_HISTORY_KEY;
        const data = JSON.stringify(chatHistory);
        sessionStorage.setItem(key, data);
      } catch (e) {
        console.warn("[page-chat] saveHistory failed", e);
      }
    }

    function addMessage(role, text, sources, bodyHtml, skipSave) {
      if (!messagesEl) return;
      if (emptyEl) emptyEl.style.display = "none";
      const div = document.createElement("div");
      div.className = "page-chat-pane-msg " + role;
      const label =
        "<strong>" +
        (role === "user" ? chatLabelYou : chatLabelAssistant) +
        "</strong><br>";
      const body =
        bodyHtml != null
          ? '<div class="page-chat-pane-msg-body">' + bodyHtml + "</div>"
          : text.replace(/\n/g, "<br>");
      let html = label + body;
      if (sources && sources.length) {
        html +=
          '<div class="page-chat-pane-sources">Sources: ' +
          sources
            .map(
              (s) =>
                `<a href="${s.path}" target="_blank" rel="noopener">${s.title}</a>`,
            )
            .join(", ") +
          "</div>";
      }
      div.innerHTML = html;
      messagesEl.appendChild(div);
      messagesEl.scrollTop = messagesEl.scrollHeight;
      if (!skipSave) {
        chatHistory.push({ role, text, sources: sources || [] });
        saveHistory();
      }
    }

    function restoreHistory() {
      try {
        const raw = sessionStorage.getItem(CHAT_HISTORY_KEY);
        if (!raw) return;
        const list = JSON.parse(raw);
        if (!Array.isArray(list) || list.length === 0) return;
        chatHistory = list;
        for (const m of list) {
          const bodyHtml = m.role === "assistant" ? renderChatMarkdown(m.text) : undefined;
          addMessage(m.role, m.text, m.sources || [], bodyHtml, true);
        }
      } catch (e) {
        console.warn("[page-chat] restoreHistory failed", e);
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", restoreHistory);
    } else {
      restoreHistory();
    }
  })();
</script>
