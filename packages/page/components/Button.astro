---
// Button.astro
export interface Props {
  variant?: "default" | "primary" | "success" | "warning" | "error" | "ghost";
  size?: "sm" | "md" | "lg";
  icon?: string;
  href?: string;
  target?: string;
  disabled?: boolean;
}

const {
  variant = "default",
  size = "md",
  icon,
  href,
  target,
  disabled = false,
} = Astro.props;

const Tag = href ? "a" : "button";
const attrs = href ? { href, target } : {};
const buttonAttrs = !href && disabled ? { disabled } : {};
---

<Tag
  class={`page-button page-button-${variant} page-button-${size}`}
  {...attrs}
  {...buttonAttrs}
>
  {icon && <span class="page-button-icon">{icon}</span>}
  <span class="page-button-text">
    <slot />
  </span>
</Tag>

<style>
  .page-button {
    display: inline-flex;
    margin-top: 0 !important;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 20px;
    border-radius: 8px;
    font-weight: 500;
    font-size: 14px;
    line-height: 1;
    text-decoration: none;
    border: 1px solid var(--page-border);
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
    user-select: none;
    background: var(--page-bg-secondary);
    color: var(--page-text);
    border-color: var(--page-border);
  }

  /* slot 안의 p 태그 스타일 제거 */
  .page-button p {
    margin: 0 !important;
    padding: 0 !important;
    color: inherit !important;
    font-weight: inherit !important;
    font-size: inherit !important;
    line-height: inherit !important;
    text-decoration: inherit !important;
    background: inherit !important;
    border: inherit !important;
  }

  /* 전역 스타일로 강제 적용 */
  :global(.page-button p) {
    margin: 0 !important;
    padding: 0 !important;
    color: inherit !important;
    font-weight: inherit !important;
    font-size: inherit !important;
    line-height: inherit !important;
    text-decoration: inherit !important;
    background: inherit !important;
    border: inherit !important;
  }

  /* 더 강력한 선택자로 마크다운 스타일 덮어쓰기 */
  :global(.page-content .sl-markdown-content .page-button p) {
    margin: 0 !important;
    padding: 0 !important;
    color: inherit !important;
    font-weight: inherit !important;
    font-size: inherit !important;
    line-height: inherit !important;
    text-decoration: inherit !important;
    background: inherit !important;
    border: inherit !important;
  }

  /* 버튼 내부의 모든 요소에 대해 상속 강제 */
  .page-button * {
    color: inherit !important;
    font-weight: inherit !important;
    font-size: inherit !important;
    line-height: inherit !important;
    text-decoration: inherit !important;
    background: inherit !important;
    border: inherit !important;
  }

  /* 전역 스타일로 버튼 내부 요소 강제 상속 */
  :global(.page-button *) {
    color: inherit !important;
    font-weight: inherit !important;
    font-size: inherit !important;
    line-height: inherit !important;
    text-decoration: inherit !important;
    background: inherit !important;
    border: inherit !important;
  }

  .page-button:hover:not(:disabled) {
    background: var(--page-bg-elevated);
    border-color: var(--page-border-strong);
    transform: translateY(-1px);
    box-shadow: var(--page-shadow-sm);
  }

  .page-button:active:not(:disabled) {
    transform: translateY(0);
    transition: transform 0.1s ease;
  }

  .page-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none !important;
  }

  /* 링크 버튼 스타일 */
  .page-button[href] {
    text-decoration: none !important;
    color: inherit !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    padding: 12px 20px !important;
    border-radius: 8px !important;
    font-weight: 500 !important;
    font-size: 14px !important;
    line-height: 1 !important;
    border: 1px solid var(--page-border) !important;
    cursor: pointer !important;
    transition: all 0.2s ease !important;
    white-space: nowrap !important;
    user-select: none !important;
    background: var(--page-bg-secondary) !important;
    color: var(--page-text) !important;
    border-color: var(--page-border) !important;
    margin-top: 1rem !important;
  }

  .page-button[href]:hover {
    text-decoration: none !important;
    color: inherit !important;
    background: var(--page-bg-elevated) !important;
    border-color: var(--page-border-strong) !important;
    transform: translateY(-1px) !important;
    box-shadow: var(--page-shadow-sm) !important;
  }

  .page-button[href]:focus {
    outline: 2px solid var(--page-accent) !important;
    outline-offset: 2px !important;
  }

  .page-button[href]:active {
    transform: translateY(0) !important;
    box-shadow: var(--page-shadow-xs) !important;
  }

  .page-button[href]:hover::after {
    width: 0 !important;
  }

  [data-theme="dark"] .page-button[href] {
    background: var(--page-bg-secondary) !important;
    color: var(--page-text) !important;
    border-color: var(--page-border) !important;
  }

  [data-theme="dark"] .page-button[href]:hover {
    background: var(--page-bg-elevated) !important;
    border-color: var(--page-border-strong) !important;
    color: var(--page-text) !important;
  }

  [data-theme="dark"] .page-button[href]:focus {
    outline-color: var(--page-accent) !important;
  }

  /* 링크 버튼 variant별 스타일 */
  .page-button[href].page-button-primary {
    background: var(--blue-600) !important;
    border-color: var(--blue-600) !important;
    color: var(--neutral-white) !important;
  }

  .page-button[href].page-button-primary:hover {
    background: var(--blue-700) !important;
    border-color: var(--blue-700) !important;
    color: var(--neutral-white) !important;
  }

  .page-button[href].page-button-success {
    background: var(--green-600) !important;
    border-color: var(--green-600) !important;
    color: var(--neutral-white) !important;
  }

  .page-button[href].page-button-success:hover {
    background: var(--green-700) !important;
    border-color: var(--green-700) !important;
    color: var(--neutral-white) !important;
  }

  .page-button[href].page-button-warning {
    background: var(--orange-600) !important;
    border-color: var(--orange-600) !important;
    color: var(--neutral-white) !important;
  }

  .page-button[href].page-button-warning:hover {
    background: var(--orange-700) !important;
    border-color: var(--orange-700) !important;
    color: var(--neutral-white) !important;
  }

  .page-button[href].page-button-error {
    background: var(--red-600) !important;
    border-color: var(--red-600) !important;
    color: var(--neutral-white) !important;
  }

  .page-button[href].page-button-error:hover {
    background: var(--red-700) !important;
    border-color: var(--red-700) !important;
    color: var(--neutral-white) !important;
  }

  .page-button[href].page-button-ghost {
    background: transparent !important;
    border-color: var(--page-border) !important;
    color: var(--page-text) !important;
  }

  .page-button[href].page-button-ghost:hover {
    background: var(--page-bg-secondary) !important;
    border-color: var(--page-border-strong) !important;
    color: var(--page-text) !important;
  }

  /* 다크 모드 링크 버튼 variant */
  [data-theme="dark"] .page-button[href].page-button-primary {
    background: var(--blue-500) !important;
    border-color: var(--blue-500) !important;
    color: var(--neutral-white) !important;
  }

  [data-theme="dark"] .page-button[href].page-button-primary:hover {
    background: var(--blue-600) !important;
    border-color: var(--blue-600) !important;
    color: var(--neutral-white) !important;
  }

  [data-theme="dark"] .page-button[href].page-button-success {
    background: var(--green-500) !important;
    border-color: var(--green-500) !important;
    color: var(--neutral-white) !important;
  }

  [data-theme="dark"] .page-button[href].page-button-success:hover {
    background: var(--green-600) !important;
    border-color: var(--green-600) !important;
    color: var(--neutral-white) !important;
  }

  [data-theme="dark"] .page-button[href].page-button-warning {
    background: var(--orange-500) !important;
    border-color: var(--orange-500) !important;
    color: var(--neutral-white) !important;
  }

  [data-theme="dark"] .page-button[href].page-button-warning:hover {
    background: var(--orange-600) !important;
    border-color: var(--orange-600) !important;
    color: var(--neutral-white) !important;
  }

  [data-theme="dark"] .page-button[href].page-button-error {
    background: var(--red-500) !important;
    border-color: var(--red-500) !important;
    color: var(--neutral-white) !important;
  }

  [data-theme="dark"] .page-button[href].page-button-error:hover {
    background: var(--red-600) !important;
    border-color: var(--red-600) !important;
    color: var(--neutral-white) !important;
  }

  [data-theme="dark"] .page-button[href].page-button-ghost {
    background: transparent !important;
    border-color: var(--page-border) !important;
    color: var(--page-text) !important;
  }

  [data-theme="dark"] .page-button[href].page-button-ghost:hover {
    background: var(--page-bg-secondary) !important;
    border-color: var(--page-border-strong) !important;
    color: var(--page-text) !important;
  }

  .page-button-icon {
    font-size: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
    border: none !important;
    outline: none !important;
    background: transparent !important;
  }

  .page-button:hover .page-button-icon {
    transform: scale(1.1);
  }

  .page-button-text {
    color: inherit;
    font-weight: inherit;
  }

  /* 전역 스타일로 아이콘 border 제거 */
  :global(.page-button .page-button-icon) {
    border: none !important;
    outline: none !important;
    background: transparent !important;
    box-shadow: none !important;
  }

  :global(.page-button-text) {
    border: none !important;
    outline: none !important;
    background: transparent !important;
    box-shadow: none !important;
  }

  /* Default Button */
  .page-button-default {
    background: var(--page-bg-secondary);
    border-color: var(--page-border);
    color: var(--page-text);
  }

  .page-button-default:hover:not(:disabled) {
    background: var(--page-bg-elevated);
    border-color: var(--page-border-strong);
    color: var(--page-text);
  }

  :global([data-theme="dark"]) .page-button-default {
    background: var(--page-bg-secondary) !important;
    border-color: var(--page-border) !important;
    color: var(--page-text) !important;
  }

  :global([data-theme="dark"]) .page-button-default:hover:not(:disabled) {
    background: var(--page-bg-elevated) !important;
    border-color: var(--page-border-strong) !important;
    color: var(--page-text) !important;
  }

  /* Primary Button */
  .page-button-primary {
    background: var(--blue-600);
    border-color: var(--blue-600);
    color: var(--neutral-white) !important;
  }

  .page-button-primary:hover:not(:disabled) {
    background: var(--blue-700);
    border-color: var(--blue-700);
    color: var(--neutral-white) !important;
  }

  :global([data-theme="dark"]) .page-button-primary {
    background: var(--blue-500) !important;
    border-color: var(--blue-500) !important;
    color: var(--neutral-white) !important;
  }

  :global([data-theme="dark"]) .page-button-primary:hover:not(:disabled) {
    background: var(--blue-600) !important;
    border-color: var(--blue-600) !important;
    color: var(--neutral-white) !important;
  }

  /* Success Button */
  .page-button-success {
    background: var(--green-600);
    border-color: var(--green-600);
    color: var(--neutral-white) !important;
  }

  .page-button-success:hover:not(:disabled) {
    background: var(--green-700);
    border-color: var(--green-700);
    color: var(--neutral-white) !important;
  }

  :global([data-theme="dark"]) .page-button-success {
    background: var(--green-500) !important;
    border-color: var(--green-500) !important;
    color: var(--neutral-white) !important;
  }

  :global([data-theme="dark"]) .page-button-success:hover:not(:disabled) {
    background: var(--green-600) !important;
    border-color: var(--green-600) !important;
    color: var(--neutral-white) !important;
  }

  /* Warning Button */
  .page-button-warning {
    background: var(--orange-600);
    border-color: var(--orange-600);
    color: var(--neutral-white) !important;
  }

  .page-button-warning:hover:not(:disabled) {
    background: var(--orange-700);
    border-color: var(--orange-700);
    color: var(--neutral-white) !important;
  }

  :global([data-theme="dark"]) .page-button-warning {
    background: var(--orange-500) !important;
    border-color: var(--orange-500) !important;
    color: var(--neutral-white) !important;
  }

  :global([data-theme="dark"]) .page-button-warning:hover:not(:disabled) {
    background: var(--orange-600) !important;
    border-color: var(--orange-600) !important;
    color: var(--neutral-white) !important;
  }

  /* Error Button */
  .page-button-error {
    background: var(--red-600);
    border-color: var(--red-600);
    color: var(--neutral-white) !important;
  }

  .page-button-error:hover:not(:disabled) {
    background: var(--red-700);
    border-color: var(--red-700);
    color: var(--neutral-white) !important;
  }

  :global([data-theme="dark"]) .page-button-error {
    background: var(--red-500) !important;
    border-color: var(--red-500) !important;
    color: var(--neutral-white) !important;
  }

  :global([data-theme="dark"]) .page-button-error:hover:not(:disabled) {
    background: var(--red-600) !important;
    border-color: var(--red-600) !important;
    color: var(--neutral-white) !important;
  }

  /* Ghost Button */
  .page-button-ghost {
    background: transparent;
    border-color: var(--page-border);
    color: var(--page-text);
  }

  .page-button-ghost:hover:not(:disabled) {
    background: var(--page-bg-secondary);
    border-color: var(--page-border-strong);
    color: var(--page-text);
  }

  :global([data-theme="dark"]) .page-button-ghost {
    background: transparent !important;
    border-color: var(--page-border) !important;
    color: var(--page-text) !important;
  }

  :global([data-theme="dark"]) .page-button-ghost:hover:not(:disabled) {
    background: var(--page-bg-secondary) !important;
    border-color: var(--page-border-strong) !important;
    color: var(--page-text) !important;
  }

  /* Sizes */
  .page-button-sm {
    padding: 8px 16px;
    font-size: 12px;
    border-radius: 8px;
  }

  .page-button-sm .page-button-icon {
    font-size: 14px;
  }

  .page-button-md {
    padding: 12px 20px;
    font-size: 14px;
    border-radius: 12px;
  }

  .page-button-md .page-button-icon {
    font-size: 16px;
  }

  .page-button-lg {
    padding: 16px 28px;
    font-size: 16px;
    border-radius: 14px;
  }

  .page-button-lg .page-button-icon {
    font-size: 18px;
  }

  /* 반응형 */
  @media (max-width: 768px) {
    .page-button {
      padding: 10px 18px;
      font-size: 13px;
    }

    .page-button-lg {
      padding: 14px 24px;
      font-size: 15px;
    }
  }

  /* 애니메이션 */
  @keyframes buttonPulse {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.05);
    }
    100% {
      transform: scale(1);
    }
  }

  .page-button:active:not(:disabled) {
    animation: buttonPulse 0.2s ease;
  }

  /* 포커스 스타일 */
  .page-button:focus-visible {
    outline: 2px solid var(--page-accent);
    outline-offset: 2px;
  }

  [data-theme="dark"] .page-button:focus-visible {
    outline-color: var(--page-accent);
  }
</style>
