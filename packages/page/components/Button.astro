---
// Button.astro
export interface Props {
  variant?: "default" | "primary" | "success" | "warning" | "error" | "ghost";
  size?: "sm" | "md" | "lg";
  icon?: string;
  href?: string;
  target?: string;
  disabled?: boolean;
}

const {
  variant = "default",
  size = "md",
  icon,
  href,
  target,
  disabled = false,
} = Astro.props;

const Tag = href ? "a" : "button";
const attrs = href ? { href, target } : {};
const buttonAttrs = !href && disabled ? { disabled } : {};
---

<Tag
  class={`page-button page-button-${variant} page-button-${size}`}
  {...attrs}
  {...buttonAttrs}
>
  {icon && <span class="page-button-icon">{icon}</span>}
  <span class="page-button-text">
    <slot />
  </span>
</Tag>

<style>
  .page-button {
    display: inline-flex;
    margin-top: 0 !important;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 20px;
    border-radius: 8px;
    font-weight: 500;
    font-size: 14px;
    line-height: 1;
    text-decoration: none;
    border: 1px solid var(--page-border);
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
    user-select: none;
    background: var(--neutral100);
    color: var(--neutral600);
    border-color: var(--neutral300);
  }

  /* slot 안의 p 태그 스타일 제거 */
  .page-button p {
    margin: 0 !important;
    padding: 0 !important;
  }

  /* 전역 스타일로 강제 적용 */
  :global(.page-button p) {
    margin: 0 !important;
    padding: 0 !important;
  }

  .page-button:hover:not(:disabled) {
    background: var(--neutralWhite);
    border-color: var(--neutral400);
  }

  .page-button:active:not(:disabled) {
    transform: translateY(0);
    transition: transform 0.1s ease;
  }

  .page-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none !important;
  }

  /* 링크 버튼 스타일 */
  .page-button[href] {
    text-decoration: none;
    color: inherit;
  }

  .page-button[href]:hover {
    text-decoration: none;
    color: inherit !important;
    background: inherit !important;
    padding: inherit !important;
    margin: inherit !important;
  }

  .page-button[href]:focus {
    outline: 2px solid var(--blue500);
    outline-offset: 2px;
  }

  .page-button[href]:hover::after {
    width: 0 !important;
  }

  [data-theme="dark"] .page-button[href]:focus {
    outline-color: var(--blue400);
  }

  .page-button-icon {
    font-size: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }

  .page-button:hover .page-button-icon {
    transform: scale(1.1);
  }

  .page-button-text {
    color: inherit;
    font-weight: inherit;
  }

  /* Variants */
  .page-button-default {
    background: var(--neutral100);
    border-color: var(--neutral300);
    color: var(--neutral600);
  }

  .page-button-default:hover:not(:disabled) {
    background: var(--neutralWhite);
    border-color: var(--neutral400);
  }

  [data-theme="dark"] .page-button-default {
    background: var(--neutral800);
    border-color: var(--neutral600);
    color: var(--neutral200);
  }

  [data-theme="dark"] .page-button-default:hover:not(:disabled) {
    background: var(--neutral700);
    border-color: var(--neutral500);
  }

  .page-button-primary {
    background: var(--blue600);
    border-color: var(--blue600);
    color: var(--neutralWhite);
  }

  .page-button-primary:hover:not(:disabled) {
    background: var(--blue700);
    border-color: var(--blue700);
    color: var(--neutralWhite);
  }

  [data-theme="dark"] .page-button-primary {
    background: var(--blue500);
    border-color: var(--blue500);
    color: var(--neutralWhite);
  }

  [data-theme="dark"] .page-button-primary:hover:not(:disabled) {
    background: var(--blue600);
    border-color: var(--blue600);
    color: var(--neutralWhite);
  }

  .page-button-success {
    background: var(--green600);
    border-color: var(--green600);
    color: var(--neutralWhite);
  }

  .page-button-success:hover:not(:disabled) {
    background: var(--green700);
    border-color: var(--green700);
    color: var(--neutralWhite);
  }

  [data-theme="dark"] .page-button-success {
    background: var(--green500) !important;
    border-color: var(--green500) !important;
    color: var(--neutralWhite) !important;
  }

  [data-theme="dark"] .page-button-success:hover:not(:disabled) {
    background: var(--green600) !important;
    border-color: var(--green600) !important;
    color: var(--neutralWhite) !important;
  }

  .page-button-warning {
    background: var(--orange600);
    border-color: var(--orange600);
    color: var(--neutralWhite);
  }

  .page-button-warning:hover:not(:disabled) {
    background: var(--orange700);
    border-color: var(--orange700);
    color: var(--neutralWhite);
  }

  [data-theme="dark"] .page-button-warning {
    background: var(--orange500) !important;
    border-color: var(--orange500) !important;
    color: var(--neutralWhite) !important;
  }

  [data-theme="dark"] .page-button-warning:hover:not(:disabled) {
    background: var(--orange600) !important;
    border-color: var(--orange600) !important;
    color: var(--neutralWhite) !important;
  }

  .page-button-error {
    background: var(--red600);
    border-color: var(--red600);
    color: var(--neutralWhite);
  }

  .page-button-error:hover:not(:disabled) {
    background: var(--red700);
    border-color: var(--red700);
    color: var(--neutralWhite);
  }

  [data-theme="dark"] .page-button-error {
    background: var(--red500) !important;
    border-color: var(--red500) !important;
    color: var(--neutralWhite) !important;
  }

  [data-theme="dark"] .page-button-error:hover:not(:disabled) {
    background: var(--red600) !important;
    border-color: var(--red600) !important;
    color: var(--neutralWhite) !important;
  }

  .page-button-ghost {
    background: transparent;
    border-color: var(--neutral400);
    color: var(--neutral600);
  }

  .page-button-ghost:hover:not(:disabled) {
    background: var(--neutral100);
    border-color: var(--neutral500);
    color: var(--neutral800);
  }

  [data-theme="dark"] .page-button-ghost {
    color: var(--neutral300) !important;
    border-color: var(--neutral600) !important;
  }

  [data-theme="dark"] .page-button-ghost:hover:not(:disabled) {
    background: var(--neutral800) !important;
    border-color: var(--neutral500) !important;
    color: var(--neutral100) !important;
  }

  /* Sizes */
  .page-button-sm {
    padding: 8px 16px;
    font-size: 12px;
    border-radius: 8px;
  }

  .page-button-sm .page-button-icon {
    font-size: 14px;
  }

  .page-button-md {
    padding: 12px 20px;
    font-size: 14px;
    border-radius: 12px;
  }

  .page-button-md .page-button-icon {
    font-size: 16px;
  }

  .page-button-lg {
    padding: 16px 28px;
    font-size: 16px;
    border-radius: 14px;
  }

  .page-button-lg .page-button-icon {
    font-size: 18px;
  }

  /* 반응형 */
  @media (max-width: 768px) {
    .page-button {
      padding: 10px 18px;
      font-size: 13px;
    }

    .page-button-lg {
      padding: 14px 24px;
      font-size: 15px;
    }
  }

  /* 애니메이션 */
  @keyframes buttonPulse {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.05);
    }
    100% {
      transform: scale(1);
    }
  }

  .page-button:active:not(:disabled) {
    animation: buttonPulse 0.2s ease;
  }

  /* 포커스 스타일 */
  .page-button:focus-visible {
    outline: 2px solid var(--blue500);
    outline-offset: 2px;
  }

  [data-theme="dark"] .page-button:focus-visible {
    outline-color: var(--blue400);
  }

  /* 전역 버튼 스타일 덮어쓰기 - Default 버튼만 */
  .page-button-default {
    background: var(--neutral100) !important;
    color: var(--neutral600) !important;
    border-color: var(--neutral300) !important;
  }

  .page-button-default:hover {
    background: var(--neutralWhite) !important;
    border-color: var(--neutral400) !important;
    color: var(--neutral800) !important;
  }

  [data-theme="dark"] .page-button-default {
    background: var(--neutral800) !important;
    color: var(--neutral200) !important;
    border-color: var(--neutral600) !important;
  }

  [data-theme="dark"] .page-button-default:hover {
    background: var(--neutral700) !important;
    border-color: var(--neutral500) !important;
    color: var(--neutral100) !important;
  }
</style>
